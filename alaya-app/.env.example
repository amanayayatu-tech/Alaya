PORT=5000
HOST=0.0.0.0
REUSE_PORT=false
ALAYA_MODE=development
ALAYA_DB_PATH=./data.db
ALAYA_AUTO_SEED_DEMO=true
ALAYA_SCHEDULER=true
ALAYA_SCHEDULER_INTERVAL_MS=60000
ALAYA_BASE_URL=http://localhost:5000
ALAYA_REVIEW_WINDOWS=15:30-16:00
ALAYA_REVIEW_TIMEZONE=Asia/Shanghai
ALAYA_REVIEW_PAUSED=false
ALAYA_GATE_ESCALATION_MISSED_WINDOWS=2
ALAYA_IMMEDIATE_RISK_LEVELS=destructive,financial,compliance_sensitive
ALAYA_APPLY_GRACE_SECONDS=60
ALAYA_APPLY_STAGGER_SECONDS=120
ALAYA_SPECULATIVE_DRAFTING=true
ALAYA_SPECULATIVE_BUDGET_RATIO=0.5

# API auth is optional in development without ALAYA_API_KEY, but shadow,
# staging and production require Authorization: Bearer $ALAYA_API_KEY.
ALAYA_API_KEY=
ALAYA_REQUIRE_API_AUTH=false
ALAYA_CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
ALAYA_METRICS_ALLOWED_CIDRS=
ALAYA_COST_RATE_LIMIT_WINDOW_MS=60000
ALAYA_COST_RATE_LIMIT_MAX=10

# LLM defaults to mock and does not call external providers.
ALAYA_LLM_PROVIDER=mock
OPENAI_API_KEY_FILE=
OPENAI_BASE_URL=
OPENAI_MODEL=
OPENAI_REQUEST_TIMEOUT_MS=90000
OPENAI_MAX_OUTPUT_TOKENS=512
OPENAI_MAX_RETRIES=3
OPENAI_RETRY_BASE_MS=2000

# GitHub issue sensor reads from GitHub only when configured.
ALAYA_GITHUB_TOKEN_FILE=
GITHUB_TOKEN_FILE=

# Comma-separated additional hosts allowed in long-run modes.
ALAYA_ALLOWED_NETWORK_HOSTS=api.github.com,api.openai.com,api.minimax.io,api.minimaxi.com,api.telegram.org,open.feishu.cn
ALAYA_NOTIFICATION_PROVIDER=telegram

# High-risk capabilities. Use true only after review; shadow may use dry_run.
ALAYA_CAP_FILESYSTEM_WRITE=true
ALAYA_CAP_SHELL_EXECUTION=false
ALAYA_CAP_GITHUB_WRITE=false
ALAYA_CAP_DATABASE_MIGRATION=false
ALAYA_CAP_NETWORK_UNKNOWN=false
ALAYA_CAP_LLM_CALL=false
ALAYA_CAP_KNOWLEDGE_WRITE=true
ALAYA_CAP_SCHEDULER_LOOP=true
ALAYA_CAP_EXTERNAL_NOTIFICATION=false

# Telegram notifications. Fill these only in local .env, never commit secrets.
ALAYA_TELEGRAM_BOT_TOKEN=
ALAYA_TELEGRAM_CHAT_ID=
ALAYA_TELEGRAM_USER_ID=

# Feishu notifications are reserved for a future adapter.
ALAYA_FEISHU_WEBHOOK_URL=
ALAYA_FEISHU_APP_ID=
ALAYA_FEISHU_APP_SECRET=
