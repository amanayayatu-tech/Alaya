+import { mkdirSync, writeFileSync, readFileSync } from "node:fs";
+import { resolve, join } from "node:path";
+import { pathToFileURL } from "node:url";
+import { BEST_FIT, buildDataset, baseline, average, headroom } from "./domain.ts";
+import { TrialModel, CODE_SCHEMA, CONTRACT, append } from "./llm.ts";
+import { score } from "./sandbox.ts";
+
+export async function livePreflight(dir: string) {
+  mkdirSync(dir, { recursive: true });
+  const rows = buildDataset("preflight-only-not-experiment-20260922", { train: 4, dev: 1, test: 1 })["D1-0"].train;
+  const model = new TrialModel(dir, "preflight-code-and-repair", 6);
+  const policy = readFileSync(new URL("./policies/v0.md", import.meta.url), "utf8");
+  let currentCode = BEST_FIT;
+  const outcomes = [];
+  for (let index = 0; index < 2; index++) {
+    const response = await model.call({ role: "builder", task: CONTRACT, promptVersion: "rsi-binpack-preflight-v1",
+      knowledgeSummary: policy,
+      context: { currentCode, trainBaselineMean: average(rows.map(x => baseline(x.items))),
+        instruction: index === 0 ? "Propose one legal compact improvement over Best Fit." : "Use the real training execution below to revise the candidate; return valid code even if no gain can be justified.",
+        previousFeedback: outcomes.length ? { mean: outcomes[0].score?.mean, error: outcomes[0].score?.error } : null },
+      schema: CODE_SCHEMA,
+    });
+    const code = typeof response.data.code === "string" ? response.data.code : "";
+    const result = response.schemaValid && code ? await score(code, rows) : null;
+    const entry = { index, schemaValid: response.schemaValid, code, hypothesis: response.data.hypothesis, providerError: response.errorMessage, score: result };
+    outcomes.push(entry);
+    append(join(dir, "preflight.jsonl"), entry);
+    console.log(JSON.stringify({ preflight: index, schemaValid: entry.schemaValid, valid: result?.valid, mean: result?.mean, error: response.errorMessage ?? result?.error }));
+    if (result?.valid) currentCode = code;
+  }
+  const summary = { status: outcomes.every(x => x.score?.valid) ? "RUNTIME_READY" : "PREFLIGHT_NOT_READY", model: "MiniMax-M3", requests: model.requests, learningEvidence: false };
+  writeFileSync(join(dir, "summary.json"), JSON.stringify(summary, null, 2));
+  return summary;
+}
+if (process.argv[1] && import.meta.url === pathToFileURL(resolve(process.argv[1])).href) {
+  console.log(JSON.stringify(await livePreflight(resolve(process.argv[2] ?? "outputs/rsi-binpack/preflight-20260922"))));
+}
