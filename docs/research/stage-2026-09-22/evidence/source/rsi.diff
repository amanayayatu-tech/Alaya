+++ b/experiments/rsi-binpack/analyze.ts
@@ -0,0 +1,97 @@
+import { readFileSync, writeFileSync, existsSync } from "node:fs";
+import { resolve, join } from "node:path";
+import { pathToFileURL } from "node:url";
+import { average, random, hash } from "./domain.ts";
+import { readLines, costEstimate } from "./llm.ts";
+
+export function compare(rows: any[], control: string, treatment: string, phase: number) {
+  const controls = rows.filter(x => x.arm === control);
+  const pairs = controls.map(a => {
+    const b = rows.find(x => x.arm === treatment && x.world === a.world && x.repeat === a.repeat);
+    if (!b) throw Error("INCOMPLETE_PAIR");
+    const c = a.test.valid ? a.test.mean : 256, t = b.test.valid ? b.test.mean : 256;
+    return { world: a.world, repeat: a.repeat, control: c, treatment: t, gainPercent: (c - t) / c * 100 };
+  });
+  const gains = pairs.map(x => x.gainPercent);
+  const byWorld: Record<string, number> = Object.fromEntries([...new Set(pairs.map(x => x.world))].map(w => [w, average(pairs.filter(x => x.world === w).map(x => x.gainPercent))]));
+  const positivePairs = gains.filter(x => x > 0).length;
+  const gainPercent = average(gains);
+  let interval: number[] | null = null;
+  if (phase > 1) {
+    const rng = random("rsi-bootstrap-20260922");
+    const groups = Object.keys(byWorld).map(w => pairs.filter(x => x.world === w));
+    const values = Array.from({ length: 10000 }, () => average(groups.flatMap(g => g.map(() => g[Math.floor(rng() * g.length)].gainPercent)))).sort((a, b) => a - b);
+    const tail = phase === 3 ? 0.0125 : 0.025;
+    interval = [values[Math.floor(tail * values.length)], values[Math.floor((1 - tail) * values.length)]];
+  }
+  const beatsBestFit = average(rows.filter(x => x.arm === treatment).map(x => (x.test.valid ? x.test.mean : 256) - x.bestFitMean)) < 0;
+  return { control, treatment, pairs, gainPercent, positivePairs, byWorld, interval,
+    practicalSignal: gainPercent >= 0.5 && positivePairs >= (phase === 1 ? 2 : 6) && (phase === 1 ? beatsBestFit : Object.values(byWorld).every(x => x >= -0.5)),
+    beatsBestFit, stableSupport: interval !== null && interval[0] > 0 };
+}
+export function phaseDecision(phase: number, rows: any[]) {
+  if (phase === 1) {
+    const comparison = compare(rows, "independent", "v0", phase);
+    return { phase, continue: comparison.practicalSignal, status: comparison.practicalSignal ? "FEEDBACK_SEARCH_PROMISING" : "NO_PRACTICAL_FEEDBACK_GAIN", comparisons: [comparison] };
+  }
+  if (phase === 2) {
+    const comparison = compare(rows, "v0", "v1", phase);
+    return { phase, continue: comparison.practicalSignal, status: comparison.practicalSignal ? "SELF_MODIFICATION_PROMISING" : "NO_PRACTICAL_SELF_MODIFICATION_GAIN", comparisons: [comparison] };
+  }
+  const parent = compare(rows, "v1", "v2", phase), reset = compare(rows, "v2_reset", "v2", phase);
+  return { phase, continue: false, status: parent.practicalSignal ? (reset.practicalSignal ? "BOUNDED_RECURSIVE_SIGNAL" : "ITERATIVE_OPTIMIZATION_ONLY") : "NO_NEXT_GENERATION_GAIN", comparisons: [parent, reset] };
+}
+export function analyze(dir: string) {
+  const rows = readLines(join(dir, "results.jsonl")).filter(x => x.event === "trial_complete");
+  const protocol = JSON.parse(readFileSync(join(dir, "protocol.json"), "utf8"));
+  const requests = readLines(join(dir, "requests.jsonl"));
+  const sent = requests.filter(x => x.event === "request");
+  if (new Set(sent.map(x => x.id)).size !== sent.length) throw Error("DUPLICATE_HTTP_ID");
+  for (const r of sent) if (hash(JSON.stringify(r.body)) !== r.bodyHash) throw Error("REQUEST_HASH_MISMATCH");
+  const responses = requests.filter(x => x.event === "response");
+  const estimates = responses.map(x => costEstimate(x.usage));
+  const attempts = readLines(join(dir, "results.jsonl")).filter(x => x.event === "candidate");
+  const phases: any[] = [];
+  for (let phase = 1; phase <= 3; phase++) {
+    const subset = rows.filter(x => x.phase === phase);
+    if (subset.length === ({1: 6, 2: 18, 3: 27} as any)[phase]) phases.push(phaseDecision(phase, subset));
+  }
+  const summary = { evidence: protocol.mode === "mock" ? "MOCK_ONLY" : "DEVELOPMENT", phases,
+    completedTrials: rows.length, actualHttpRequests: sent.length,
+    responseCount: responses.length, missingOrErrorResponses: sent.length - responses.length,
+    tokens: { input: responses.reduce((s, x) => s + (x.usage?.prompt_tokens ?? 0), 0), output: responses.reduce((s, x) => s + (x.usage?.completion_tokens ?? 0), 0), missingUsageResponses: estimates.filter(x => x.costUsd === null).length },
+    estimatedPaygUsdKnownUsage: estimates.reduce((s, x) => s + (x.costUsd ?? 0), 0), billingIsNotInvoice: true,
+    priceSource: protocol.price, candidateAttempts: attempts.length, legalCandidates: attempts.filter(x => x.train?.valid && x.dev?.valid).length,
+    uniqueCodeHashes: new Set(attempts.map(x => x.codeHash).filter(Boolean)).size,
+    perTrial: rows.map(row => {
+      const calls = responses.filter(x => x.trial === row.trial);
+      const candidates = attempts.filter(x => x.trial === row.trial);
+      return { phase: row.phase, trial: row.trial, arm: row.arm, world: row.world, repeat: row.repeat,
+        selected: row.selected, testMean: row.test.mean, valid: row.test.valid, bestFitMean: row.bestFitMean,
+        calls: sent.filter(x => x.trial === row.trial).length,
+        tokens: calls.reduce((s,x) => s + (x.usage?.total_tokens ?? 0), 0),
+        legalCandidates: candidates.filter(x => x.train?.valid && x.dev?.valid).length,
+        uniqueCodeHashes: new Set(candidates.map(x => x.codeHash)).size,
+        curve: candidates.map(x => ({ attempt: x.attempt, trainMean: x.train?.mean, trainValid: x.train?.valid, devMean: x.dev?.mean, devValid: x.dev?.valid })) };
+    }) };
+  writeFileSync(join(dir, "summary.json"), JSON.stringify(summary, null, 2));
+  const lines = [`# Alaya 受约束 RSI 实验结果`, ``, `证据层：**${summary.evidence}**。底座：${protocol.model.name}；thinking=${protocol.model.thinking}。`, ``,
+    ...[1,2,3].map(p => `- H${p}：${phases.find(x => x.phase === p)?.status ?? "未验证（未满足前阶段条件或尚未完成）"}`), ``,
+    `完成 ${rows.length} 条搜索；实际 HTTP ${sent.length} 次；已记录输入 ${summary.tokens.input}、输出 ${summary.tokens.output} token。`,
+    `已知 usage 的按量价格等值估算：$${summary.estimatedPaygUsdKnownUsage.toFixed(6)}，不是账户账单。缺 usage 响应 ${summary.tokens.missingUsageResponses}；缺失/错误响应 ${summary.missingOrErrorResponses}，均不当作零费用。`,
+    `价格：[MiniMax 官方标准按量价](${protocol.price.source})，核实日期 ${protocol.price.checkedDate}。`, ``,
+    `候选 ${attempts.length} 个，train/dev 合法 ${summary.legalCandidates} 个，代码哈希 ${summary.uniqueCodeHashes} 种。`, ``,
+    `|阶段|世界/重复|方法|test 平均箱数|Best Fit|请求数|`, `|---|---|---|---:|---:|---:|`,
+    ...summary.perTrial.map(x => `|P${x.phase}|${x.world}/${x.repeat}|${x.arm}|${x.testMean.toFixed(4)}|${x.bestFitMean.toFixed(4)}|${x.calls}|`), ``,
+    ...phases.flatMap(p => [`## P${p.phase}: ${p.status}`, ``, ...p.comparisons.map((c: any) => `${c.treatment} 相对 ${c.control}：平均 gain=${c.gainPercent.toFixed(4)}%；正向 ${c.positivePairs}/${c.pairs.length}。配对值：${c.pairs.map((x: any) => x.gainPercent.toFixed(4)).join(", ")}。${c.interval ? `区间 ${JSON.stringify(c.interval)}。` : "P1 是 3 对筛查，不作稳健统计证明。"}`), ``]),
+    `## 结论边界`, ``, `这是固定模型、固定装箱分布与有限调用次数的 DEVELOPMENT 对照。没有训练底座权重、没有写入 Alaya 产品知识库，也不是通用认知增强或无限 RSI 的证明。`,
+    `若 H1 未达到 0.5% 且至少 2/3 为正的预设条件，则按协议停止 P2/P3；不能用某个训练冠军代替主指标。`,
+    `所有模型请求、候选源代码、train/dev 结果、冠军冻结事件和 test 结果保存在本目录；test 从未反馈给模型。`, ``];
+  writeFileSync(join(dir, "report.zh-CN.md"), lines.join("\n"));
+  return summary;
+}
+if (process.argv[1] && import.meta.url === pathToFileURL(resolve(process.argv[1])).href) {
+  const id = process.argv[process.argv.indexOf("--run-id") + 1];
+  if (!/^[a-zA-Z0-9_-]+$/.test(id ?? "")) throw Error("BAD_RUN_ID");
+  console.log(JSON.stringify(analyze(resolve("outputs/rsi-binpack", id)), null, 2));
+}
