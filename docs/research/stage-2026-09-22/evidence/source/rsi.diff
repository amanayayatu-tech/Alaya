+import { spawn, spawnSync } from "node:child_process";
+import { fileURLToPath } from "node:url";
+import { resolve, dirname } from "node:path";
+import { createInterface } from "node:readline";
+import { randomUUID } from "node:crypto";
+import { applyChoice, average, baseline, type Instance, type Score } from "./domain.ts";
+
+export const IMAGE = "node:20-alpine@sha256:fb4cd12c85ee03686f6af5362a0b0d56d50c58a04632e6c0fb8363f609372293";
+export async function score(code: string, instances: Instance[], timeoutMs = 30000): Promise<Score> {
+  const started = Date.now();
+  const name = `alaya-rsi-${randomUUID()}`;
+  const worker = resolve(dirname(fileURLToPath(import.meta.url)), "worker.mjs");
+  const child = spawn("docker", ["run", "--rm", "-i", "--name", name, "--network=none", "--read-only", "--ipc=none",
+    "--cap-drop=ALL", "--security-opt=no-new-privileges", "--pids-limit=64", "--memory=256m", "--cpus=1", "--user=65534:65534",
+    "--mount", `type=bind,src=${worker},dst=/worker.mjs,readonly`, IMAGE, "node", "/worker.mjs"], { stdio: ["pipe", "pipe", "pipe"] });
+  const lines = createInterface({ input: child.stdout })[Symbol.asyncIterator]();
+  let stderr = "", expired = false;
+  child.stderr.on("data", chunk => { if (stderr.length < 2000) stderr += String(chunk); });
+  child.stdin.on("error", () => {});
+  const timer = setTimeout(() => { expired = true; child.kill("SIGKILL"); spawnSync("docker", ["rm", "-f", name], { timeout: 5000, stdio: "ignore" }); }, timeoutMs);
+  const request = async (value: unknown) => {
+    child.stdin.write(JSON.stringify(value) + "\n");
+    const line = await lines.next();
+    if (line.done) throw Error(expired ? "CANDIDATE_TIMEOUT" : `SANDBOX_EXIT:${stderr}`);
+    if (line.value.length > 65536) throw Error("OUTPUT_TOO_LARGE");
+    const result = JSON.parse(line.value);
+    if (result.error) throw Error(result.error);
+    return result;
+  };
+  const counts: number[] = [], feedback: unknown[] = [];
+  try {
+    // ponytail: four independent realms per batch; increase only if measured IPC cost dominates.
+    for (let offset = 0; offset < instances.length; offset += 4) {
+      const batch = instances.slice(offset, offset + 4);
+      const bins = batch.map(() => [] as number[]);
+      await request({ code, count: batch.length });
+      for (let step = 0; step < batch[0].items.length; step++) {
+        const inputs = batch.map((row, i) => ({ item: row.items[step], bins: bins[i] }));
+        const reply = await request({ inputs });
+        if (!Array.isArray(reply.values) || reply.values.length !== batch.length) throw Error("BAD_DECISION_COUNT");
+        for (let i = 0; i < batch.length; i++) {
+          try { applyChoice(inputs[i].item, bins[i], reply.values[i]); }
+          catch (err) { feedback.push({ item: inputs[i].item, capacities: bins[i].slice(), choice: reply.values[i], error: String(err) }); throw err; }
+        }
+      }
+      for (let i = 0; i < batch.length; i++) {
+        const expectedRemaining = bins[i].length * 100 - batch[i].items.reduce((a, b) => a + b, 0);
+        if (bins[i].reduce((a, b) => a + b, 0) !== expectedRemaining) throw Error("HOST_CONSERVATION_FAILURE");
+        counts.push(bins[i].length);
+        feedback.push({ world: batch[i].world, items: batch[i].items, bins: bins[i].length, bestFitBins: baseline(batch[i].items) });
+      }
+    }
+    feedback.sort((a: any, b: any) => (b.bins - b.bestFitBins) - (a.bins - a.bestFitBins));
+    return { valid: true, mean: average(counts), bins: counts, error: null, elapsedMs: Date.now() - started, feedback: feedback.slice(0, 2) };
+  } catch (error) {
+    return { valid: false, mean: 256, bins: [], error: String(error).slice(0, 1600), elapsedMs: Date.now() - started, feedback: feedback.slice(0, 2) };
+  } finally {
+    clearTimeout(timer); child.stdin.end();
+    if (child.exitCode === null) {
+      child.kill();
+      spawnSync("docker", ["rm", "-f", name], { timeout: 5000, stdio: "ignore" });
+    }
+  }
+}
