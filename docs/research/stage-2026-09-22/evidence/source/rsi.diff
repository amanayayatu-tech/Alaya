@@ -0,0 +1,91 @@
+import { appendFileSync, readFileSync, existsSync } from "node:fs";
+import { join } from "node:path";
+import { OpenAIProvider, MockLLM, type AgentContext, type LLMProvider } from "../../alaya-core/src/llm/provider.ts";
+import { hash } from "./domain.ts";
+
+export const SETTINGS = JSON.parse(readFileSync(new URL("./protocol.json", import.meta.url), "utf8"));
+export function append(file: string, value: unknown) { appendFileSync(file, JSON.stringify(value) + "\n"); }
+export function readLines(file: string): any[] {
+  if (!existsSync(file)) return [];
+  return readFileSync(file, "utf8").split("\n").filter(Boolean).map(line => JSON.parse(line));
+}
+export function costEstimate(usage: any) {
+  const p = SETTINGS.price;
+  if (!Number.isFinite(usage?.prompt_tokens) || !Number.isFinite(usage?.completion_tokens)) {
+    return { costUsd: null, conservativeAllocationUsd: (8000 * p.inputPerMillionUsd + 3000 * p.outputPerMillionUsd) / 1e6, costStatus: "usage_unknown_not_zero" };
+  }
+  const cached = Math.min(usage.prompt_tokens, usage.prompt_tokens_details?.cached_tokens ?? 0);
+  return { costUsd: ((usage.prompt_tokens - cached) * p.inputPerMillionUsd + cached * p.cachedInputPerMillionUsd + usage.completion_tokens * p.outputPerMillionUsd) / 1e6, costStatus: "official_payg_equivalent_not_invoice" };
+}
+export class TrialModel {
+  provider: LLMProvider;
+  requests = 0;
+  infrastructureFailures = 0;
+  lastReceipt: any;
+  constructor(readonly dir: string, readonly trial: string, readonly limit: number, keyFile?: string, readonly mock = false) {
+    this.requests = readLines(join(dir, "requests.jsonl")).filter(x => x.trial === trial && x.event === "request").length;
+    if (mock) { this.provider = new MockLLM(); return; }
+    const file = keyFile ?? process.env.OPENAI_API_KEY_FILE ?? "/Users/LOCAL_USER/.config/alaya/openai-api-key";
+    const apiKey = process.env.OPENAI_API_KEY ?? (existsSync(file) ? readFileSync(file, "utf8").trim() : "");
+    if (!apiKey) throw Error("MISSING_EXISTING_API_KEY");
+    this.provider = new OpenAIProvider({ apiKey, model: SETTINGS.model.name, baseUrl: SETTINGS.model.baseUrl,
+      apiMode: "chat", maxRetries: 0, fallbackToSimplified: false, temperature: SETTINGS.model.temperature,
+      maxOutputTokens: SETTINGS.model.maxOutputTokens, timeoutMs: 90000,
+      fetch: (async (url: any, init: any) => {
+        if (this.requests >= this.limit) throw Error("EXPERIMENTAL_ALLOCATION_EXHAUSTED");
+        if (Buffer.byteLength(init.body, "utf8") > SETTINGS.model.maxInputBytes) throw Error("INPUT_EXCEEDS_CONSERVATIVE_BYTE_ALLOCATION");
+        const id = `${trial}:${this.requests++}`;
+        const started = Date.now();
+        append(join(dir, "requests.jsonl"), { event: "request", id, trial, ts: new Date().toISOString(), endpoint: String(url), body: JSON.parse(init.body), bodyHash: hash(init.body) });
+        try {
+          const response = await fetch(url, init);
+          const raw = await response.clone().text();
+          let data: any;
+          try { data = JSON.parse(raw); } catch { data = { raw: raw.slice(0, 50000) }; }
+          this.lastReceipt = { event: "response", id, trial, status: response.status, elapsedMs: Date.now() - started,
+            response: data, usage: data.usage ?? null, ...costEstimate(data.usage), ts: new Date().toISOString() };
+          append(join(dir, "requests.jsonl"), this.lastReceipt);
+          this.infrastructureFailures = response.ok ? 0 : this.infrastructureFailures + 1;
+          return response;
+        } catch (error) {
+          this.infrastructureFailures++;
+          this.lastReceipt = { event: "transport_error", id, trial, elapsedMs: Date.now() - started, error: String(error), usage: null, costUsd: null };
+          append(join(dir, "requests.jsonl"), this.lastReceipt);
+          throw error;
+        }
+      }) as typeof fetch,
+    });
+  }
+  async call(request: AgentContext) {
+    if (this.mock) { this.requests++; return this.provider.call(request); }
+    this.lastReceipt = null;
+    const before = this.requests;
+    // Mock fixtures must never become provider draft_output in real experiments.
+    const { mockData: _offlineFixture, ...liveRequest } = request;
+    const result = await this.provider.call(liveRequest);
+    if (this.infrastructureFailures >= 3) throw Error("REPEATED_INFRASTRUCTURE_FAILURE:" + (this.lastReceipt?.status ?? "transport"));
+    if (this.lastReceipt?.status === 401 || this.lastReceipt?.status === 403) throw Error("PROVIDER_AUTH_REJECTED:" + this.lastReceipt.status);
+    if (before === this.requests) throw Error(result.errorMessage ?? "NO_HTTP_REQUEST_MADE");
+    if ((this.lastReceipt?.usage?.prompt_tokens ?? 0) > 8000 || (this.lastReceipt?.usage?.completion_tokens ?? 0) > 3000) throw Error("PROVIDER_EXCEEDED_FROZEN_TOKEN_ALLOCATION");
+    if (this.lastReceipt?.response?.model && this.lastReceipt.response.model !== SETTINGS.model.name) throw Error("PROVIDER_MODEL_CHANGED");
+    return result;
+  }
+}
+
+export const CODE_SCHEMA = { type: "object" as const, required: ["code", "hypothesis"], additionalProperties: false,
+  properties: { code: { type: "string" }, hypothesis: { type: "string" } } };
+export const POLICY_SCHEMA = { type: "object" as const, required: ["policy", "change_reason"], additionalProperties: false,
+  properties: { policy: { type: "string" }, change_reason: { type: "string" } } };
+export const CONTRACT = "Return JSON with code and hypothesis. code must be a single JavaScript function expression function chooseBin(item, remainingCapacities). Capacity is 100. Return integer index of an existing bin with enough space, or -1 to open a new bin. No future items, I/O, imports, process access, time, randomness, or external libraries. Each sequence resets state. Standard Math/Array arithmetic is available. Aim for code under 1800 characters and a hypothesis under 200 characters. The host independently validates every placement.";
+
+export function fitContext(context: Record<string, any>, policy: string, extraReserve = 0) {
+  const value = structuredClone(context);
+  // Keep the immutable contract, policy and current program. Remove oldest optional history first.
+  while (Buffer.byteLength(JSON.stringify(value)) + Buffer.byteLength(policy) + extraReserve > 5100) {
+    if (value.examples?.length) value.examples.pop();
+    else if (value.history?.length) value.history.shift();
+    else if (value.traces?.length) value.traces.pop();
+    else throw Error("IMMUTABLE_CONTEXT_TOO_LARGE");
+  }
+  return value;
+}
