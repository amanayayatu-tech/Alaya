+import { join } from "node:path";
+import { BEST_FIT, FIRST_FIT, buildDataset, hash, applyChoice, baseline, type Instance } from "./domain.ts";
+import { score } from "./sandbox.ts";
+import { select, contextFor, validPolicy } from "./runner.ts";
+import { compare, phaseDecision } from "./analyze.ts";
+import { TrialModel, CODE_SCHEMA, costEstimate, readLines } from "./llm.ts";
+
+test("deterministic disjoint data, legal host placements and manual counts", () => {
+  const a = buildDataset("unit",{train:2,dev:2,test:2});
+  assert.equal(hash(a),hash(buildDataset("unit",{train:2,dev:2,test:2})));
+  const rows = Object.values(a).flatMap(x => [...x.train,...x.dev,...x.test]);
+  assert.equal(new Set(rows.map(x=>hash(x.items))).size,rows.length);
+  assert.equal(baseline([60,40,60,40]),2);
+  for(const value of [NaN,Infinity,-2,1,0.1,"0",null]) assert.throws(()=>applyChoice(50,[40],value));
+  assert.throws(()=>applyChoice(50,[40],0),/CAPACITY/);
+});
+test("container scoring matches manual counts; hostile candidates cannot become champions", async () => {
+  const rows: Instance[] = [{id:"manual",world:"D1",items:[60,40,60,40]}];
+  for(const code of [BEST_FIT,FIRST_FIT]) { const s=await score(code,rows); assert.equal(s.valid,true,s.error??""); assert.equal(s.mean,2); }
+  for(const code of ["function(){return 999}","function(){return NaN}","function(){return 0}","function(){throw Error('no')}","function(){return process.env.SECRET}","function(){return require('fs').readFileSync('/etc/passwd')} "])
+    assert.equal((await score(code,rows)).valid,false);
+  assert.equal((await score("function(){while(true){}}",rows,1200)).valid,false);
+  // A fresh realm for every sequence: state does not carry from one input sequence to another.
+  const fresh=await score("function(item,bins){globalThis.n=(globalThis.n||0)+1; if(n>4)throw Error('state leaked');return -1}",[...rows,...rows]);
+  assert.equal(fresh.valid,true,fresh.error??"");
+});
+test("selection uses dev only; generated prompt contains training but no dev/test feedback", () => {
+  const s=(mean:number)=>({valid:true,mean,bins:[mean],error:null,elapsedMs:0,feedback:[]});
+  const candidates:any[]=[{id:"base",attempt:-1,code:BEST_FIT,codeHash:hash(BEST_FIT),train:s(10),dev:s(10),hypothesis:"base"},
+    {id:"train-winner",attempt:0,code:"function(){return -1}",codeHash:"x",train:s(9),dev:s(11),hypothesis:"try"},
+    {id:"dev-winner",attempt:1,code:"function(a,b){return -1}",codeHash:"y",train:s(11),dev:s(8),hypothesis:"try two"}];
+  assert.equal(select(candidates,"dev").id,"dev-winner");
+  assert.equal(select(candidates,"train").id,"train-winner");
+  const train=buildDataset("prompt",{train:1,dev:1,test:1})["D1-0"].train;
+  const feedback=contextFor("v0",train,candidates,"policy");
+  assert.equal(feedback.currentCode,candidates[1].code);
+  assert.ok(!JSON.stringify(feedback).includes("\"dev\""));
+  assert.ok(!JSON.stringify(feedback).includes("\"test\""));
+  assert.equal(contextFor("independent",train,candidates,"policy").history,undefined);
+});
+test("predeclared gates and invalid champions are not dropped", () => {
+  const rows=(arms:string[],repeats:number,worlds:string[])=>worlds.flatMap(world=>Array.from({length:repeats},(_,repeat)=>arms.map(arm=>({world,repeat,arm,bestFitMean:101,test:{mean:arm==="independent"||arm==="v0"||arm==="v2_reset"?100:99,valid:true}})))).flat();
+  const p1=rows(["independent","v0"],3,["D"]); p1.filter(x=>x.arm==="v0").forEach(x=>x.test.mean=99);
+  assert.equal(phaseDecision(1,p1).continue,true);
+  p1.filter(x=>x.arm==="v0").forEach(x=>x.test.mean=100);
+  assert.equal(phaseDecision(1,p1).continue,false);
+  const p2=rows(["v0","v1"],3,["T1","T2","T3"]);
+  assert.equal(phaseDecision(2,p2).continue,true);
+  p2[1].test.valid=false;
+  assert.equal(compare(p2,"v0","v1",2).pairs[0].treatment,256);
+  assert.equal(phaseDecision(2,p2).continue,false);
+  assert.equal(validPolicy("function chooseBin(x,y){return -1}"),false);
+  assert.equal(validPolicy("Use actual training traces to identify one change in the research process."),true);
+});
+test("HTTP receipts count real attempts, cap them, reject bad root JSON, and preserve unknown cost", async t => {
+  const original=globalThis.fetch, originalKey=process.env.OPENAI_API_KEY;
+  process.env.OPENAI_API_KEY="unit-test-key-not-a-secret";
+  t.after(()=>{globalThis.fetch=original;if(originalKey===undefined)delete process.env.OPENAI_API_KEY;else process.env.OPENAI_API_KEY=originalKey;});
+  let count=0;
+  globalThis.fetch=(async()=>{count++;return new Response(JSON.stringify({model:"MiniMax-M3",choices:[{finish_reason:"stop",message:{content:JSON.stringify({code:BEST_FIT,hypothesis:"unit"})}}]}),{status:200});}) as typeof fetch;
+  const dir=mkdtempSync(join(tmpdir(),"alaya-rsi-receipts-"));
+  const model=new TrialModel(dir,"unit",1);
+  const req={role:"builder",task:"unit",promptVersion:"unit",context:{},schema:CODE_SCHEMA,mockData:{code:BEST_FIT,hypothesis:"offline-only"}};
+  assert.equal((await model.call(req)).schemaValid,true);
+  await assert.rejects(model.call(req),/EXHAUSTED/);
+  assert.equal(count,1);
+  assert.equal(readLines(join(dir,"requests.jsonl")).filter(x=>x.event==="request").length,1);
+  assert.deepEqual(JSON.parse(readLines(join(dir,"requests.jsonl"))[0].body.messages[1].content).draft_output,{});
+  assert.equal(readLines(join(dir,"requests.jsonl"))[1].costUsd,null);
+  assert.ok(!readFileSync(join(dir,"requests.jsonl"),"utf8").includes("unit-test-key"));
+  globalThis.fetch=(async()=>new Response(JSON.stringify({choices:[{message:{content:'{"outer":[{"code":"x","hypothesis":"unit"}'} }]}),{status:200})) as typeof fetch;
+  const bad=new TrialModel(dir,"truncated",1);
+  assert.equal((await bad.call(req)).schemaValid,false);
+  assert.equal(costEstimate(null).costUsd,null);
+  assert.equal(costEstimate({prompt_tokens:1000000,completion_tokens:1000000,prompt_tokens_details:{cached_tokens:0}}).costUsd,1.5);
+});
diff --git a/experiments/rsi-binpack/runner.ts b/experiments/rsi-binpack/runner.ts
