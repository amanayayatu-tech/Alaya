--- /dev/null
+++ b/experiments/rsi-binpack/runner.ts
@@ -0,0 +1,238 @@
+import { readFileSync, writeFileSync, mkdirSync, existsSync, renameSync, readdirSync, unlinkSync } from "node:fs";
+import { join, resolve, dirname } from "node:path";
+import { fileURLToPath, pathToFileURL } from "node:url";
+import { execFileSync } from "node:child_process";
+import { BEST_FIT, buildDataset, hash, baseline, average, headroom, type Dataset, type Instance, type Split, type Score } from "./domain.ts";
+import { TrialModel, CODE_SCHEMA, POLICY_SCHEMA, CONTRACT, fitContext, SETTINGS, readLines, append } from "./llm.ts";
+import { score, IMAGE } from "./sandbox.ts";
+import { analyze, phaseDecision } from "./analyze.ts";
+import { livePreflight } from "./preflight.ts";
+
+const SOURCE = dirname(fileURLToPath(import.meta.url));
+export function save(file: string, value: unknown) {
+  mkdirSync(dirname(file), { recursive: true });
+  writeFileSync(file + ".tmp", JSON.stringify(value, null, 2)); renameSync(file + ".tmp", file);
+}
+export const read = (file: string): any => JSON.parse(readFileSync(file, "utf8"));
+const event = (dir: string, value: any) => append(join(dir, "events.jsonl"), { actor: "rsi-runner", ts: new Date().toISOString(), ...value });
+function sourceHashes() {
+  const files = readdirSync(SOURCE).filter(x => /\.(ts|mjs|json)$/.test(x)).map(x => join(SOURCE, x));
+  files.push(join(SOURCE, "policies/v0.md"), resolve(SOURCE, "../../alaya-core/src/llm/provider.ts"));
+  return Object.fromEntries(files.map(file => [file, hash(readFileSync(file, "utf8"))]));
+}
+export function prepare(dir: string, mock = false) {
+  if (existsSync(join(dir, "manifest.json"))) { verify(dir); return; }
+  if (existsSync(dir) && readdirSync(dir).length) throw Error("REFUSE_OVERWRITE_EXISTING_RUN");
+  mkdirSync(dir, { recursive: true });
+  for (const sub of ["policies", "candidates", "private-dataset"]) mkdirSync(join(dir, sub));
+  const protocol = { ...SETTINGS, mode: mock ? "mock" : "live", seed: "alaya-rsi-20260922-frozen-v1", containerImage: IMAGE,
+    counts: mock ? { train: 2, dev: 2, test: 4, repeats: 3 } : SETTINGS.counts,
+    phaseCallsPerSearch: mock ? { 1: 1, 2: 1, 3: 1 } : SETTINGS.phaseCallsPerSearch };
+  save(join(dir, "protocol.json"), protocol);
+  const data = buildDataset(protocol.seed, protocol.counts);
+  const hashes: Record<string,string> = {};
+  for (const [key, splits] of Object.entries(data)) for (const [split, rows] of Object.entries(splits)) {
+    const file = `${key}-${split}.json`; save(join(dir, "private-dataset", file), rows); hashes[file] = hash(rows);
+  }
+  save(join(dir, "policies/v0.json"), { id: "v0", policy: readFileSync(join(SOURCE, "policies/v0.md"), "utf8"), parent: null });
+  const planPath = "/Users/LOCAL_USER/Documents/alaya/RSI_EXECUTION_PLAN_2026-09-22.md";
+  save(join(dir, "manifest.json"), { baseSha: execFileSync("git", ["rev-parse", "HEAD"], { encoding: "utf8" }).trim(),
+    cwd: process.cwd(), createdAt: new Date().toISOString(), runtime: process.version,
+    protocolHash: hash(protocol), planHash: hash(readFileSync(planPath, "utf8")), sourceHashes: sourceHashes(), dataHashes: hashes,
+    headroom: headroom(data), evidence: mock ? "MOCK_ONLY" : "DEVELOPMENT" });
+  event(dir, { event: "prepared", protocolHash: hash(protocol) });
+}
+export function verify(dir: string) {
+  const m = read(join(dir, "manifest.json"));
+  if (hash(read(join(dir, "protocol.json"))) !== m.protocolHash) throw Error("PROTOCOL_CHANGED");
+  for (const [file, digest] of Object.entries(m.sourceHashes)) if (hash(readFileSync(file, "utf8")) !== digest) throw Error(`SOURCE_CHANGED:${file}`);
+  for (const [file, digest] of Object.entries(m.dataHashes)) if (hash(read(join(dir, "private-dataset", file))) !== digest) throw Error(`DATA_CHANGED:${file}`);
+}
+function dataFor(dir: string, worlds: string[], repeat: number, split: Split): Instance[] {
+  return worlds.flatMap(w => read(join(dir, "private-dataset", `${w}-${repeat}-${split}.json`)));
+}
+export type Candidate = { id: string; attempt: number; code: string; codeHash: string; hypothesis: string; train: Score; dev: Score };
+export function select(candidates: Candidate[], split: "train" | "dev") {
+  return candidates.filter(x => x[split].valid).sort((a,b) => a[split].mean - b[split].mean || a.code.length - b.code.length || a.attempt - b.attempt)[0];
+}
+const invalid = (error: string): Score => ({ valid: false, mean: 256, bins: [], error, elapsedMs: 0, feedback: [] });
+const baselineScore = (rows: Instance[]): Score => { const bins = rows.map(x => baseline(x.items)); return { valid: true, mean: average(bins), bins, error: null, elapsedMs: 0, feedback: [] }; };
+export function contextFor(arm: string, rows: Instance[], candidates: Candidate[], policy: string) {
+  const items = rows.flatMap(x => x.items);
+  const context: any = { worlds: [...new Set(rows.map(x => x.world))], train: { instances: rows.length, sequenceLength: rows[0].items.length,
+    itemMean: average(items), histogramTenBuckets: Array.from({ length: 10 }, (_,i) => items.filter(x => Math.floor(x/10) === i).length), bestFitMean: candidates[0].train.mean },
+    currentCode: BEST_FIT, instruction: "Optimize the equal-weight mean bin count. Return one complete candidate. Opening a new bin is always allowed, but is counted. You cannot see future items." };
+  if (arm !== "independent") {
+    const champion = select(candidates, "train");
+    context.currentCode = champion.code;
+    context.currentTrainMean = champion.train.mean;
+    context.history = candidates.slice(1).slice(-4).map(x => ({ attempt: x.attempt, hypothesis: x.hypothesis, valid: x.train.valid, trainMean: x.train.mean, error: x.train.error, code: x.code }));
+    context.examples = candidates.slice(-1)[0].train.feedback;
+  }
+  return fitContext(context, policy);
+}
+async function candidate(dir: string, trial: string, attempt: number, arm: string, policy: string, model: TrialModel, rows: {train: Instance[]; dev: Instance[]}, candidates: Candidate[]) {
+  const prefix = join(dir, "candidates", `${trial}-${attempt}`);
+  if (existsSync(prefix + ".json")) return read(prefix + ".json") as Candidate;
+  let response: any;
+  if (existsSync(prefix + ".response.json")) response = read(prefix + ".response.json");
+  else {
+    const requests = readLines(join(dir, "requests.jsonl")).filter(x => x.event === "request" && x.trial === trial);
+    if (requests.length > attempt) throw Error(`UNRESOLVED_REQUEST_DO_NOT_RESEND:${trial}:${attempt}`);
+    response = await model.call({ role: "builder", task: CONTRACT, promptVersion: "rsi-binpack-v1.3", knowledgeSummary: policy,
+      context: contextFor(arm, rows.train, candidates, policy), schema: CODE_SCHEMA, mockData: { code: BEST_FIT, hypothesis: "mock baseline" } });
+    save(prefix + ".response.json", response);
+  }
+  const code = typeof response.data.code === "string" ? response.data.code : "";
+  const valid = response.schemaValid && !response.degradedToHumanGate && code.length > 0;
+  if (code) writeFileSync(prefix + ".js", code);
+  const previous = candidates.find(x => x.codeHash === hash(code));
+  const train = valid ? (previous?.train ?? await score(code, rows.train)) : invalid(response.errorMessage ?? "INVALID_PROVIDER_RESPONSE");
+  const dev = valid && train.valid ? (previous?.dev ?? await score(code, rows.dev)) : invalid("TRAIN_INVALID");
+  const item: Candidate = { id: `${trial}-${attempt}`, attempt, code, codeHash: hash(code), hypothesis: String(response.data.hypothesis ?? ""), train, dev };
+  save(prefix + ".json", item);
+  return item;
+}
+
+async function pairSearch(dir: string, phase: number, worlds: string[], repeat: number, arms: string[], protocol: any) {
+  const world = worlds.length > 1 ? "D-combined" : worlds[0];
+  const train = dataFor(dir, worlds, repeat, "train"), dev = dataFor(dir, worlds, repeat, "dev");
+  const baselineCandidate: Candidate = { id: "best-fit", attempt: -1, code: BEST_FIT, codeHash: hash(BEST_FIT), hypothesis: "fixed legal initial algorithm", train: baselineScore(train), dev: baselineScore(dev) };
+  const states = arms.map(arm => {
+    const trial = `p${phase}-${world}-r${repeat}-${arm}`;
+    const policy = read(join(dir, "policies", `${arm === "independent" ? "v0" : arm}.json`)).policy;
+    return { arm, trial, policy, model: new TrialModel(dir, trial, protocol.phaseCallsPerSearch[phase], undefined, protocol.mode === "mock"), candidates: [baselineCandidate] };
+  });
+  for (let attempt = 0; attempt < protocol.phaseCallsPerSearch[phase]; attempt++) {
+    const order = (attempt + repeat) % 2 ? [...states].reverse() : states;
+    for (const state of order) {
+      const item = await candidate(dir, state.trial, attempt, state.arm, state.policy, state.model, {train,dev}, state.candidates);
+      state.candidates.push(item);
+      if (!readLines(join(dir, "results.jsonl")).some(x => x.event === "candidate" && x.id === item.id)) append(join(dir, "results.jsonl"), { event: "candidate", phase, trial: state.trial, arm: state.arm, world, repeat, ...item });
+      console.log(JSON.stringify({ phase, trial: state.trial, attempt: attempt + 1, train: item.train.mean, valid: item.train.valid && item.dev.valid, championTrain: select(state.candidates,"train").train.mean }));
+    }
+  }
+  // Freeze both/all champions before opening any test file for this pair.
+  const champions = states.map(s => ({ ...s, champion: select(s.candidates, "dev") }));
+  for (const s of champions) {
+    const file = join(dir, "candidates", `${s.trial}-frozen.json`);
+    const frozen = { selected: s.champion.id, codeHash: s.champion.codeHash, policyHash: hash(s.policy) };
+    if (existsSync(file)) { if (hash(read(file)) !== hash(frozen)) throw Error("CHAMPION_FREEZE_MISMATCH"); }
+    else { save(file, frozen); event(dir, { event: "champion_frozen", trial: s.trial, ...frozen }); }
+  }
+  const test = dataFor(dir, worlds, repeat, "test");
+  for (const s of champions) {
+    if (readLines(join(dir, "results.jsonl")).some(x => x.event === "trial_complete" && x.trial === s.trial)) continue;
+    const scored = await score(s.champion.code, test);
+    append(join(dir, "results.jsonl"), { event: "trial_complete", phase, trial: s.trial, world, repeat, arm: s.arm,
+      selected: s.champion.id, codeHash: s.champion.codeHash, test: { ...scored, feedback: [] }, bestFitMean: baselineScore(test).mean });
+  }
+}
+
+export function validPolicy(policy: unknown): policy is string {
+  return typeof policy === "string" && policy.trim().length > 20 && policy.length <= 6000 && Buffer.byteLength(policy) <= 3000 &&
+    !/function\s+chooseBin|=>|```|\bimport\s|\bprocess\.[a-z_]|private-dataset|test seed|override.*(budget|evaluator)/i.test(policy);
+}
+function trainingTraces(dir: string, phase: number, arm: string) {
+  const all = readLines(join(dir, "results.jsonl")).filter(x => x.event === "candidate" && x.phase === phase && x.arm === arm);
+  const trials = [...new Set(all.map(x => x.trial))].sort();
+  const groups = trials.map(trial => {
+    const records = all.filter(x => x.trial === trial).sort((a,b) => a.attempt - b.attempt);
+    const legal = records.filter(x => x.train.valid);
+    const chosen = [records[0], [...legal].sort((a,b) => a.train.mean-b.train.mean || a.attempt-b.attempt)[0], records.at(-1), [...legal].sort((a,b) => b.train.mean-a.train.mean || a.attempt-b.attempt)[0]].filter(Boolean);
+    return [...new Map(chosen.map(x => [x.id,x])).values()].sort((a,b) => a.attempt-b.attempt).map(x => ({ trial, attempt: x.attempt, code: x.code, hypothesis: x.hypothesis, train: { mean: x.train.mean, valid: x.train.valid, error: x.train.error } }));
+  });
+  // Round-robin across trials before deterministic trailing truncation.
+  return Array.from({length: 4}, (_,i) => groups.map(g => g[i]).filter(Boolean)).flat();
+}
+async function editPolicy(dir: string, id: string, editorId: string, sourceId: string, traces: any[], protocol: any, sharedContext?: any) {
+  const file = join(dir,"policies",`${id}.json`);
+  if (existsSync(file)) return read(file);
+  const editor = read(join(dir,"policies",`${editorId}.json`)).policy;
+  const source = read(join(dir,"policies",`${sourceId}.json`)).policy;
+  const model = new TrialModel(dir, `edit-${id}`, 4, undefined, protocol.mode === "mock");
+  const context = sharedContext ?? fitContext({ sourcePolicy: source, traces }, editor, 700);
+  if (!context.traces.length) throw Error("NO_TRAIN_TRACE_FITS_POLICY_EDIT");
+  for (let attempt = 0; attempt < 4; attempt++) {
+    const responseFile = join(dir,"policies",`${id}-attempt-${attempt}.json`);
+    let result;
+    if (existsSync(responseFile)) result = read(responseFile);
+    else {
+      if (model.requests > attempt) throw Error("UNRESOLVED_POLICY_REQUEST_DO_NOT_RESEND");
+      result = await model.call({ role: "distiller", task: "Return JSON policy and change_reason. Revise the source research policy using only supplied real training traces, following your current editor policy. Change how hypotheses, feedback interpretation, or next edits are chosen. Return a compact natural-language method under 2000 characters and 3000 UTF-8 bytes. No full algorithm, executable code, data, seeds, evaluator/tool/resource changes. This is one bounded method edit, not a claim of success.", promptVersion: "rsi-policy-edit-v1.3", knowledgeSummary: editor,
+        context, schema: POLICY_SCHEMA, mockData: { policy: editor + "\nUse verified training feedback to choose a single small modification.", change_reason: "mock format and lineage check" } });
+      save(responseFile,result);
+    }
+    if (result.schemaValid && !result.degradedToHumanGate && validPolicy(result.data.policy)) {
+      const value = { id, policy: result.data.policy, changeReason: result.data.change_reason, parent: sourceId, editor: editorId,
+        sourceHash: hash(source), editorHash: hash(editor), policyHash: hash(result.data.policy), materialHash: hash(context), material: context,
+        change: { before: source, after: result.data.policy }, acceptedAttempt: attempt, noTestInput: true };
+      save(file,value); event(dir,{event:"policy_frozen", id, editor:editorId, policyHash:value.policyHash, materialHash:value.materialHash}); return value;
+    }
+  }
+  event(dir,{event:"policy_update_failed",id}); throw Error("NO_VALID_POLICY_UPDATE");
+}
+export async function runPhase(dir: string, phase: number, mockExerciseAll = false) {
+  verify(dir);
+  const protocol = read(join(dir,"protocol.json"));
+  if (![1,2,3].includes(phase)) throw Error("BAD_PHASE");
+  const done = join(dir,`phase${phase}.json`);
+  if (existsSync(done)) return read(done);
+  if (phase === 1 && protocol.mode !== "mock") {
+    if (!existsSync(join(dir,"preflight/summary.json")) || read(join(dir,"preflight/summary.json")).status !== "RUNTIME_READY") throw Error("LIVE_PREFLIGHT_REQUIRED");
+    const gaps = read(join(dir,"manifest.json")).headroom;
+    if (["D1","D2","D3"].every(w => gaps[w].meanGap === 0)) throw Error("NO_MEASURABLE_HEADROOM");
+  }
+  if (phase > 1) {
+    const previousFile = join(dir,`phase${phase-1}.json`);
+    if (!existsSync(previousFile)) throw Error("PREVIOUS_PHASE_INCOMPLETE");
+    if (!read(previousFile).continue && !(protocol.mode === "mock" && mockExerciseAll)) throw Error("PREVIOUS_PHASE_STOPPED");
+  }
+  if (phase === 2) await editPolicy(dir,"v1","v0","v0",trainingTraces(dir,1,"v0"),protocol);
+  if (phase === 3) {
+    const v0 = read(join(dir,"policies/v0.json")).policy, v1 = read(join(dir,"policies/v1.json")).policy;
+    const materials = fitContext({sourcePolicy:v1,traces:trainingTraces(dir,2,"v1")}, Buffer.byteLength(v0) > Buffer.byteLength(v1) ? v0 : v1,700);
+    await editPolicy(dir,"v2","v1","v1",materials.traces,protocol,materials);
+    await editPolicy(dir,"v2_reset","v0","v1",materials.traces,protocol,materials);
+  }
+  event(dir,{event:"phase_started",phase,mockExerciseAll:protocol.mode === "mock" && mockExerciseAll});
+  const worlds = phase === 1 ? [["D1","D2","D3"]] : phase === 2 ? [["T1"],["T2"],["T3"]] : [["R1"],["R2"],["R3"]];
+  const arms = phase === 1 ? ["independent","v0"] : phase === 2 ? ["v0","v1"] : ["v1","v2","v2_reset"];
+  for (const group of worlds) {
+    const settled = await Promise.allSettled([0,1,2].map(repeat => pairSearch(dir,phase,group,repeat,arms,protocol)));
+    const failed = settled.find(x => x.status === "rejected");
+    if (failed?.status === "rejected") throw failed.reason;
+  }
+  const rows = readLines(join(dir,"results.jsonl")).filter(x => x.event === "trial_complete" && x.phase === phase);
+  const decision = phaseDecision(phase,rows); save(done,decision); event(dir,{event:"phase_completed",...decision}); analyze(dir); return decision;
+}
+async function main() {
+  const args = process.argv.slice(2), action = args[0];
+  const option = (name: string) => args.indexOf(name) >= 0 ? args[args.indexOf(name)+1] : undefined;
+  const id = option("--run-id");
+  if (!id || !/^[a-zA-Z0-9_-]+$/.test(id)) throw Error("BAD_RUN_ID");
+  const dir = resolve("outputs/rsi-binpack",id);
+  if (action === "prepare") { prepare(dir,args.includes("--mock")); console.log(JSON.stringify({prepared:dir})); return; }
+  verify(dir);
+  const lock = join(dir,"runner.lock");
+  if (existsSync(lock)) {
+    const pid = read(lock).pid;
+    try { process.kill(pid,0); throw Error(`RUN_ALREADY_ACTIVE:${pid}`); }
+    catch(error: any) { if(error.code !== "ESRCH") throw error; }
+    unlinkSync(lock);
+  }
+  writeFileSync(lock,JSON.stringify({pid:process.pid}),{flag:"wx"});
+  try {
+    if (action === "preflight" && args.includes("--live")) {
+      const file = join(dir,"preflight/summary.json");
+      if (existsSync(file)) { console.log(JSON.stringify(read(file))); return; }
+      console.log(JSON.stringify(await livePreflight(join(dir,"preflight"))));
+    } else if (action === "preflight" && args.includes("--mock")) {
+      const checkDir = join(dir,"mock-check"); prepare(checkDir,true);
+      for(let phase=1;phase<=3;phase++) await runPhase(checkDir,phase,true);
+      console.log(JSON.stringify({mock:"ALL_THREE_PHASES_EXERCISED",report:join(checkDir,"report.zh-CN.md")}));
+    } else if (action === "run") console.log(JSON.stringify(await runPhase(dir,Number(option("--phase")))));
+    else throw Error("UNKNOWN_COMMAND");
+  } finally { unlinkSync(lock); }
+}
+if (process.argv[1] && import.meta.url === pathToFileURL(resolve(process.argv[1])).href) main().catch(error => { console.error(String(error)); process.exitCode=1; });
