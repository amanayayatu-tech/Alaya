+// The container is the security boundary. Fresh JS realms also prevent cross-instance state.
+import vm from 'node:vm';
+import readline from 'node:readline';
+let contexts = [];
+const invoke = new vm.Script('JSON.stringify(chooseBin(...JSON.parse(input)))');
+for await (const line of readline.createInterface({ input: process.stdin })) {
+  try {
+    const request = JSON.parse(line);
+    if (request.code !== undefined) {
+      contexts = Array.from({ length: request.count }, () => {
+        const context = vm.createContext(Object.create(null), { codeGeneration: { strings: false, wasm: false } });
+        new vm.Script('Date = undefined; Math.random = () => { throw Error("NONDETERMINISTIC_RANDOM"); }; Object.freeze(Math);').runInContext(context);
+        new vm.Script(`globalThis.chooseBin = (${request.code}); if (typeof chooseBin !== 'function') throw Error('NOT_FUNCTION');`).runInContext(context, { timeout: 1000 });
+        return context;
+      });
+      process.stdout.write('{"ready":true}\n');
+    } else {
+      const values = request.inputs.map((input, i) => {
+        contexts[i].input = JSON.stringify([input.item, input.bins]);
+        const encoded = invoke.runInContext(contexts[i]);
+        return encoded === undefined ? null : JSON.parse(encoded);
+      });
+      process.stdout.write(JSON.stringify({ values }) + '\n');
+    }
+  } catch (error) {
+    process.stdout.write(JSON.stringify({ error: String(error.message).slice(0, 1000) }) + '\n');
+  }
+}
