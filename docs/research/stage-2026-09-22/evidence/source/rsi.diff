--- /dev/null
+++ b/experiments/rsi-binpack/domain.ts
@@ -0,0 +1,90 @@
+import { createHash } from "node:crypto";
+
+export const CAPACITY = 100;
+export const LENGTH = 256;
+export const WORLDS = ["D1", "D2", "D3", "T1", "T2", "T3", "R1", "R2", "R3"] as const;
+export type World = typeof WORLDS[number];
+export type Split = "train" | "dev" | "test";
+export type Instance = { id: string; world: World; items: number[] };
+export type Dataset = Record<string, Record<Split, Instance[]>>;
+export const BEST_FIT = `function chooseBin(item, remainingCapacities) {
+  let best = -1;
+  for (let i = 0; i < remainingCapacities.length; i++) {
+    if (remainingCapacities[i] >= item && (best === -1 || remainingCapacities[i] < remainingCapacities[best])) best = i;
+  }
+  return best;
+}`;
+export const FIRST_FIT = `function chooseBin(item, remainingCapacities) {
+  for (let i = 0; i < remainingCapacities.length; i++) if (remainingCapacities[i] >= item) return i;
+  return -1;
+}`;
+export function hash(value: unknown): string {
+  return createHash("sha256").update(typeof value === "string" ? value : JSON.stringify(value)).digest("hex");
+}
+export function random(seed: string) {
+  let state = parseInt(hash(seed).slice(0, 8), 16) || 1;
+  return () => {
+    state ^= state << 13; state ^= state >>> 17; state ^= state << 5;
+    return (state >>> 0) / 4294967296;
+  };
+}
+export function generate(world: World, seed: string): number[] {
+  const rng = random(seed);
+  const integer = (a: number, b: number) => a + Math.floor(rng() * (b - a + 1));
+  return Array.from({ length: LENGTH }, (_, i) => {
+    switch (world) {
+      case "D1": return integer(1, 99);
+      case "D2": return rng() < 0.5 ? integer(5, 35) : integer(65, 95);
+      case "D3": return rng() < 0.7 ? integer(10, 40) : integer(60, 90);
+      case "T1": return rng() < 0.25 ? integer(5, 40) : integer(60, 95);
+      case "T2": { const p = rng(); return p < 0.2 ? integer(1, 20) : p < 0.7 ? integer(40, 60) : integer(80, 99); }
+      case "T3": return i < 128 ? integer(51, 79) : integer(21, 49);
+      case "R1": return rng() < 0.6 ? integer(10, 45) : integer(55, 90);
+      case "R2": return integer(25, 75);
+      case "R3": return i < 128 ? integer(1, 49) : integer(51, 99);
+    }
+  });
+}
+export function buildDataset(seed: string, counts = { train: 32, dev: 32, test: 128 }): Dataset {
+  const dataset: Dataset = {};
+  const seen = new Set<string>();
+  for (const world of WORLDS) for (let repeat = 0; repeat < 3; repeat++) {
+    const key = `${world}-${repeat}`;
+    const group = dataset[key] = { train: [], dev: [], test: [] };
+    for (const split of ["train", "dev", "test"] as const) for (let i = 0; i < counts[split]; i++) {
+      const id = `${key}-${split}-${i}`;
+      let salt = 0, items: number[], digest: string;
+      do { items = generate(world, `${seed}:${id}:${salt++}`); digest = hash(items); } while (seen.has(digest));
+      seen.add(digest); group[split].push({ id, world, items });
+    }
+  }
+  return dataset;
+}
+export function bestFit(item: number, bins: number[]) {
+  let best = -1;
+  for (let i = 0; i < bins.length; i++) if (bins[i] >= item && (best < 0 || bins[i] < bins[best])) best = i;
+  return best;
+}
+export function applyChoice(item: number, bins: number[], choice: unknown): void {
+  if (!Number.isInteger(choice) || (choice as number) < -1 || (choice as number) >= bins.length) throw Error("INVALID_INDEX");
+  if (choice === -1) bins.push(CAPACITY - item);
+  else {
+    if (bins[choice as number] < item) throw Error("CAPACITY_EXCEEDED");
+    bins[choice as number] -= item;
+  }
+}
+export function baseline(items: number[]): number {
+  const bins: number[] = [];
+  for (const item of items) applyChoice(item, bins, bestFit(item, bins));
+  return bins.length;
+}
+export const average = (xs: number[]) => xs.reduce((a, b) => a + b, 0) / xs.length;
+export function headroom(dataset: Dataset) {
+  return Object.fromEntries(WORLDS.map(world => {
+    const rows = [0, 1, 2].flatMap(r => [...dataset[`${world}-${r}`].train, ...dataset[`${world}-${r}`].dev]);
+    const bins = rows.map(x => baseline(x.items));
+    const lower = rows.map(x => Math.ceil(x.items.reduce((a, b) => a + b, 0) / CAPACITY));
+    return [world, { meanBins: average(bins), meanCapacityLowerBound: average(lower), meanGap: average(bins.map((b, i) => b - lower[i])), lowerBoundNotNecessarilyAttainable: true }];
+  }));
+}
+export type Score = { valid: boolean; mean: number; bins: number[]; error: string | null; elapsedMs: number; feedback: unknown[] };
