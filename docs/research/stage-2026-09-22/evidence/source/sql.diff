+#!/usr/bin/env node
+import assert from 'node:assert/strict';
+import { AsyncLocalStorage } from 'node:async_hooks';
+import { createHash } from 'node:crypto';
+import { existsSync, mkdirSync, readFileSync, writeFileSync, appendFileSync } from 'node:fs';
+import { dirname, resolve } from 'node:path';
+import { fileURLToPath } from 'node:url';
+import { spawnSync } from 'node:child_process';
+import { parseArgs } from 'node:util';
+
+const root = resolve(dirname(fileURLToPath(import.meta.url)), '..');
+const script = resolve(root, 'scripts/lib/sql-repair-closeout.py');
+const { values } = parseArgs({ options: { out: { type: 'string' }, probe: { type: 'boolean', default: false }, families: { type: 'string' } } });
+if (!values.out) throw new Error('Usage: node --import tsx scripts/sql-closeout-experiment.mjs --out PATH [--probe] [--families a,b]');
+const out = resolve(values.out);
+if (existsSync(out)) throw new Error(`Refusing to overwrite run directory: ${out}`);
+mkdirSync(out, { recursive: true });
+const save = (name, data) => writeFileSync(resolve(out, name), JSON.stringify(data, null, 2));
+const append = (name, data) => appendFileSync(resolve(out, name), JSON.stringify(data) + '\n');
+const digest = data => createHash('sha256').update(typeof data === 'string' ? data : JSON.stringify(data)).digest('hex');
+const python = (args, payload) => {
+  const result = spawnSync('python3', [script, ...args], { encoding: 'utf8', input: payload ? JSON.stringify(payload) : undefined, timeout: 20000, maxBuffer: 40 * 1024 * 1024 });
+  if (result.status !== 0) throw new Error(`Independent evaluator process failed: ${result.error?.message ?? result.stderr}`);
+  return JSON.parse(result.stdout);
+};
+const familyArgs = values.families ? ['--families', values.families] : [];
+const startedAt = new Date().toISOString();
+const selfTest = python(['--self-test']);
+const cases = python(values.probe ? ['generate-probe', ...familyArgs] : ['generate-full', ...familyArgs]);
+const allCases = [...cases.dev, ...cases.train, ...cases.test];
+for (const c of allCases) assert.equal(python(['evaluate'], { case: c, sql: c.private.goldSql }).passed, true, `CLI oracle disagreement: ${c.id}`);
+save('cases.json', cases);
+process.env.ALAYA_DB_PATH = resolve(out, 'alaya.db');
+process.env.ALAYA_MODE = 'development';
+process.env.ALAYA_LLM_PROVIDER = 'openai';
+process.env.ALAYA_KNOWLEDGE_RANKING = 'static';
+process.env.ALAYA_INJECTION_EPSILON = '0';
+process.env.ALAYA_KNOWLEDGE_INJECTION = 'on';
+if (process.env.ALAYA_KNOWLEDGE_RETRIEVAL_CONTROL_PATH) throw new Error('Do not attach this independent DEVELOPMENT run to an old controller.');
+const { OpenAIProvider, resolveOpenAIApiKey } = await import('../alaya-core/src/llm/provider.ts');
+if (!resolveOpenAIApiKey()) throw new Error('Configure OPENAI_API_KEY_FILE or OPENAI_API_KEY.');
+const { storage } = await import('../alaya-app/server/storage.ts');
+const { createSqlProject, runSqlRepairTask, rawSqlMemory } = await import('../alaya-app/server/sqlRepair.ts');
+const model = process.env.OPENAI_MODEL ?? 'MiniMax-M3';
+process.env.OPENAI_MODEL = model;
+const baseUrl = process.env.OPENAI_BASE_URL ?? 'https://api.minimax.io/openai';
+const provider = new OpenAIProvider({ model, baseUrl, temperature: 0, maxOutputTokens: 2048, maxRetries: 0, allowSimplifiedFallback: false, timeoutMs: 30000 });
+const scope = new AsyncLocalStorage();
+const nativeFetch = globalThis.fetch;
+const wire = [];
+const maxCalls = values.probe ? cases.dev.length : cases.train.length + cases.test.length * 2;
+let issuedCalls = 0;
+globalThis.fetch = async (url, init) => {
+  if (++issuedCalls > maxCalls) throw new Error('Predeclared provider call cap exhausted');
+  const request = JSON.parse(String(init.body));
+  const metadata = scope.getStore();
+  const requestUser = JSON.parse(request.messages[1].content);
+  assert.ok(metadata);
+  assert.equal(requestUser.role, 'builder');
+  assert.deepEqual(Object.keys(requestUser.context), ['query']);
+  if (metadata.arm === 'none') assert.equal(requestUser.knowledge_summary, '');
+  assert.ok(!String(init.body).includes('"goldSql"'));
+  const receipt = { call: issuedCalls, ...metadata, role: requestUser.role, request, requestSha256: digest(String(init.body)), startedAt: new Date().toISOString() };
+  append('requests-started.jsonl', receipt);
+  const started = Date.now();
+  try {
+    const response = await nativeFetch(url, init);
+    receipt.httpStatus = response.status;
+    try { receipt.response = await response.clone().json(); } catch { receipt.responseParseFailed = true; }
+    return response;
+  } catch (error) {
+    receipt.transportError = error instanceof Error ? error.message : String(error);
+    throw error;
+  } finally {
+    receipt.latencyMs = Date.now() - started;
+    wire.push(receipt); append('requests.jsonl', receipt);
+  }
+};
+
+const families = [...new Set(allCases.map(c => c.family))];
+const arms = values.probe ? ['none'] : ['source', 'none', 'raw'];
+const projectId = (family, arm) => `sql_${family}_${arm}`;
+for (const family of families) for (const arm of arms) createSqlProject(projectId(family, arm));
+const knowledgeSnapshot = () => families.flatMap(family => arms.flatMap(arm => storage.listKnowledge(projectId(family, arm))));
+const initialKnowledge = knowledgeSnapshot();
+assert.equal(initialKnowledge.length, 0);
+const sourceFiles = ['scripts/lib/sql-repair-closeout.py', 'scripts/lib/sql-repair-cases.py', 'scripts/sql-closeout-experiment.mjs', 'scripts/analyze-sql-closeout.mjs', 'alaya-app/server/sqlRepair.ts', 'alaya-core/src/llm/provider.ts', 'alaya-app/server/storage.ts', 'alaya-app/server/trace.ts'];
+const sourceHashes = Object.fromEntries(sourceFiles.map(path => [path, digest(readFileSync(resolve(root, path), 'utf8'))]));
+const closeout = {
+  kind: values.probe ? 'probe' : 'full',
+  families,
+  schemaVersion: 'sql-repair-closeout-v1',
+  distiller: false,
+  testArms: values.probe ? ['none'] : ['none', 'raw'],
+  hardIfCorrectAtMost: 2,
+  easyIfCorrectAtLeast: 3,
+  probeItemsPerFamily: 4,
+  continueIfHardFamiliesAtLeast: 2,
+  winNetWinsAtLeast: 3,
+  winFamiliesPositiveAtLeast: 2,
+};
+const manifest = { evidenceMode: 'DEVELOPMENT', closeout, startedAt, baseCommit: 'b7090b11b41f358f4d82906c86be835a68c06e64', modelRequested: model, baseUrl, temperature: 0, maxOutputTokens: 2048, retries: 0, simplifiedFallback: false, maxCalls, testConcurrency: values.probe ? 1 : 2, memoryCharCeiling: 12000, rawMemoryK: 2, ranking: 'static', epsilon: 0, sourceHashes, casesSha256: digest(cases), initialKnowledgeSha256: digest(initialKnowledge), evaluator: selfTest, probe: Boolean(values.probe) };
+save('manifest.json', manifest);
+const results = [], episodes = [];
+let serial = 0;
+async function run(c, phase, arm) {
+  const idx = ++serial;
+  const result = await scope.run({ phase, arm, taskId: c.id }, () => runSqlRepairTask({
+    task: { id: c.id, family: c.family, prompt: c.prompt }, phase, arm,
+    projectId: projectId(c.family, arm), runId: startedAt, cycleId: `sql_cycle_${idx}_${arm}`, index: idx, provider, episodes,
+    ...(phase === 'train' ? { correctSql: c.private.goldSql } : {}),
+    evaluate: sql => python(['evaluate'], { case: c, sql }),
+  }));
+  const row = { ...result, responses: result.responses.map(r => ({ schemaValid: r.schemaValid, retryCount: r.retryCount, degradedToHumanGate: r.degradedToHumanGate, errorMessage: r.errorMessage, data: r.data, log: r.log })) };
+  results.push(row); append('results.jsonl', row);
+  console.log(JSON.stringify({ phase, task: c.id, arm, passed: row.outcome.passed, schemaValid: row.schemaValid, selected: row.refs.length, callsCompleted: wire.length }));
+  return row;
+}
+function scoreArm(phase, arm) {
+  const rows = results.filter(r => r.phase === phase && r.arm === arm);
+  return { n: rows.length, correct: rows.filter(r => r.outcome.passed).length, schemaFailures: rows.filter(r => !r.schemaValid).length };
+}
+function byFamily(phase, selectedArms) {
+  return Object.fromEntries(families.map(family => [family, Object.fromEntries(selectedArms.map(arm => {
+    const rows = results.filter(r => r.phase === phase && r.arm === arm && r.family === family);
+    return [arm, { n: rows.length, correct: rows.filter(r => r.outcome.passed).length, schemaFailures: rows.filter(r => !r.schemaValid).length }];
+  }))]));
+}
+function probeDecision(familyScores) {
+  const hardFamilies = [], easyFamilies = [];
+  for (const [family, scored] of Object.entries(familyScores)) {
+    assert.equal(scored.none.n, 4, `probe family size: ${family}`);
+    if (scored.none.correct <= 2) hardFamilies.push(family);
+    if (scored.none.correct >= 3) easyFamilies.push(family);
+  }
+  return { hardFamilies, easyFamilies, continueToAb: hardFamilies.length >= 2, rule: 'hard if A<=2/4; easy if A>=3/4; continue A/B iff >=2 hard families' };
+}
+function usage() {
+  return {
+    observedModels: [...new Set(wire.map(w => w.response?.model).filter(Boolean))],
+    providerTokens: wire.reduce((s, w) => ({ input: s.input + (w.response?.usage?.prompt_tokens ?? 0), output: s.output + (w.response?.usage?.completion_tokens ?? 0), cached: s.cached + (w.response?.usage?.prompt_tokens_details?.cached_tokens ?? 0) }), { input: 0, output: 0, cached: 0 }),
+    providerUsageMissing: wire.filter(w => !w.response?.usage).length,
+  };
+}
+let frozen;
+try {
+  if (values.probe) {
+    for (const c of cases.dev) await run(c, 'probe', 'none');
+    const familyScores = byFamily('probe', ['none']);
+    const decision = probeDecision(familyScores);
+    const receipt = { ...manifest, completedAt: new Date().toISOString(), issuedCalls, completedCalls: wire.length, scores: { none: scoreArm('probe', 'none') }, byFamily: familyScores, probeDecision: decision, knowledgeFrozen: true, ...usage() };
+    save('summary.json', receipt);
+    console.log(JSON.stringify({ done: true, probe: true, scores: receipt.scores, byFamily: familyScores, probeDecision: decision, requests: wire.length, out }));
+  } else {
+    const familyIds = [...new Set(cases.train.map(c => c.family))];
+    const perFamily = Math.max(...familyIds.map(f => cases.train.filter(c => c.family === f).length));
+    for (let i = 0; i < perFamily; i++) for (const family of familyIds) {
+      const c = cases.train.filter(c => c.family === family)[i];
+      if (!c) continue;
+      episodes.push((await run(c, 'train', 'source')).episode);
+    }
+    save('train-experiences.json', episodes);
+    assert.equal(knowledgeSnapshot().length, 0, 'source training must not write knowledge');
+    for (const c of cases.test) assert.ok(rawSqlMemory(c, episodes).ids.length > 0, `raw memory empty: ${c.id}`);
+    frozen = knowledgeSnapshot();
+    save('knowledge-before-test.json', frozen);
+    const freeze = { at: new Date().toISOString(), knowledgeSha256: digest(frozen), experiencesSha256: digest(episodes), sourceHashes, casesSha256: digest(cases) };
+    save('test-input-freeze.json', freeze);
+    const testArms = ['none', 'raw'];
+    const ordered = [...cases.test].sort((a, b) => digest(a.id).localeCompare(digest(b.id)));
+    for (const [i, c] of ordered.entries()) {
+      const order = testArms.map((_, j) => testArms[(i + j) % testArms.length]);
+      await Promise.all(order.map(arm => run(c, 'test', arm)));
+    }
+    const after = knowledgeSnapshot();
+    save('knowledge-after-test.json', after);
+    assert.equal(digest(after), digest(frozen), 'Heldout mutated knowledge state');
+    assert.equal(digest(episodes), freeze.experiencesSha256, 'Heldout mutated raw experiences');
+    for (const path of sourceFiles) assert.equal(digest(readFileSync(resolve(root, path), 'utf8')), sourceHashes[path], `Source changed during run: ${path}`);
+    const familyScores = byFamily('test', testArms);
+    const receipt = { ...manifest, completedAt: new Date().toISOString(), issuedCalls, completedCalls: wire.length, scores: { none: scoreArm('test', 'none'), raw: scoreArm('test', 'raw') }, byFamily: familyScores, knowledgeFrozen: digest(knowledgeSnapshot()) === digest(frozen), ...usage() };
+    save('summary.json', receipt);
+    console.log(JSON.stringify({ done: true, scores: receipt.scores, byFamily: familyScores, requests: wire.length, out }));
+  }
+} catch (error) {
+  save('failure.json', { failedAt: new Date().toISOString(), error: error instanceof Error ? error.message : String(error), issuedCalls, completedCalls: wire.length, resultRows: results.length });
+  throw error;
+} finally { globalThis.fetch = nativeFetch; }
