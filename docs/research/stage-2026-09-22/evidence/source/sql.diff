+function parseJsonObjectText(text: string, source: string, schema?: JsonSchema): Record<string, unknown> {
+  const raw = text.trim();
+  const jsonTrimmed = raw.replace(/^```(?:json)?\s*/i, "").replace(/\s*```$/i, "");
+  const candidates = [stripThinkingBlocks(raw), stripThinkingBlocks(jsonTrimmed), raw, jsonTrimmed];
+
+  // Some OpenAI-compatible models return a complete SQL answer despite the
+  // JSON instruction. Keep this envelope fallback narrow: only a schema whose
+  // sole declared and required field is sql:string may use it. The evaluator
+  // remains responsible for SQLite legality and correctness.
+  if (schema && isSingleSqlSchema(schema)) {
+    // Prefer the original text so a SQL literal containing a thinking-like
+    // marker is not rewritten; stripped candidates still handle a leading
+    // provider <think>...</think> wrapper.
+    for (const candidate of [raw, jsonTrimmed, ...candidates]) {
+      const sql = extractSqlEnvelope(candidate);
+      if (sql) return sql;
+    }
+  }
+
+  for (const candidate of candidates) {
     const parsed = tryParseJsonObject(candidate);
     if (parsed) return parsed;
   }
   throw new Error(`${source} response was not parseable JSON: ${text.slice(0, 300)}`);
 }
 
+function isSingleSqlSchema(schema: JsonSchema): boolean {
+  const properties = schema.properties ?? {};
+  const sql = properties.sql;
+  return schema.type === "object"
+    && schema.required?.length === 1
+    && schema.required[0] === "sql"
+    && Object.keys(properties).length === 1
+    && !!sql
+    && "type" in sql
+    && sql.type === "string";
+}
+
+function extractSqlEnvelope(text: string): Record<string, unknown> | null {
+  let candidate = text.trim();
+  const fenced = /^```(?:sql)?[ \t]*(?:\r?\n)?([\s\S]*?)(?:\r?\n)?```$/i.exec(candidate);
+  if (fenced) candidate = fenced[1].trim();
+  else if (/^```|```$/.test(candidate)) return null;
+
+  if (!/^(?:select|with)\b/i.test(candidate)) return null;
+  return { sql: candidate };
+}
+
 function stripThinkingBlocks(text: string): string {
   return text.replace(/<think>[\s\S]*?<\/think>/gi, "").trim();
 }
