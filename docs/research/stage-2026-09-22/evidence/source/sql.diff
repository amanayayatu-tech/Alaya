+def _variant_bits(split: str, index: int) -> Tuple[bool, bool, bool, bool]:
+    """Return one of 8 parity-held-out combinations of four public rules.
+
+    Train uses even parity and test uses odd parity.  Every atomic rule is
+    therefore seen in both splits, while no complete four-rule combination is
+    shared.  Dev uses the first two even combinations and remains separate by
+    schema names/seeds.
+    """
+    parity = 1 if split == "test" else 0
+    patterns = [
+        tuple(bool((mask >> bit) & 1) for bit in range(4))
+        for mask in range(16)
+        if (mask.bit_count() % 2) == parity
+    ]
+    return patterns[index % len(patterns)]  # type: ignore[return-value]
