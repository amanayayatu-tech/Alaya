@@ -0,0 +1,129 @@
+/** Executable DEVELOPMENT task adapter. No SCENARIO or mock outcome enters this path. */
+import { createHash } from "node:crypto";
+import type { AgentContext, LLMProvider, LLMResponse } from "alaya-core/src/llm/provider.js";
+import { applyEvidence } from "alaya-core/src/core/update_confidence.js";
+import { transitionState } from "alaya-core/src/core/transition_state.js";
+import type { KnowledgeItem as CoreKnowledge } from "alaya-core/src/core/types.js";
+import type { KnowledgeItem } from "@shared/schema";
+import { storage, now } from "./storage";
+import { buildKnowledgeContext, withKnowledgeRetrievalIdentity, KNOWLEDGE_RETRIEVAL_CONTROL_SCHEMA } from "./knowledgeInjection";
+import { computeCreditUpdates, applyCreditUpdates } from "./knowledgeCredit";
+import { recordTrace } from "./trace";
+
+export type SqlTask = { id: string; family: string; prompt: string };
+export type SqlOutcome = { passed: boolean; checks: number; passedChecks: number; error?: string; counterexample?: unknown };
+export type SqlEpisode = { task: SqlTask; sql: string; outcome: SqlOutcome; correctSql: string };
+export const MEMORY_CHAR_LIMIT = 12_000;
+const SQL_SCHEMA = { type: "object" as const, required: ["sql"], properties: { sql: { type: "string" } } };
+const LESSON_SCHEMA = { type: "object" as const, required: ["title", "lesson", "sql"], properties: { title: { type: "string" }, lesson: { type: "string" }, sql: { type: "string" } } };
+
+const terms = (s: string) => new Set(s.toLowerCase().match(/[a-z][a-z_]{2,}/g) ?? []);
+export const sqlRetrievalQuery = (task: SqlTask) => `${task.family}\n${task.prompt}`;
+
+/** Strong raw baseline: same public family, fixed lexical similarity, two WHOLE episodes. */
+export function rawSqlMemory(task: SqlTask, episodes: readonly SqlEpisode[]): { text: string; ids: string[] } {
+  const query = terms(sqlRetrievalQuery(task));
+  const ranked = episodes.filter(e => e.task.family === task.family).map(e => {
+    const words = terms(sqlRetrievalQuery(e.task));
+    const common = Array.from(words).filter(w => query.has(w)).length;
+    return { e, score: common / Math.max(1, words.size + query.size - common) };
+  }).sort((a, b) => b.score - a.score || a.e.task.id.localeCompare(b.e.task.id));
+  const included: string[] = [], ids: string[] = [];
+  for (const { e } of ranked) {
+    const record = JSON.stringify(e);
+    if (record.length > MEMORY_CHAR_LIMIT) throw new Error(`Raw episode exceeds shared memory budget: ${e.task.id}`);
+    if (included.join("\n").length + record.length + 1 > MEMORY_CHAR_LIMIT) continue;
+    included.push(record); ids.push(e.task.id);
+    if (ids.length === 2) break;
+  }
+  return { text: included.join("\n"), ids };
+}
+
+function agentRecord(cycleId: string, cycleIdx: number, agent: string, action: string, summary: string, refs: string[] = []) {
+  storage.recordAgentRun({ cycleId, cycleIdx, agent, action, outputSummary: summary, knowledgeRefsUsed: JSON.stringify(refs), ts: now() });
+}
+
+export function createSqlProject(id: string) {
+  if (storage.getProject(id)) throw new Error(`SQL experiment requires a fresh project: ${id}`);
+  storage.createProject({ id, name: id, direction: "Repair read-only SQLite queries from explicit business contracts", targetUser: "SQL analysts", redlines: JSON.stringify(["only local read-only SQL", "no strong promotion without human approval"]), weeklyHumanMinutes: 0, weeklyLlmBudgetCents: 1000, firstClaimMetric: "all_fixtures_correct", firstClaimOperator: ">=", firstClaimTarget: 1, seedIdentity: "DEVELOPMENT executable task", worldModel: "", currentCycleIdx: 0, version: 1 });
+}
+
+export async function runSqlRepairTask(input: {
+  task: SqlTask; projectId: string; runId: string; cycleId: string; index: number;
+  phase: "dev" | "train" | "test" | "probe"; arm: "none" | "raw" | "alaya" | "source";
+  provider: LLMProvider; evaluate: (sql: string) => SqlOutcome;
+  episodes?: readonly SqlEpisode[]; correctSql?: string;
+}) {
+  const { task, projectId, cycleId, index, phase, provider } = input;
+  if (phase === "train" && input.arm !== "alaya" && input.arm !== "source") throw new Error("Training only records source episodes or Alaya learning.");
+  if (phase === "train" && !input.correctSql) throw new Error("Training requires independently checked corrective SQL.");
+  if (phase === "train" && !input.evaluate(input.correctSql!).passed) throw new Error("Corrective SQL disagrees with independent oracle; refuse to learn");
+  storage.createCycle({ id: cycleId, projectId, idx: index, goal: task.prompt, status: "running", eCycle: null, worstClaimError: null, reasoning: "", version: 1 });
+  agentRecord(cycleId, index, "orchestrator", "delegate_sql_repair", `Fixed ${phase} task; arm=${input.arm}; family=${task.family}`);
+  let memory = "", refs: string[] = [];
+  if (input.arm === "raw") ({ text: memory, ids: refs } = rawSqlMemory(task, input.episodes ?? []));
+  if (input.arm === "alaya") {
+    memory = withKnowledgeRetrievalIdentity({ schema: KNOWLEDGE_RETRIEVAL_CONTROL_SCHEMA, projectId, runId: input.runId, caseId: task.id, cycleId, mode: phase === "train" ? "mutating" : "read_only" }, { projectId, cycleId }, () => buildKnowledgeContext(sqlRetrievalQuery(task), projectId, { cycleId, cycleIdx: index, agent: "builder" }));
+    refs = storage.listTraceEventsByCycle(cycleId).flatMap(e => {
+      if (e.name !== "build_prior_knowledge_context") return [];
+      const a = JSON.parse(e.attributes);
+      return a.injectedKnowledgeIds.length ? a.injectedKnowledgeIds : a.readOnlySelectedKnowledgeIds;
+    });
+  }
+  if (memory.length > MEMORY_CHAR_LIMIT) throw new Error("Memory exceeds shared budget");
+  const responses: LLMResponse[] = [];
+  async function call(request: AgentContext) {
+    const response = await provider.call(request);
+    responses.push(response);
+    storage.recordLlmCall({ cycleId, agent: request.role, provider: provider.name, model: process.env.OPENAI_MODEL ?? provider.name, routeReason: "sql DEVELOPMENT; core log uses generic cost estimate; wire receipt is authoritative", promptVersion: request.promptVersion, inputSummary: response.log.inputSummary, outputSummary: response.log.outputSummary, schemaValid: response.schemaValid ? 1 : 0, retryCount: response.retryCount, latencyMs: response.log.latencyMs, tokenCount: response.log.tokenCount, tokenSource: "estimated", estimatedCost: response.log.estimatedCost, ts: response.log.ts });
+    return response;
+  }
+  const built = await call({ role: "builder", task: "Repair the supplied SQLite query to satisfy every stated business rule. Return JSON with one sql string. Use prior experiences only when applicable; the current contract always takes precedence. Do not assume unstated fixture values.", promptVersion: "sql-repair.builder.v1", context: { query: task.prompt }, knowledgeSummary: memory, schema: SQL_SCHEMA });
+  const sql = built.schemaValid && typeof built.data.sql === "string" ? built.data.sql.trim() : "";
+  agentRecord(cycleId, index, "builder", "submit_sql", sql || built.errorMessage || "invalid structured response", refs);
+  const outcome = input.evaluate(sql);
+  agentRecord(cycleId, index, "sensor", "execute_sql_and_compare_python_reference", JSON.stringify(outcome));
+  recordTrace({ projectId, cycleId, cycleIdx: index, kind: "sql_execution", name: "independent_sql_outcome", agent: "sensor", attributes: { phase, caseId: task.id, arm: input.arm, sqlSha256: createHash("sha256").update(sql).digest("hex"), outcome } });
+  let episode: SqlEpisode | undefined;
+  let learnedId: string | null = null;
+  let lessonOutcome: SqlOutcome | null = null;
+  if (phase === "train") {
+    // The actual execution outcome is the ONLY reward; never a model's self-report.
+    episode = { task, sql, outcome, correctSql: input.correctSql! };
+    if (input.arm === "source") {
+      agentRecord(cycleId, index, "distiller", "source_episode_no_distillation", "Closeout training stores the complete verified episode only.");
+      agentRecord(cycleId, index, "librarian", "source_episode_no_knowledge_write", "No distilled knowledge, usage or credit mutation.");
+    } else {
+      applyCreditUpdates(computeCreditUpdates(refs, { cycleId, correct: outcome.passed }), { cycleIdx: index });
+      for (const id of refs) {
+        const k = storage.getKnowledge(id)!;
+        const transition = transitionState({ ...k, tags: JSON.parse(k.tags) } as CoreKnowledge, { currentCycle: index, conflictsWithStrong: false });
+        if (transition.changed && !transition.requiresHuman) storage.updateKnowledge(id, { status: transition.nextStatus, actor: "librarian" });
+      }
+      const distilled = await call({ role: "distiller", task: "From this completed training experience and verified corrective SQL, extract ONE reusable repair rule. State its applicability and a boundary where it must not be used. Use generic concepts rather than source table names or literal dates. lesson must be at most 480 characters. Also return sql that solves THIS source task, so the source recipe can be independently validated. Return JSON {title,lesson,sql}. Do not claim a rule is universally proven and do not assign confidence.", promptVersion: "sql-repair.distiller.v1", context: { experience: episode }, schema: LESSON_SCHEMA });
+      if (distilled.schemaValid && typeof distilled.data.lesson === "string" && typeof distilled.data.title === "string" && typeof distilled.data.sql === "string" && distilled.data.lesson.trim()) {
+        lessonOutcome = input.evaluate(distilled.data.sql);
+        const title = `${task.family}: ${distilled.data.title.trim().slice(0, 80)}`;
+        const content = distilled.data.lesson.trim().slice(0, 480);
+        // ponytail: exact text dedup only; semantic merging needs independent evidence before use.
+        const fingerprint = createHash("sha256").update(`${title}\n${content}`).digest("hex");
+        const existing = storage.listKnowledge(projectId).find(k => k.semanticKey === fingerprint);
+        if (existing) learnedId = existing.id;
+        else {
+          const base: KnowledgeItem = { id: `sql_k_${cycleId}`, projectId, type: "principle", title, content, sourceType: "agent_observation", sourceRef: task.id, evidenceAlpha: 1, evidenceBeta: 1, confidenceScore: 0.5, confidenceLevel: "low", status: "draft", humanApprovedCount: 0, externalVerifiedCount: 0, validFrom: now().slice(0, 10), validUntil: null, lastValidatedCycle: index, createdByCycle: index, createdBy: "distiller", approvedBy: null, usageCount: 0, tags: JSON.stringify([task.family, "sql", "source_task_verified_only"]), notes: "Source recipe execution evidence only; generalization and causal utility remain unproven.", semanticKey: fingerprint, version: 1 };
+          const verified = applyEvidence({ ...base, tags: JSON.parse(base.tags) } as CoreKnowledge, { kind: "prediction", normalizedError: lessonOutcome.passed ? 0 : 1 }).next;
+          const transition = transitionState(verified, { currentCycle: index, conflictsWithStrong: false });
+          storage.createKnowledge({ ...base, evidenceAlpha: verified.evidenceAlpha, evidenceBeta: verified.evidenceBeta, confidenceScore: verified.confidenceScore, confidenceLevel: verified.confidenceLevel, status: transition.requiresHuman ? "draft" : transition.nextStatus });
+          learnedId = base.id;
+        }
+      }
+      agentRecord(cycleId, index, "distiller", "extract_verified_source_recipe", JSON.stringify({ learnedId, lessonOutcome, schemaValid: distilled.schemaValid }));
+      agentRecord(cycleId, index, "librarian", "audit_training_memory", JSON.stringify({ creditedIds: refs, learnedId, strongPromotion: false }));
+    }
+  } else {
+    agentRecord(cycleId, index, "distiller", "frozen_evaluation_no_learning", "Evaluation outcomes are excluded from training memory.");
+    agentRecord(cycleId, index, "librarian", "frozen_evaluation_no_writes", "No knowledge, usage or credit mutation.");
+  }
+  storage.updateCycle(cycleId, { status: "closed", eCycle: outcome.passed ? 0 : 1, worstClaimError: outcome.passed ? 0 : 1 });
+  return { taskId: task.id, family: task.family, phase, arm: input.arm, sql, outcome, memory, refs, episode, learnedId, lessonOutcome, schemaValid: built.schemaValid, responses };
+}
