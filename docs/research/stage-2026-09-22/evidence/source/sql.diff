+def _rng_for(split: str, family_index: int, case_index: int, fixture_index: int) -> random.Random:
+    split_seed = {"train": 1100, "dev": 2200, "test": 3300}[split]
+    return random.Random(split_seed + family_index * 100_000 + case_index * 1_000 + fixture_index)
