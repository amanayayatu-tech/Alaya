+    line_rows = _rows_from_table(private, fixture, roles["lines"])
+    refund_rows = _rows_from_table(private, fixture, roles["refunds"])
+    region_accounts = {row[0] for row in account_rows if row[1] == spec["region"]}
+    posted, posted_n = {}, {}
+    for _rid, line_id, status, cents in refund_rows:
+        if status != "posted":
+            continue
+        posted[line_id] = posted.get(line_id, 0) + int(cents)
+        posted_n[line_id] = posted_n.get(line_id, 0) + 1
+    result: List[List[Any]] = []
+    for order_id, account_id, status, currency in order_rows:
+        if account_id not in region_accounts or status not in set(spec["qualifyingStatuses"]) or currency not in set(spec["currencies"]):
+            continue
+        lines = [row for row in line_rows if row[1] == order_id and (spec["includeZeroLine"] or int(row[3]) != 0)]
+        if not lines and not spec["includeEmpty"]:
+            continue
+        if spec["refundedOnly"] and sum(posted_n.get(row[0], 0) for row in lines) == 0:
+            continue
+        gross = sum(int(row[3]) for row in lines)
+        refund = 0
+        for line_id, _oid, _sku, line_cents in lines:
+            value = posted.get(line_id, 0)
+            refund += min(value, int(line_cents)) if spec["capPerLine"] else value
+        result.append([order_id, account_id, len(lines), gross, refund, gross - refund])
+    result.sort(key=lambda row: row[0])
+    return ["order_id", "account_id", "qualifying_line_count", "gross_cents", "refund_cents", "net_cents"], result
+
+
+def _fx_reference(case: Mapping[str, Any], fixture: Mapping[str, Any]) -> Tuple[List[str], List[List[Any]]]:
+    private, spec, roles = case["private"], case["private"]["oracleSpec"], case["private"]["tableRoles"]
+    order_rows = _rows_from_table(private, fixture, roles["orders"])
+    rate_rows = _rows_from_table(private, fixture, roles["rates"])
+    result: List[List[Any]] = []
+    for order_id, _account_id, currency, amount_cents, ordered_at in order_rows:
+        if spec["requirePositive"] and int(amount_cents) <= 0:
+            continue
+        if not spec["usdMustJoin"] and currency == "USD":
+            continue
+        matched = []
+        for rate_id, rate_ccy, usd_micros, valid_from, valid_to in rate_rows:
+            if rate_ccy != currency or valid_from > ordered_at:
+                continue
+            if spec["includeEnd"]:
+                if ordered_at > valid_to:
+                    continue
+            elif ordered_at >= valid_to:
+                continue
+            matched.append((valid_from, int(rate_id), int(usd_micros)))
+        if not matched:
+            if not spec["dropUnmatched"]:
+                result.append([order_id, currency, int(amount_cents), None, None])
+            continue
+        matched.sort(key=lambda row: (row[0], row[1]), reverse=True)
+        _vf, rate_id, usd_micros = matched[0]
+        result.append([order_id, currency, int(amount_cents), rate_id, _usd_cents(int(amount_cents), usd_micros)])
+    result.sort(key=lambda row: row[0])
+    return ["order_id", "currency", "amount_cents", "rate_id", "usd_cents"], result
+
+
+def _scd_reference(case: Mapping[str, Any], fixture: Mapping[str, Any]) -> Tuple[List[str], List[List[Any]]]:
+    private, spec, roles = case["private"], case["private"]["oracleSpec"], case["private"]["tableRoles"]
+    customer_rows = _rows_from_table(private, fixture, roles["customers"])
+    segment_rows = _rows_from_table(private, fixture, roles["segments"])
+    order_rows = _rows_from_table(private, fixture, roles["orders"])
+    region_ok = {row[0] for row in customer_rows if (not spec["regionFilter"] or row[1] == spec["region"])}
+    result: List[List[Any]] = []
+    for order_id, customer_id, ordered_at, amount_cents, status in order_rows:
+        if customer_id not in region_ok:
+            continue
+        if spec["paidOnly"] and status != "paid":
+            continue
+        matched = []
+        for row_id, seg_customer, segment, valid_from, valid_to in segment_rows:
+            if seg_customer != customer_id or valid_from > ordered_at:
+                continue
+            if spec["includeEnd"]:
+                if ordered_at > valid_to:
+                    continue
+            elif ordered_at >= valid_to:
+                continue
+            matched.append((valid_from, int(row_id), segment))
+        if not matched:
+            if spec["unknownIfUnmatched"]:
+                result.append([order_id, customer_id, "unknown", int(amount_cents)])
+            continue
+        matched.sort(key=lambda row: (row[0], row[1]), reverse=True)
+        result.append([order_id, customer_id, matched[0][2], int(amount_cents)])
+    result.sort(key=lambda row: row[0])
+    return ["order_id", "customer_id", "segment", "amount_cents"], result
+
+
+CASE_BUILDERS = {
+    "line_item_refund": _line_item_case,
+    "fx_as_of": _fx_case,
+    "scd2_segment": _scd_case,
+}
+REFERENCE_BY_FAMILY = {
+    "line_item_refund": _line_item_reference,
+    "fx_as_of": _fx_reference,
+    "scd2_segment": _scd_reference,
+}
+_MOD.REFERENCE_BY_FAMILY.update(REFERENCE_BY_FAMILY)
+
+
+def generate_case(split: str, family: str, index: int) -> Dict[str, Any]:
+    if family not in CASE_BUILDERS:
+        raise ValueError(f"unknown closeout family: {family}")
+    return CASE_BUILDERS[family](split, index)
+
+
+def generate_dataset(mode: str = "full", families: Sequence[str] | None = None) -> Dict[str, List[Dict[str, Any]]]:
+    selected = tuple(families) if families else CLOSEOUT_FAMILIES
+    unknown = [family for family in selected if family not in CLOSEOUT_FAMILIES]
+    if unknown:
+        raise ValueError(f"unknown closeout families: {unknown}")
+    if mode == "probe":
+        return {"dev": [generate_case("dev", family, index) for family in selected for index in range(CLOSEOUT_SPLIT_COUNTS["probe"])], "train": [], "test": []}
+    if mode != "full":
+        raise ValueError(f"unknown closeout mode: {mode}")
+    return {
+        "dev": [],
+        "train": [generate_case("train", family, index) for family in selected for index in range(CLOSEOUT_SPLIT_COUNTS["train"])],
+        "test": [generate_case("test", family, index) for family in selected for index in range(CLOSEOUT_SPLIT_COUNTS["test"])],
+    }
+
+
+def self_test() -> Dict[str, Any]:
+    full = generate_dataset("full")
+    probe = generate_dataset("probe")
+    _assert([len(full[key]) for key in ("dev", "train", "test")] == [0, 18, 18], "closeout split counts")
+    _assert(len(probe["dev"]) == 12, "probe count")
+    all_cases = full["train"] + full["test"] + probe["dev"]
+    _assert(len({case["id"] for case in all_cases}) == len(all_cases), "closeout unique IDs")
+    train_tables = {table for case in full["train"] for table in case["private"]["tableDefs"]}
+    test_tables = {table for case in full["test"] for table in case["private"]["tableDefs"]}
+    _assert(train_tables.isdisjoint(test_tables), "closeout train/test schema names overlap")
+    for family in CLOSEOUT_FAMILIES:
+        train_bits = {tuple(case["private"]["oracleSpec"]["variantBits"]) for case in full["train"] if case["family"] == family}
+        test_bits = {tuple(case["private"]["oracleSpec"]["variantBits"]) for case in full["test"] if case["family"] == family}
+        _assert(train_bits.isdisjoint(test_bits), f"closeout variant overlap: {family}")
+        for bit in range(4):
+            _assert(any(bits[bit] for bits in train_bits), f"closeout train never sees bit {bit}: {family}")
+            _assert(any(not bits[bit] for bits in train_bits), f"closeout train never sees false bit {bit}: {family}")
+            _assert(any(bits[bit] for bits in test_bits), f"closeout test never sees bit {bit}: {family}")
+            _assert(any(not bits[bit] for bits in test_bits), f"closeout test never sees false bit {bit}: {family}")
+    for case in all_cases:
+        gold_result = evaluate_case(case, case["private"]["goldSql"])
+        _assert(gold_result["passed"], f"closeout gold SQL failed: {case['id']} {gold_result}")
+        buggy = re.search(r"Buggy SQL \(it runs, but may violate the contract\):\n```sql\n(.*?)\n```", case["prompt"], re.S)
+        _assert(buggy is not None, f"closeout buggy SQL missing: {case['id']}")
+        buggy_result = evaluate_case(case, buggy.group(1))
+        _assert(not buggy_result["passed"], f"closeout buggy SQL unexpectedly passed: {case['id']} {buggy_result}")
+        _assert(case["private"]["goldSql"] not in case["prompt"], f"closeout gold leaked: {case['id']}")
+        _assert("correct" not in case["prompt"].lower().split("buggy sql", 1)[0], f"closeout answer hint: {case['id']}")
+    roundtrip = json.loads(_json(full))
+    for split_cases in roundtrip.values():
+        for case in split_cases:
+            result = evaluate_case(case, case["private"]["goldSql"])
+            _assert(result["passed"], f"closeout JSON roundtrip gold failed: {case['id']} {result}")
+    _assert(_usd_cents(10000, 1100000) == 11000, "fx conversion 1.1")
+    return {"ok": True, "train": len(full["train"]), "test": len(full["test"]), "probe": len(probe["dev"])}
+
+
+def main(argv: Sequence[str]) -> int:
+    if argv == ["--self-test"]:
+        print(_json(self_test()))
+        return 0
+    if not argv:
+        print("usage: sql-repair-closeout.py generate-probe|generate-full|evaluate| --self-test [--families a,b]", file=sys.stderr)
+        return 2
+    families = None
+    if "--families" in argv:
+        idx = argv.index("--families")
+        families = argv[idx + 1].split(",")
+        argv = argv[:idx] + argv[idx + 2:]
+    if argv == ["generate-probe"]:
+        print(_json(generate_dataset("probe", families)))
+        return 0
+    if argv == ["generate-full"]:
+        print(_json(generate_dataset("full", families)))
+        return 0
+    if argv == ["evaluate"]:
+        payload = json.load(sys.stdin)
+        print(_json(evaluate_case(payload["case"], payload.get("sql"))))
+        return 0
+    print("usage: sql-repair-closeout.py generate-probe|generate-full|evaluate| --self-test [--families a,b]", file=sys.stderr)
+    return 2
+
+
+if __name__ == "__main__":
+    raise SystemExit(main(sys.argv[1:]))
