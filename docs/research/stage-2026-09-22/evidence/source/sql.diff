+import test from 'node:test';
+import assert from 'node:assert/strict';
+import { mkdtempSync } from 'node:fs';
+import { join } from 'node:path';
+import { tmpdir } from 'node:os';
+import { MockLLM, type AgentContext, type LLMProvider } from 'alaya-core/src/llm/provider.ts';
+process.env.ALAYA_DB_PATH = join(mkdtempSync(join(tmpdir(), 'alaya-sql-test-')), 'test.db');
+process.env.ALAYA_KNOWLEDGE_RANKING = 'static';
+process.env.ALAYA_INJECTION_EPSILON = '0';
+process.env.ALAYA_KNOWLEDGE_INJECTION = 'on';
+const { storage } = await import('../server/storage.ts');
+const { createSqlProject, runSqlRepairTask, rawSqlMemory } = await import('../server/sqlRepair.ts');
+
+test('SQL adapter credits only executed outcomes, keeps all five roles, and freezes all test knowledge state', async () => {
+  createSqlProject('sql_regression');
+  const captured: AgentContext[] = [];
+  let wrong = false;
+  const provider: LLMProvider = { name: 'mock', async call(request) {
+    captured.push(request);
+    const data = request.role === 'distiller'
+      ? { title: 'Avoid duplicate aggregation', lesson: 'Pre-aggregate child SQL rows at the required grain; do not sum distinct amounts because different rows can have equal amounts.', sql: 'SELECT 1' }
+      : { sql: wrong ? 'SELECT 0' : 'SELECT 1', buildSuccess: true };
+    return new MockLLM().call({ ...request, mockData: data });
+  } };
+  const evaluate = (sql: string) => ({ passed: sql === 'SELECT 1', checks: 4, passedChecks: sql === 'SELECT 1' ? 4 : 0 });
+  const base = { projectId: 'sql_regression', runId: 'unit', provider, evaluate, task: { id: 'train-1', family: 'aggregation', prompt: 'Repair SQL aggregation with duplicate child rows.' } };
+  const first = await runSqlRepairTask({ ...base, index: 1, cycleId: 'source1', phase: 'train', arm: 'alaya', correctSql: 'SELECT 1' });
+  assert.ok(first.learnedId);
+  const k1 = storage.getKnowledge(first.learnedId!)!;
+  assert.equal(k1.status, 'active');
+  assert.equal(k1.evidenceAlpha, 2);
+  assert.equal(k1.evidenceBeta, 1);
+  assert.equal(k1.humanApprovedCount, 0);
+  const beforeBadOracle = JSON.stringify(storage.listKnowledge('sql_regression'));
+  await assert.rejects(runSqlRepairTask({ ...base, index: 9, cycleId: 'bad_oracle', phase: 'train', arm: 'alaya', correctSql: 'SELECT 0' }), /Corrective SQL disagrees/);
+  assert.equal(JSON.stringify(storage.listKnowledge('sql_regression')), beforeBadOracle);
+  assert.equal(storage.getCycle('bad_oracle'), undefined);
+  wrong = true;
+  const second = await runSqlRepairTask({ ...base, index: 2, cycleId: 'source2', phase: 'train', arm: 'alaya', correctSql: 'SELECT 1' });
+  assert.equal(second.outcome.passed, false);
+  assert.ok(second.refs.includes(first.learnedId!));
+  const afterWrong = storage.getKnowledge(first.learnedId!)!;
+  assert.equal(afterWrong.evidenceBeta, 2, 'False model success must not credit a wrong SQL answer');
+  assert.equal(afterWrong.evidenceAlpha, 2);
+  const snapshot = JSON.stringify(storage.listKnowledge('sql_regression'));
+  for (const [i, arm] of (['none', 'raw', 'alaya'] as const).entries()) {
+    const result = await runSqlRepairTask({ ...base, task: { ...base.task, id: 'heldout-new' }, index: i + 3, cycleId: `eval${i}`, phase: 'test', arm, episodes: [first.episode!] });
+    assert.equal(JSON.stringify(storage.listKnowledge('sql_regression')), snapshot);
+    assert.equal(storage.listAgentRuns(`eval${i}`).length, 5);
+    const body = captured.at(-1)!;
+    assert.deepEqual(Object.keys(body.context), ['query']);
+    assert.equal(body.mockData, undefined);
+    if (arm === 'none') assert.equal(body.knowledgeSummary, '');
+    else assert.ok(result.memory.length > 0);
+  }
+  assert.equal(storage.listLlmCalls().length, 7);
+  assert.equal(captured.length, 7, 'two training calls per source, one call per test');
+});
+
+test('raw retrieval supplies complete same-family train records with a fixed tie-break', () => {
+  const task = { id: 'heldout', family: 'funnel', prompt: 'repair SQL funnel stage window' };
+  const records = ['train-b', 'train-a', 'train-c'].map(id => ({ task: { ...task, id }, sql: 'WRONG SQL', correctSql: 'CORRECT SQL', outcome: { passed: false, checks: 4, passedChecks: 0 } }));
+  const selected = rawSqlMemory(task, records);
+  assert.deepEqual(selected.ids, ['train-a', 'train-b']);
+  const decoded = selected.text.split('\n').map(s => JSON.parse(s));
+  assert.deepEqual(decoded, [records[1], records[0]]);
+  assert.equal(rawSqlMemory({ ...task, family: 'other' }, records).text, '');
+});
+
+test('source training stores one complete episode with one builder call and no knowledge writes', async () => {
+  createSqlProject('sql_source_closeout');
+  const captured: AgentContext[] = [];
+  const provider: LLMProvider = { name: 'mock', async call(request) {
+    captured.push(request);
+    return new MockLLM().call({ ...request, mockData: { sql: 'SELECT 1', buildSuccess: true } });
+  } };
+  const evaluate = (sql: string) => ({ passed: sql === 'SELECT 1', checks: 4, passedChecks: sql === 'SELECT 1' ? 4 : 0 });
+  const result = await runSqlRepairTask({
+    projectId: 'sql_source_closeout', runId: 'unit-source', provider, evaluate,
+    task: { id: 'train-source-1', family: 'line_item_refund', prompt: 'Repair line-item refund SQL.' },
+    index: 1, cycleId: 'source_only', phase: 'train', arm: 'source', correctSql: 'SELECT 1',
+  });
+  assert.equal(captured.length, 1);
+  assert.equal(captured[0].role, 'builder');
+  assert.ok(result.episode);
+  assert.equal(result.episode!.correctSql, 'SELECT 1');
+  assert.equal(result.episode!.sql, 'SELECT 1');
+  assert.equal(result.learnedId, null);
+  assert.equal(result.lessonOutcome, null);
+  assert.equal(storage.listKnowledge('sql_source_closeout').length, 0);
+  const runs = storage.listAgentRuns('source_only');
+  assert.equal(runs.length, 5);
+  assert.deepEqual(runs.map(run => run.action), [
+    'delegate_sql_repair', 'submit_sql', 'execute_sql_and_compare_python_reference',
+    'source_episode_no_distillation', 'source_episode_no_knowledge_write',
+  ]);
+  assert.equal(storage.listLlmCalls().filter(call => call.cycleId === 'source_only').length, 1);
+});
