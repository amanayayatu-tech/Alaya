+            ("event_id", "INTEGER"),
+            ("person_id", "INTEGER"),
+            ("event_type", "TEXT"),
+            ("event_time", "TEXT"),
+            ("channel", "TEXT"),
+        ),
+    }
+    start_day = 10 + (index % 3)
+    start = _iso(start_day, 0)
+    end = _iso(start_day + 2, 0)
+    require_channel, include_end, strict_order, purchase_requires_cart = _variant_bits(split, index)
+    end_op = "<=" if include_end else "<"
+    stage_op = ">" if strict_order else ">="
+    channel_clause = " AND channel = 'web'" if require_channel else ""
+    channel_clause_e = " AND e.channel = 'web'" if require_channel else ""
+    scenario = {
+        "start": start,
+        "end": end,
+        "requireWeb": require_channel,
+        "includeEnd": include_end,
+        "strictOrder": strict_order,
+        "purchaseRequiresCart": purchase_requires_cart,
+        "variantBits": [require_channel, include_end, strict_order, purchase_requires_cart],
+    }
+
+    def make_fixture(fixture_index: int) -> Dict[str, Any]:
+        rng = _rng_for(split, 2, index, fixture_index)
+        people_rows = [[i, f"person-{token}-{i}"] for i in range(1, 7)]
+        events_rows: List[List[Any]] = [
+            [9001, 1, "view", _iso(start_day, 8), "web"],
+            [9002, 1, "view", _iso(start_day, 8, 30), "web"],
+            [9003, 1, "add_to_cart", _iso(start_day, 9), "web"],
+            [9004, 1, "purchase", _iso(start_day, 10), "web"],
+            [9005, 2, "purchase", _iso(start_day, 8), "web"],
+            [9006, 2, "add_to_cart", _iso(start_day, 9), "web"],
+            [9007, 2, "view", _iso(start_day, 10), "web"],
+            [9008, 3, "view", _iso(start_day, 11, 59), "web"],
+            [9009, 3, "add_to_cart", end, "web"],
+            [9010, 3, "purchase", _iso(start_day + 2, 0), "web"],
+            [9011, 4, "view", _iso(start_day, 7), "web"],
+            [9012, 4, "add_to_cart", _iso(start_day, 8), "web"],
+            [9013, 4, "purchase", _iso(start_day, 8), "web"],
+            [9014, 4, "purchase", _iso(start_day, 8, 1), "web"],
+            [9015, 5, "view", _iso(start_day - 1, 23), "web"],
+            [9016, 5, "add_to_cart", _iso(start_day, 1), "web"],
+            [9017, 5, "purchase", _iso(start_day, 2), "web"],
+            [9018, 6, "view", _iso(start_day, 6), "app"],
+            [9019, 6, "add_to_cart", _iso(start_day, 7), "app"],
+            [9020, 6, "purchase", _iso(start_day, 8), "app"],
+        ]
+        event_types = ["view", "add_to_cart", "purchase", "other"]
+        next_event = 10000 + fixture_index * 100
+        for _ in range(8 + fixture_index):
+            person_id = rng.choice([1, 2, 3, 4, 5, 6])
+            day = rng.choice([start_day - 1, start_day, start_day + 1, start_day + 2, start_day + 3])
+            hour = rng.choice([0, 6, 12, 18, 23])
+            events_rows.append([next_event, person_id, rng.choice(event_types), _iso(day, hour), rng.choice(["web", "app"])])
+            next_event += 1
+        return {people: people_rows, events: events_rows}
+
+    fixtures = [make_fixture(i) for i in range(FIXTURE_COUNT)]
+    purchase_source = "first_cart c" if purchase_requires_cart else "first_view v"
+    purchase_alias = "c" if purchase_requires_cart else "v"
+    purchase_column = "c.cart_at" if purchase_requires_cart else "v.view_at"
+    gold = f"""WITH first_view AS (
+  SELECT person_id, MIN(event_time) AS view_at
+  FROM {events}
+  WHERE event_type = 'view' AND event_time >= {_q(start)} AND event_time {end_op} {_q(end)}{channel_clause}
+  GROUP BY person_id
+), first_cart AS (
+  SELECT e.person_id, MIN(e.event_time) AS cart_at
+  FROM {events} e JOIN first_view v ON v.person_id = e.person_id
+  WHERE e.event_type = 'add_to_cart' AND e.event_time {stage_op} v.view_at AND e.event_time {end_op} {_q(end)}{channel_clause_e}
+  GROUP BY e.person_id
+), first_purchase AS (
+  SELECT e.person_id, MIN(e.event_time) AS purchase_at
+  FROM {events} e JOIN {purchase_source} ON {purchase_alias}.person_id = e.person_id
+  WHERE e.event_type = 'purchase' AND e.event_time {stage_op} {purchase_column} AND e.event_time {end_op} {_q(end)}{channel_clause_e}
+  GROUP BY e.person_id
+)
+SELECT p.person_id, v.view_at, c.cart_at, x.purchase_at,
+       CASE WHEN x.person_id IS NULL THEN 0 ELSE 1 END AS converted
+FROM {people} p
+LEFT JOIN first_view v ON v.person_id = p.person_id
+LEFT JOIN first_cart c ON c.person_id = p.person_id
+LEFT JOIN first_purchase x ON x.person_id = p.person_id
+ORDER BY p.person_id"""
+    # The single seeded defect is selecting the last view instead of the first;
+    # all four public rule switches remain otherwise correctly represented.
+    buggy = gold.replace("MIN(event_time) AS view_at", "MAX(event_time) AS view_at", 1)
+    prompt = f"""Task: repair one read-only SQLite query.
+
+Schema:
+{_schema_text(table_defs)}
+
+Business contract:
+- The funnel window is {'closed at the end' if include_end else 'half-open'}: event_time >= {_q(start)} and event_time {end_op} {_q(end)}.
+- {"Only channel = 'web' events count." if require_channel else "Events from both channels count."}
+- For every person, return the first in-window view, then the first add_to_cart using event_time {stage_op} the view, then the first purchase using event_time {stage_op} {"the cart" if purchase_requires_cart else "the view"}. A stage is NULL when no qualifying event exists.
+- A person is converted {"only if all three stages exist" if purchase_requires_cart else "if a view and an admissible purchase exist; cart_at may be NULL"}. Duplicate events must not duplicate the person.
+- Return one row per person, in person_id order, with columns exactly: person_id, view_at, cart_at, purchase_at, converted.
+- event_time is ISO-8601 UTC text and all ordering/boundary rules above are public task rules.
+
+Buggy SQL (it runs, but may violate the contract):
+```sql
+{buggy}
+```
+
+Return exactly one read-only SELECT or WITH query. Do not rely on fixture values.
+"""
+    private = {
+        "schemaVersion": SCHEMA_VERSION,
+        "family": "funnel",
+        "tableRoles": {"people": people, "events": events},
+        "schemaSql": _schema_text(table_defs),
+        "tableDefs": {table: [[name, ctype] for name, ctype in cols] for table, cols in table_defs.items()},
+        "fixtures": [{"name": f"fixture-{i}", "tables": _table_payload(table_defs, tables)} for i, tables in enumerate(fixtures)],
+        "goldSql": gold,
+        "oracleSpec": scenario,
+    }
+    return {"id": f"{split}-funnel-{index:02d}", "family": "funnel", "prompt": prompt, "private": private}
+
+
+def generate_case(split: str, family: str, index: int) -> Dict[str, Any]:
+    if family == "aggregation":
+        return _agg_case(split, index)
+    if family == "latest_status":
+        return _latest_case(split, index)
+    if family == "funnel":
+        return _funnel_case(split, index)
+    raise ValueError(f"unknown family: {family}")
+
+
+def generate_dataset() -> Dict[str, List[Dict[str, Any]]]:
+    return {
+        split: [
+            generate_case(split, family, index)
+            for family in FAMILIES
+            for index in range(SPLIT_COUNTS[split])
+        ]
+        for split in ("dev", "train", "test")
+    }
+
+
+def _fixture_rows(private: Mapping[str, Any], fixture: Mapping[str, Any]) -> Mapping[str, Sequence[Sequence[Any]]]:
+    return {table: data["rows"] for table, data in fixture["tables"].items()}
+
+
+def _rows_from_table(private: Mapping[str, Any], fixture: Mapping[str, Any], table: str) -> List[List[Any]]:
+    return [list(row) for row in fixture["tables"][table]["rows"]]
+
+
+def _agg_reference(case: Mapping[str, Any], fixture: Mapping[str, Any]) -> Tuple[List[str], List[List[Any]]]:
+    private = case["private"]
+    spec = private["oracleSpec"]
+    roles = private["tableRoles"]
+    accounts, orders, refunds = roles["accounts"], roles["orders"], roles["refunds"]
+    account_rows = _rows_from_table(private, fixture, accounts)
+    order_rows = _rows_from_table(private, fixture, orders)
+    refund_rows = _rows_from_table(private, fixture, refunds)
+    status_set = set(spec["qualifyingStatuses"])
+    currency_set = set(spec["currencies"])
+    account_ids = [row[0] for row in account_rows if row[2] == spec["region"]]
+    result: List[List[Any]] = []
+    for account_id in account_ids:
+        qualifying = [
+            row for row in order_rows
+            if row[1] == account_id
+            and row[2] in status_set
+            and row[3] in currency_set
+            and (spec["includeZeroGross"] or int(row[4]) != 0)
+        ]
+        refunds_by_order: Dict[int, int] = {}
+        for row in refund_rows:
+            if row[2] == spec["refundStatus"]:
+                refunds_by_order[row[1]] = refunds_by_order.get(row[1], 0) + int(row[3])
+        if spec["refundedOnly"]:
+            qualifying = [
+                row for row in qualifying
+                if int(row[0]) in refunds_by_order
+            ]
+        if not spec["includeEmpty"] and not qualifying:
+            continue
+        gross = sum(int(row[4]) for row in qualifying)
+        refund = sum(
+            min(refunds_by_order.get(int(row[0]), 0), int(row[4])) if spec["capRefund"]
+            else refunds_by_order.get(int(row[0]), 0)
+            for row in qualifying
+        )
+        rate = None if gross == 0 else float((Decimal(refund) * 100 / Decimal(gross)).quantize(Decimal("0.000001"), rounding=ROUND_HALF_UP))
+        result.append([account_id, len(qualifying), gross, refund, gross - refund, rate])
+    return ["account_id", "paid_order_count", "gross_cents", "refund_cents", "net_cents", "refund_rate_pct"], result
+
+
+def _latest_reference(case: Mapping[str, Any], fixture: Mapping[str, Any]) -> Tuple[List[str], List[List[Any]]]:
+    private = case["private"]
+    spec = private["oracleSpec"]
+    roles = private["tableRoles"]
+    entities, events = roles["entities"], roles["events"]
+    entity_rows = _rows_from_table(private, fixture, entities)
+    event_rows = _rows_from_table(private, fixture, events)
+    result: List[List[Any]] = []
+    for entity_id, _name, is_active in entity_rows:
+        if spec["activeOnly"] and int(is_active) != 1:
+            continue
+        eligible = [
+            row for row in event_rows
+            if row[1] == entity_id
+            and (row[2] <= spec["cutoff"] if spec["includeEqualCutoff"] else row[2] < spec["cutoff"])
+            and (not spec["filterStatuses"] or row[4] in set(spec["eligibleStatuses"]))
+        ]
+        if spec["highSeqWins"]:
+            eligible.sort(key=lambda row: (row[2], int(row[3]), int(row[0])), reverse=True)
+        else:
+            eligible.sort(key=lambda row: (row[2], -int(row[3]), int(row[0])), reverse=True)
+        if eligible:
+            row = eligible[0]
+            result.append([entity_id, row[4], row[2], row[3]])
+        else:
+            result.append([entity_id, None, None, None])
+    return ["entity_id", "status", "event_time", "seq"], result
+
+
+def _funnel_reference(case: Mapping[str, Any], fixture: Mapping[str, Any]) -> Tuple[List[str], List[List[Any]]]:
+    private = case["private"]
+    spec = private["oracleSpec"]
+    roles = private["tableRoles"]
+    people, events = roles["people"], roles["events"]
+    people_rows = _rows_from_table(private, fixture, people)
+    event_rows = _rows_from_table(private, fixture, events)
+
+    def first_after(person_id: int, event_type: str, lower: str | None) -> str | None:
+        def after_ok(value: str) -> bool:
+            if lower is None:
+                return True
+            return value > lower if spec["strictOrder"] else value >= lower
+
+        def end_ok(value: str) -> bool:
+            return value <= spec["end"] if spec["includeEnd"] else value < spec["end"]
+
+        candidates = [
+            row[3]
+            for row in event_rows
+            if row[1] == person_id
+            and row[2] == event_type
+            and row[3] >= spec["start"]
+            and end_ok(row[3])
+            and (not spec["requireWeb"] or row[4] == "web")
+            and after_ok(row[3])
+        ]
+        return min(candidates) if candidates else None
+
+    result: List[List[Any]] = []
+    for person_id, _name in people_rows:
+        view = first_after(person_id, "view", None)
+        cart = first_after(person_id, "add_to_cart", view) if view else None
+        purchase_lower = cart if spec["purchaseRequiresCart"] else view
+        purchase = (
+            first_after(person_id, "purchase", purchase_lower)
+            if purchase_lower is not None and (not spec["purchaseRequiresCart"] or cart is not None)
+            else None
+        )
+        result.append([person_id, view, cart, purchase, 1 if purchase else 0])
+    return ["person_id", "view_at", "cart_at", "purchase_at", "converted"], result
+
+
+REFERENCE_BY_FAMILY: Dict[str, Callable[[Mapping[str, Any], Mapping[str, Any]], Tuple[List[str], List[List[Any]]]]] = {
+    "aggregation": _agg_reference,
+    "latest_status": _latest_reference,
+    "funnel": _funnel_reference,
+}
+
+
+def reference_result(case: Mapping[str, Any], fixture: Mapping[str, Any]) -> Tuple[List[str], List[List[Any]]]:
+    family = case.get("family")
+    if family not in REFERENCE_BY_FAMILY:
+        raise ValueError(f"unknown case family: {family}")
+    return REFERENCE_BY_FAMILY[family](case, fixture)
+
+
+def evaluate_case(case: Mapping[str, Any], sql: Any) -> Dict[str, Any]:
+    private = case.get("private")
+    if not isinstance(private, Mapping):
+        return {"passed": False, "checks": 0, "passedChecks": 0, "error": "missing private case data"}
+    try:
+        text = _validate_select(sql)
+    except Exception as exc:  # noqa: BLE001 - CLI must return structured errors.
+        return {"passed": False, "checks": 0, "passedChecks": 0, "error": str(exc)}
+    table_defs = {
+        table: [(str(pair[0]), str(pair[1])) for pair in columns]
+        for table, columns in private["tableDefs"].items()
+    }
+    fixtures = private.get("fixtures", [])
+    checks = len(fixtures)
+    passed_checks = 0
+    first_counterexample: Dict[str, Any] | None = None
+    first_error: str | None = None
+    for fixture in fixtures:
+        name = fixture.get("name", f"fixture-{passed_checks}")
+        expected_columns, expected_rows = reference_result(case, fixture)
+        try:
+            actual_columns, actual_rows = _execute_candidate(table_defs, _fixture_rows(private, fixture), text)
+        except Exception as exc:  # noqa: BLE001 - returned as evaluator feedback.
+            if first_error is None:
+                first_error = str(exc)
+                first_counterexample = {"fixture": name, "reason": "execution_error"}
+            continue
+        if _rows_equal(actual_columns, actual_rows, expected_columns, expected_rows):
+            passed_checks += 1
+            continue
+        if first_counterexample is None:
+            first_counterexample = {
+                "fixture": name,
+                "reason": "result_mismatch",
+                "actualColumns": actual_columns,
+                "expectedColumns": expected_columns,
+                "actualRowCount": len(actual_rows),
+                "expectedRowCount": len(expected_rows),
+            }
+    output: Dict[str, Any] = {
+        "passed": passed_checks == checks and checks > 0,
+        "checks": checks,
+        "passedChecks": passed_checks,
+    }
+    if first_error is not None:
+        output["error"] = first_error
+    if first_counterexample is not None:
+        output["counterexample"] = first_counterexample
+    return output
+
+
+def _assert(condition: bool, message: str) -> None:
+    if not condition:
+        raise AssertionError(message)
+
+
+def self_test() -> Dict[str, Any]:
+    dataset = generate_dataset()
+    _assert(set(dataset) == {"dev", "train", "test"}, "split keys")
+    _assert([len(dataset[key]) for key in ("dev", "train", "test")] == [6, 24, 24], "split counts")
+    all_cases = [case for cases in dataset.values() for case in cases]
+    _assert(len({case["id"] for case in all_cases}) == len(all_cases), "unique IDs")
+
+    train_prompt = {case["prompt"] for case in dataset["train"]}
+    test_prompt = {case["prompt"] for case in dataset["test"]}
+    _assert(train_prompt.isdisjoint(test_prompt), "train/test prompt overlap")
+    train_tables = {
+        table
+        for case in dataset["train"]
+        for table in case["private"]["tableDefs"]
+    }
+    test_tables = {
+        table
+        for case in dataset["test"]
+        for table in case["private"]["tableDefs"]
+    }
+    _assert(train_tables.isdisjoint(test_tables), "train/test schema names overlap")
+
+    family_counts = {family: sum(case["family"] == family for case in dataset["test"]) for family in FAMILIES}
+    _assert(family_counts == {family: SPLIT_COUNTS["test"] for family in FAMILIES}, "family counts")
+    for family in FAMILIES:
+        train_bits = {
+            tuple(case["private"]["oracleSpec"]["variantBits"])
+            for case in dataset["train"]
+            if case["family"] == family
+        }
+        test_bits = {
+            tuple(case["private"]["oracleSpec"]["variantBits"])
+            for case in dataset["test"]
+            if case["family"] == family
+        }
+        _assert(train_bits.isdisjoint(test_bits), f"variant combination overlap: {family}")
+        for bit in range(4):
+            _assert(any(bits[bit] for bits in train_bits), f"train never sees bit {bit}: {family}")
+            _assert(any(not bits[bit] for bits in train_bits), f"train never sees false bit {bit}: {family}")
+            _assert(any(bits[bit] for bits in test_bits), f"test never sees bit {bit}: {family}")
+            _assert(any(not bits[bit] for bits in test_bits), f"test never sees false bit {bit}: {family}")
+
+    for case in all_cases:
+        private = case["private"]
+        table_defs = {
+            table: [(str(pair[0]), str(pair[1])) for pair in columns]
+            for table, columns in private["tableDefs"].items()
+        }
+        gold_result = evaluate_case(case, private["goldSql"])
+        _assert(gold_result["passed"], f"gold SQL failed: {case['id']} {gold_result}")
+        buggy = re.search(r"Buggy SQL \(it runs, but may violate the contract\):\n```sql\n(.*?)\n```", case["prompt"], re.S)
+        _assert(buggy is not None, f"buggy SQL missing: {case['id']}")
+        buggy_result = evaluate_case(case, buggy.group(1))
+        _assert(not buggy_result["passed"], f"buggy SQL unexpectedly passed: {case['id']}")
+        _assert(buggy_result["passedChecks"] < buggy_result["checks"], f"buggy SQL did not fail a check: {case['id']}")
+        _assert("correct" not in case["prompt"].lower().split("buggy sql", 1)[0], f"answer hint in prompt: {case['id']}")
+        _assert(private["goldSql"] not in case["prompt"], f"gold SQL leaked: {case['id']}")
+        _assert(table_defs, f"empty schema: {case['id']}")
+
+    # Exercise the actual JSON CLI representation: sort_keys changes table
+    # dictionary order, so references must use tableRoles rather than order.
+    roundtrip = json.loads(_json(dataset))
+    for split_cases in roundtrip.values():
+        for case in split_cases:
+            result = evaluate_case(case, case["private"]["goldSql"])
+            _assert(result["passed"], f"JSON roundtrip gold failed: {case['id']} {result}")
+
+    # Regression for an oracle disagreement found by independent review:
+    # Python round(0.1953125, 6) uses ties-to-even; SQLite ROUND uses away-from-zero.
+    rounding_case = json.loads(_json(dataset["train"][0]))
+    priv = rounding_case["private"]
+    a, o, r = [priv["tableRoles"][role] for role in ("accounts", "orders", "refunds")]
+    spec = priv["oracleSpec"]
+    tables = {a: [[1, "rounding-case", spec["region"]]],
+              o: [[1, 1, spec["qualifyingStatuses"][0], spec["currencies"][0], 512]],
+              r: [[1, 1, "posted", 1]]}
+    fixture = {"name": "round-half-away", "tables": _table_payload(priv["tableDefs"], tables)}
+    priv["fixtures"] = [fixture]
+    _assert(reference_result(rounding_case, fixture)[1][0][-1] == 0.195313, "rounding policy")
+    _assert(evaluate_case(rounding_case, priv["goldSql"])["passed"], "SQLite/Python rounding parity")
+
+    sample = dataset["test"][0]
+    write_result = evaluate_case(sample, "DROP TABLE anything")
+    _assert(write_result["passed"] is False and write_result["checks"] == 0, "write rejection")
+    for dangerous in (
+        "SELECT load_extension('x')",
+        "SELECT readfile('/tmp/nope')",
+        "SELECT writefile('/tmp/nope', 'x')",
+        "SELECT randomblob(2000000)",
+    ):
+        result = evaluate_case(sample, dangerous)
+        _assert(not result["passed"], f"dangerous query passed: {dangerous}")
+    return {"ok": True, "cases": len(all_cases), "splits": {key: len(value) for key, value in dataset.items()}}
+
+
+def _usage() -> str:
+    return "usage: sql-repair-cases.py generate | evaluate | --self-test"
+
+
+def main(argv: Sequence[str]) -> int:
+    if argv == ["--self-test"]:
+        print(_json(self_test()))
+        return 0
+    if len(argv) != 1 or argv[0] not in {"generate", "evaluate"}:
+        print(_usage(), file=sys.stderr)
+        return 2
+    if argv[0] == "generate":
+        print(_json(generate_dataset()))
+        return 0
+    try:
+        payload = json.load(sys.stdin)
+        case = payload["case"]
+        sql = payload.get("sql")
+        result = evaluate_case(case, sql)
+    except Exception as exc:  # noqa: BLE001 - CLI contract remains JSON.
+        result = {"passed": False, "checks": 0, "passedChecks": 0, "error": str(exc)}
+    print(_json(result))
+    return 0
+
+
+if __name__ == "__main__":
+    raise SystemExit(main(sys.argv[1:]))
