+#!/usr/bin/env python3
+"""Deterministic SQLite query-repair cases and an independent evaluator.
+
+The generator has no model, network, or third-party dependency.  It emits
+small cases whose expected result is calculated by Python business logic.  A
+gold SQL query is retained as a secondary self-check, but is not the oracle.
+"""
+
+from __future__ import annotations
+
+import json
+from decimal import Decimal, ROUND_HALF_UP
+import math
+import random
+import re
+import sqlite3
+import sys
+import time
+from pathlib import Path
+from typing import Any, Callable, Dict, Iterable, List, Mapping, Sequence, Tuple
+
+
+SCHEMA_VERSION = "sql-repair-cases-v1"
+SPLIT_COUNTS = {"train": 8, "dev": 2, "test": 8}
+FAMILIES = ("aggregation", "latest_status", "funnel")
+FIXTURE_COUNT = 4
+QUERY_TIMEOUT_SECONDS = 0.35
+MAX_RESULT_ROWS = 5000
+
+
+def _json(value: Any) -> str:
+    return json.dumps(value, ensure_ascii=False, sort_keys=True, separators=(",", ":"))
+
+
+def _q(value: str) -> str:
+    return "'" + value.replace("'", "''") + "'"
+
+
+def _ident(value: str) -> str:
+    if not re.fullmatch(r"[A-Za-z_][A-Za-z0-9_]*", value):
+        raise ValueError(f"unsafe identifier: {value}")
+    return value
+
+
+def _prefix(split: str) -> str:
+    return {"train": "tr", "dev": "dv", "test": "te"}[split]
+
+
+def _iso(day: int, hour: int = 0, minute: int = 0) -> str:
+    # 2025-01-01 plus a small deterministic offset.  All generated values are
+    # ISO text, which is a declared task rule rather than a hidden assumption.
+    base = 1735689600 + day * 86400 + hour * 3600 + minute * 60
+    return time.strftime("%Y-%m-%d %H:%M:%S", time.gmtime(base))
+
+
+def _schema_text(table_defs: Mapping[str, Sequence[Tuple[str, str]]]) -> str:
+    statements: List[str] = []
+    for table, columns in table_defs.items():
+        cols = ", ".join(f"{_ident(name)} {ctype} NOT NULL" for name, ctype in columns)
+        statements.append(f"CREATE TABLE {_ident(table)} ({cols});")
+    return "\n".join(statements)
+
+
+def _setup_database(
+    table_defs: Mapping[str, Sequence[Tuple[str, str]]],
+    fixture_tables: Mapping[str, Sequence[Sequence[Any]]],
+) -> sqlite3.Connection:
+    conn = sqlite3.connect(":memory:")
+    conn.execute("PRAGMA query_only = OFF")
+    conn.executescript(_schema_text(table_defs))
+    for table, columns in table_defs.items():
+        rows = fixture_tables.get(table, ())
+        placeholders = ",".join("?" for _ in columns)
+        conn.executemany(
+            f"INSERT INTO {_ident(table)} VALUES ({placeholders})",
+            [tuple(row) for row in rows],
+        )
+    conn.commit()
+    return conn
+
+
+def _table_payload(
+    table_defs: Mapping[str, Sequence[Tuple[str, str]]],
+    fixture_tables: Mapping[str, Sequence[Sequence[Any]]],
+) -> Dict[str, Any]:
+    return {
+        table: {
+            "columns": [name for name, _ in columns],
+            "rows": [list(row) for row in fixture_tables.get(table, ())],
+        }
+        for table, columns in table_defs.items()
+    }
+
+
+def _numeric_equal(left: Any, right: Any) -> bool:
+    if isinstance(left, bool) or isinstance(right, bool):
+        return left == right
+    if isinstance(left, (int, float)) and isinstance(right, (int, float)):
+        return math.isclose(float(left), float(right), rel_tol=1e-9, abs_tol=1e-7)
+    return False
+
+
+def _value_equal(left: Any, right: Any) -> bool:
+    if left is None or right is None:
+        return left is None and right is None
+    if _numeric_equal(left, right):
+        return True
+    return left == right
+
+
+def _rows_equal(
+    actual_columns: Sequence[str],
+    actual_rows: Sequence[Sequence[Any]],
+    expected_columns: Sequence[str],
+    expected_rows: Sequence[Sequence[Any]],
+) -> bool:
+    if list(actual_columns) != list(expected_columns):
+        return False
+    if len(actual_rows) != len(expected_rows):
+        return False
+    return all(
+        len(actual) == len(expected)
+        and all(_value_equal(a, e) for a, e in zip(actual, expected))
+        for actual, expected in zip(actual_rows, expected_rows)
+    )
+
+
+def _canonical_rows(rows: Iterable[Sequence[Any]]) -> List[List[Any]]:
+    result: List[List[Any]] = []
+    for row in rows:
+        result.append([value for value in row])
+    return result
+
+
+def _insert_fixture(
+    table_defs: Mapping[str, Sequence[Tuple[str, str]]],
+    fixture_tables: Mapping[str, Sequence[Sequence[Any]]],
+) -> sqlite3.Connection:
+    return _setup_database(table_defs, fixture_tables)
+
+
+_ALLOWED_READ_ACTIONS = {
+    sqlite3.SQLITE_SELECT,
+    sqlite3.SQLITE_READ,
+    sqlite3.SQLITE_FUNCTION,
+}
+if hasattr(sqlite3, "SQLITE_RECURSIVE"):
+    _ALLOWED_READ_ACTIONS.add(sqlite3.SQLITE_RECURSIVE)
+_BLOCKED_FUNCTIONS = {"load_extension", "readfile", "writefile"}
+
+
+def _query_only_authorizer(action: int, _p1: str | None, p2: str | None, _db: str | None, _trigger: str | None) -> int:
+    """Allow only read operations; unknown SQLite authorizer actions deny."""
+    if action not in _ALLOWED_READ_ACTIONS:
+        return sqlite3.SQLITE_DENY
+    if action == sqlite3.SQLITE_FUNCTION and (p2 or "").lower() in _BLOCKED_FUNCTIONS:
+        return sqlite3.SQLITE_DENY
+    return sqlite3.SQLITE_OK
+
+
+def _set_connection_limits(conn: sqlite3.Connection) -> None:
+    # Keep malicious scalar functions and giant SQL expressions bounded even
+    # when the caller wraps this script in a generous subprocess timeout.
+    limits = {
+        "SQLITE_LIMIT_LENGTH": 1_000_000,
+        "SQLITE_LIMIT_SQL_LENGTH": 20_000,
+        "SQLITE_LIMIT_COLUMN": 200,
+        "SQLITE_LIMIT_EXPR_DEPTH": 1_000,
+        "SQLITE_LIMIT_VDBE_OP": 200_000,
+    }
+    for name, value in limits.items():
+        category = getattr(sqlite3, name, None)
+        if category is not None and hasattr(conn, "setlimit"):
+            conn.setlimit(category, value)
+
+
+def _validate_select(sql: Any) -> str:
+    if not isinstance(sql, str) or not sql.strip():
+        raise ValueError("sql must be a non-empty string")
+    text = sql.strip()
+    if text.endswith(";"):
+        text = text[:-1].rstrip()
+    if ";" in text:
+        raise ValueError("multiple statements are not allowed")
+    first = re.match(r"(?is)^([a-z]+)", text)
+    if first is None or first.group(1).lower() not in {"select", "with"}:
+        raise ValueError("only SELECT or WITH queries are allowed")
+    if re.search(r"(?is)\b(load_extension|readfile|writefile|attach|detach|pragma|vacuum)\b", text):
+        raise ValueError("restricted SQLite operation")
+    return text
+
+
+def _execute_candidate(
+    table_defs: Mapping[str, Sequence[Tuple[str, str]]],
+    fixture_tables: Mapping[str, Sequence[Sequence[Any]]],
+    sql: str,
+) -> Tuple[List[str], List[List[Any]]]:
+    text = _validate_select(sql)
+    conn = _insert_fixture(table_defs, fixture_tables)
+    try:
+        _set_connection_limits(conn)
+        conn.execute("PRAGMA query_only = ON")
+        conn.set_authorizer(_query_only_authorizer)
+        deadline = time.monotonic() + QUERY_TIMEOUT_SECONDS
+        conn.set_progress_handler(
+            lambda: 1 if time.monotonic() > deadline else 0,
+            1000,
+        )
+        cursor = conn.execute(text)
+        description = cursor.description or ()
+        columns = [item[0] for item in description]
+        rows = cursor.fetchmany(MAX_RESULT_ROWS + 1)
+        if len(rows) > MAX_RESULT_ROWS:
+            raise RuntimeError("result row limit exceeded")
+        return columns, _canonical_rows(rows)
+    finally:
+        conn.close()
+
+
+def _fixture(table_payload: Mapping[str, Mapping[str, Any]], name: str) -> Dict[str, Any]:
+    return {"name": name, "tables": {table: data["rows"] for table, data in table_payload.items()}}
