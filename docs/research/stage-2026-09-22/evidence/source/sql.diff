+def _parity_bits(split: str, index: int) -> Tuple[bool, bool, bool, bool]:
+    parity = 0 if split == "train" else 1
+    patterns = [
+        tuple(bool((mask >> bit) & 1) for bit in range(4))
+        for mask in range(16)
+        if (mask.bit_count() % 2) == parity
+    ]
+    if index >= len(patterns):
+        raise ValueError(f"no parity pattern for {split} index {index}")
+    return patterns[index]  # type: ignore[return-value]
+
+
+def _usd_cents(amount_cents: int, usd_micros: int) -> int:
+    return int((Decimal(amount_cents) * Decimal(usd_micros) / Decimal(1_000_000)).quantize(Decimal("1"), rounding=ROUND_HALF_UP))
+
