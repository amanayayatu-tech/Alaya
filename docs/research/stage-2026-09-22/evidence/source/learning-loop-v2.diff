+  const invalidRows = structuredClone(rows);
+  invalidRows[0].jointPropensity = 0.5;
+  const invalid = evaluateLearningLoopV2Ope({
+    rows: invalidRows,
+    target: { kind: "inject-one-item", itemId: "item_a" },
+  });
+  assert.equal(invalid.denominators.invalid, 1);
+  assert.equal(invalid.status, "FAIL");
+  const unsupported = evaluateLearningLoopV2Ope({
+    rows,
+    target: { kind: "inject-one-item", itemId: "item_c" },
+  });
+  assert.equal(unsupported.status, "OPE_NOT_IDENTIFIED");
+  assert.equal(unsupported.reason, "NO_SUPPORT");
+  assert.equal(unsupported.unsupportedMass, 1);
+  assert.equal(unsupported.meetsFrozenStatisticalThresholds, false);
+  const corrupt = structuredClone(rows);
+  corrupt[0].propensityVector = [0.5, 0.5, 0.5];
+  assert.throws(() => evaluateLearningLoopV2Ope({
+    rows: corrupt,
+    target: { kind: "inject-one-item", itemId: "item_a" },
+  }), (error: unknown) => error instanceof LearningLoopV2InvariantError && error.code === "CORRUPT_PROPENSITY");
+});
