+  pushCheck(gate_checks, invalid_records, "forbidden_patterns_named", missingForbidden.length === 0, missingForbidden.length === 0 ? "forbidden patterns named" : missingForbidden.join(","), "g1-forbidden", "forbidden-pattern-unspecified");
+  pushCheck(gate_checks, invalid_records, "gate_milestones", missingMilestones.length === 0, missingMilestones.length === 0 ? "canonical gate-to-milestone mapping present" : missingMilestones.map((row) => row.milestone).join(","), "docs/ai/ADR_LEARNING_LOOP_V2.md", "gate-milestone-missing");
+  pushCheck(gate_checks, invalid_records, "claim_ceiling", claimCeilingPresent, CLAIM_CEILING, "g1-claim-ceiling", "claim-ceiling-missing");
+
+  const gitIdentity = {
+    root: git(root, ["rev-parse", "--show-toplevel"]),
+    branch: git(root, ["rev-parse", "--abbrev-ref", "HEAD"]),
+    head: git(root, ["rev-parse", "HEAD"]),
+    base: git(root, ["rev-parse", "HEAD"]),
+  };
+  if (!gitIdentity.root || !gitIdentity.head) {
+    invalid_records.push({ path: "git", reason: "git-identity-unavailable" });
+  }
+
+  const approved_scope = { before, after, six_file_diff_digest: sixFileDiffDigest };
+  const inputManifest = {
+    files: LEARNING_LOOP_V2_G1_FILES,
+    sha256,
+    git: gitIdentity,
+    v1,
+    claim_ceiling: CLAIM_CEILING,
+    approved_scope,
+  };
+  const exclusions = CONTROLLER_PACKS.filter((path) => existsSync(join(root, path))).map((path) => ({
+    path,
+    reason: "controller-pack",
+  }));
+  const uniqueInvalid = [...new Map(invalid_records.map((item) => [item.path + ":" + item.reason, item])).values()];
+  const status = uniqueInvalid.length === 0 ? "REVIEW_READY" as const : "MANIFEST_INVALID" as const;
+  const body = {
+    contract_id: CONTRACT_ID,
+    profile: "G1_STATIC_FORMALIZATION" as const,
+    status,
+    gate: 1 as const,
+    experiment_id: EXPERIMENT_ID,
+    experiment_version: EXPERIMENT_VERSION,
+    run_id: "NOT_APPLICABLE",
+    input_manifest_digest: "sha256:" + sha256Bytes(canonical(inputManifest)),
+    event_range: { stream_id: "NOT_APPLICABLE", first: 0, last: 0, count: 0 },
+    denominators: {},
+    metrics: {},
+    invalid_records: uniqueInvalid,
+    exclusions,
+    support_diagnostics: {},
+    gate_checks,
+    claim_ceiling: CLAIM_CEILING,
+    reviewer_attestation: null,
+    candidate: true,
+    approved_scope,
+    git: gitIdentity,
+    oracle: "NOT_APPLICABLE",
+    policy_checkpoint: "NOT_APPLICABLE",
+    renderer: "NOT_APPLICABLE",
+    provider: "NOT_APPLICABLE",
+    model: "NOT_APPLICABLE",
+    config: "NOT_APPLICABLE",
+    usage: "NOT_APPLICABLE",
+    held_out: "NOT_APPLICABLE",
+  };
+  return {
+    ...body,
+    evaluator_artifact_digest: "sha256:" + sha256Bytes(readFileSync(EVALUATOR_SOURCE)),
+    digest: "sha256:" + sha256Bytes(canonical(body)),
+  };
+}
