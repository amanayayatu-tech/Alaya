+} as const;
+
+const G1_FILES = [
+  "docs/ai/ADR_LEARNING_LOOP_V2.md",
+  "docs/ai/LEARNING_LOOP_V2_CAUSAL_CONTRACT.md",
+  "docs/ai/LEARNING_LOOP_V2_THREAT_MODEL.md",
