+import test from "node:test";
+import assert from "node:assert/strict";
+import { cpSync, mkdirSync, mkdtempSync, readFileSync, rmSync, writeFileSync } from "node:fs";
+import { tmpdir } from "node:os";
+import { dirname, join } from "node:path";
+import { fileURLToPath } from "node:url";
+import { execFileSync } from "node:child_process";
+
+process.env.ALAYA_DB_PATH = join(mkdtempSync(join(tmpdir(), "alaya-learning-v2-g1-")), "test.db");
+process.env.ALAYA_LLM_PROVIDER = "mock";
+
+const ROOT = join(dirname(fileURLToPath(import.meta.url)), "../..");
+const {
+  LEARNING_LOOP_V2_G1_FILES,
+  LEARNING_LOOP_V2_V1_FREEZE,
+  evaluateLearningLoopV2G1Formalization,
+} = await import("../server/learningLoopV2G1Evaluator.ts");
+
+function git(root: string, args: string[]) {
+  execFileSync("git", args, { cwd: root, encoding: "utf8", stdio: ["ignore", "pipe", "pipe"] });
+}
+
+function copyRel(fromRoot: string, toRoot: string, rel: string) {
+  const dest = join(toRoot, rel);
+  mkdirSync(dirname(dest), { recursive: true });
+  cpSync(join(fromRoot, rel), dest);
+}
+
+function makeFixture() {
+  const root = mkdtempSync(join(tmpdir(), "alaya-g1-eval-"));
+  git(root, ["init"]);
+  git(root, ["config", "user.email", "g1@example.com"]);
+  git(root, ["config", "user.name", "G1 Fixture"]);
+  for (const rel of Object.keys(LEARNING_LOOP_V2_V1_FREEZE)) copyRel(ROOT, root, rel);
+  for (const rel of LEARNING_LOOP_V2_G1_FILES) copyRel(ROOT, root, rel);
+  git(root, ["add", "--", ...Object.keys(LEARNING_LOOP_V2_V1_FREEZE)]);
+  git(root, ["commit", "-m", "freeze"]);
+  return root;
+}
+
+test("G1 static evaluator is a candidate REVIEW_READY and does not self-PASS", () => {
+  const report = evaluateLearningLoopV2G1Formalization();
+  assert.equal(report.status, "REVIEW_READY");
+  assert.notEqual(report.status, "PASS");
+  assert.equal(report.candidate, true);
+  assert.equal(report.reviewer_attestation, null);
+  assert.equal(report.profile, "G1_STATIC_FORMALIZATION");
+  assert.equal(report.run_id, "NOT_APPLICABLE");
+  assert.equal(report.oracle, "NOT_APPLICABLE");
+  assert.equal(report.held_out, "NOT_APPLICABLE");
+  assert.equal(report.claim_ceiling, "local checks");
+  assert.deepEqual(report.invalid_records, []);
+  assert.deepEqual(report.denominators, {});
+  assert.deepEqual(report.metrics, {});
+  assert.equal(report.event_range.stream_id, "NOT_APPLICABLE");
+  assert.equal(report.event_range.count, 0);
+  assert.match(report.digest, /^sha256:[a-f0-9]{64}$/);
+  assert.match(report.evaluator_artifact_digest, /^sha256:[a-f0-9]{64}$/);
+  assert.match(report.approved_scope.six_file_diff_digest, /^sha256:[a-f0-9]{64}$/);
+  for (const rel of LEARNING_LOOP_V2_G1_FILES) {
+    assert.equal(report.approved_scope.before[rel], null);
+    assert.match(report.approved_scope.after[rel] ?? "", /^[a-f0-9]{64}$/);
+  }
+  const src = readFileSync(join(ROOT, "alaya-app/server/learningLoopV2G1Evaluator.ts"), "utf8");
+  assert.equal(src.includes("from \"./llm\""), false);
+  assert.equal(src.includes("from \"./knowledgeInjection\""), false);
+  assert.equal(src.includes("from \"./learningLoopV2ExperienceLedger\""), false);
+  assert.equal(src.includes("from \"./learningLoopV2Ope\""), false);
+  assert.equal(src.includes("from \"./learningLoopV2Simulator\""), false);
+});
+
+test("G1 static evaluator fail-closes missing files, untracked freeze, and version drift", () => {
+  const root = makeFixture();
+  try {
+    const ok = evaluateLearningLoopV2G1Formalization({ root });
+    assert.equal(ok.status, "REVIEW_READY");
+
+    rmSync(join(root, LEARNING_LOOP_V2_G1_FILES[0]));
+    const missing = evaluateLearningLoopV2G1Formalization({ root });
+    assert.equal(missing.status, "MANIFEST_INVALID");
+    assert.ok(missing.invalid_records.some((item) => item.reason === "missing"));
+    copyRel(ROOT, root, LEARNING_LOOP_V2_G1_FILES[0]);
+
+    const freezeRel = Object.keys(LEARNING_LOOP_V2_V1_FREEZE)[0];
+    writeFileSync(join(root, freezeRel), readFileSync(join(root, freezeRel), "utf8") + "\n");
+    const drifted = evaluateLearningLoopV2G1Formalization({ root });
+    assert.equal(drifted.status, "MANIFEST_INVALID");
+    assert.ok(drifted.invalid_records.some((item) => item.reason === "V1_FREEZE_VIOLATION"));
+    copyRel(ROOT, root, freezeRel);
+    git(root, ["checkout", "--", freezeRel]);
+
+    const untrackedRoot = makeFixture();
+    try {
+      git(untrackedRoot, ["rm", "--cached", freezeRel]);
+      git(untrackedRoot, ["commit", "-m", "untrack freeze"]);
+      const untracked = evaluateLearningLoopV2G1Formalization({ root: untrackedRoot });
+      assert.equal(untracked.status, "MANIFEST_INVALID");
+      assert.ok(untracked.invalid_records.some((item) => item.reason === "V1_FREEZE_VIOLATION"));
+    } finally {
+      rmSync(untrackedRoot, { recursive: true, force: true });
+    }
+
+    const adr = join(root, "docs/ai/ADR_LEARNING_LOOP_V2.md");
+    writeFileSync(adr, readFileSync(adr, "utf8").replaceAll("2.1.0", "2.0.0"));
+    const version = evaluateLearningLoopV2G1Formalization({ root });
+    assert.equal(version.status, "MANIFEST_INVALID");
+    assert.ok(version.invalid_records.some((item) => item.reason === "version-not-2.1.0"));
+  } finally {
+    rmSync(root, { recursive: true, force: true });
+  }
+});
