--- /dev/null
+++ b/alaya-app/server/learningLoopV2DryShadow.ts
@@ -0,0 +1,224 @@
+import {
+  LearningLoopV2InvariantError,
+  assertLearningLoopV2ActionBeforeDispatch,
+} from "./learningLoopV2ExperienceLedger";
+import {
+  commitLearningLoopV2BaselineExposure,
+  renderLearningLoopV2BaselineExposure,
+  type LearningLoopV2BaselineManifest,
+} from "./learningLoopV2BaselineExposure";
+import { rawDb, storage } from "./storage";
+import Database from "better-sqlite3";
+import { resolve } from "node:path";
+
+export interface LearningLoopV2ApprovalGrant {
+  subject: string;
+  version: string;
+  nonce: string;
+  principal: string;
+  revoked?: boolean;
+}
+
+export interface LearningLoopV2DryShadowReport {
+  providerAuthorization: 0;
+  providerStart: 0;
+  productMutation: 0;
+  creditWrite: 0;
+  heldOutWrite: 0;
+  loggingCompleteness: 1;
+  realSideEffectAllowed: false;
+  requestDigest: string;
+  grantConsumed: boolean;
+}
+
+function heldOutPathFrom(learnerDbPath: string): string {
+  return learnerDbPath.endsWith(".db") ? learnerDbPath.slice(0, -3) + ".heldout.db" : learnerDbPath + ".heldout.db";
+}
+
+const heldOutHandles = new Map<string, Database.Database>();
+
+function openHeldOutDb(dbPath: string): Database.Database {
+  const existing = heldOutHandles.get(dbPath);
+  if (existing) return existing;
+  const db = new Database(dbPath);
+  db.pragma("query_only = ON");
+  heldOutHandles.set(dbPath, db);
+  return db;
+}
+
+export function issueLearningLoopV2ProviderCredential(_manifestDigest: string): never {
+  throw new LearningLoopV2InvariantError(
+    "CREDENTIAL_REFUSED",
+    "Gates 1-7 never issue real provider credentials",
+  );
+}
+
+export function startLearningLoopV2Provider(_actionId: string): never {
+  throw new LearningLoopV2InvariantError("PROVIDER_START_FORBIDDEN", "dry shadow cannot start a provider");
+}
+
+export function learningLoopV2HeldOutEnclave() {
+  const learnerDbPath = resolve(process.env.ALAYA_DB_PATH ?? "data.db");
+  const dbPath = resolve(process.env.ALAYA_HELDOUT_DB_PATH ?? heldOutPathFrom(learnerDbPath));
+  if (dbPath === learnerDbPath) {
+    throw new LearningLoopV2InvariantError("HELDOUT_DB_COLLISION", "held-out DB must not be the learner DB");
+  }
+  const db = openHeldOutDb(dbPath);
+  return {
+    dbPath,
+    learnerDbPath,
+    readOnly: true as const,
+    readCheckpoint(digest: string) {
+      return { digest, writable: false as const, dbPath };
+    },
+    write(_value: unknown): never {
+      throw new LearningLoopV2InvariantError("HELDOUT_WRITE", "held-out enclave has no write path");
+    },
+    learnerEndpoint(): never {
+      throw new LearningLoopV2InvariantError("HELDOUT_NO_LEARNER", "held-out enclave has no learner endpoint");
+    },
+    attemptSqlWrite(sql: string): { refused: true } {
+      try {
+        db.exec(sql);
+      } catch {
+        return { refused: true };
+      }
+      throw new LearningLoopV2InvariantError("HELDOUT_WRITE_SUCCEEDED", "held-out sqlite accepted a write");
+    },
+  };
+  // ponytail: separate sqlite file + query_only; split OS process if a later G6 PASS requires it.
+}
+
+function countRows(table: "knowledge_items" | "llm_calls"): number {
+  const row = rawDb.prepare("SELECT COUNT(*) AS n FROM " + table).get() as { n: number };
+  return row.n;
+}
+
+function snapshotSideEffects(runId: string) {
+  const events = storage.listLearningLoopV2Events(runId);
+  return {
+    knowledge: countRows("knowledge_items"),
+    llm: countRows("llm_calls"),
+    credits: events.filter((event) => event.eventType === "CREDIT_RECORDED").length,
+  };
+}
+
+function payloadObject(payload: string): Record<string, unknown> {
+  const parsed = JSON.parse(payload) as unknown;
+  if (!parsed || typeof parsed !== "object" || Array.isArray(parsed)) {
+    throw new LearningLoopV2InvariantError("INCOMPLETE_LOG", "event payload is not an object");
+  }
+  return parsed as Record<string, unknown>;
+}
+
+function assertCompleteLog(input: { runId: string; decisionId: string; actionId: string; requestDigest: string }): void {
+  const events = storage.listLearningLoopV2Events(input.runId);
+  const decision = events.find((event) => event.eventType === "DECISION_RECORDED" && event.decisionId === input.decisionId);
+  const committed = events.find((event) => event.eventType === "ACTION_COMMITTED" && event.actionId === input.actionId);
+  const authorized = events.find((event) => event.eventType === "ACTION_AUTHORIZED" && event.actionId === input.actionId);
+  if (!decision || !committed || !authorized) {
+    throw new LearningLoopV2InvariantError("INCOMPLETE_LOG", "required action/propensity/request-digest events are missing");
+  }
+  const action = payloadObject(committed.payload).action;
+  if (!action || typeof action !== "object" || Array.isArray(action)) {
+    throw new LearningLoopV2InvariantError("INCOMPLETE_LOG", "committed action payload missing");
+  }
+  const record = action as Record<string, unknown>;
+  if (record.requestDigest !== input.requestDigest) {
+    throw new LearningLoopV2InvariantError("INCOMPLETE_LOG", "committed request digest is missing or drifted");
+  }
+  if (events.some((event) => /held-?out/i.test([event.runId, event.decisionId, event.actionId].filter(Boolean).join(" ")))) {
+    throw new LearningLoopV2InvariantError("HELDOUT_WRITE", "held-out identity appeared on the dry-shadow write path");
+  }
+}
+
+function assertGrant(grant: LearningLoopV2ApprovalGrant, input: { decisionId: string; experimentVersion: string }): void {
+  if (grant.revoked) throw new LearningLoopV2InvariantError("GRANT_REVOKED", "revoked grant cannot authorize an action");
+  if (grant.subject !== input.decisionId) {
+    throw new LearningLoopV2InvariantError("GRANT_SUBJECT_MISMATCH", "grant subject must bind the decision");
+  }
+  if (grant.version !== input.experimentVersion) {
+    throw new LearningLoopV2InvariantError("GRANT_VERSION_MISMATCH", "grant version must bind the experiment version");
+  }
+  if (!grant.nonce || !grant.principal) {
+    throw new LearningLoopV2InvariantError("GRANT_MALFORMED", "grant nonce and principal are required");
+  }
+}
+
+export function runLearningLoopV2DryShadow(input: {
+  experimentId: string;
+  experimentVersion: string;
+  runId: string;
+  decisionId: string;
+  actionId: string;
+  idempotencyKey: string;
+  manifest: LearningLoopV2BaselineManifest;
+  grant?: LearningLoopV2ApprovalGrant;
+  recordedAt?: string;
+}): LearningLoopV2DryShadowReport {
+  if (input.grant) assertGrant(input.grant, input);
+  const before = snapshotSideEffects(input.runId);
+  const built = renderLearningLoopV2BaselineExposure({
+    baselineKind: "no-injection",
+    manifest: input.manifest,
+  });
+  const exposure = commitLearningLoopV2BaselineExposure({
+    experimentId: input.experimentId,
+    experimentVersion: input.experimentVersion,
+    runId: input.runId,
+    decisionId: input.decisionId,
+    actionId: input.actionId,
+    baselineKind: "no-injection",
+    manifest: input.manifest,
+    idempotencyKey: input.grant
+      ? "grant_consume:" + input.grant.version + ":" + input.grant.nonce
+      : input.idempotencyKey,
+    recordedAt: input.recordedAt,
+  });
+  if (exposure.loggingPropensity != null) {
+    throw new LearningLoopV2InvariantError("LOGGING_PROPENSITY_ON_BASELINE", "dry shadow must not invent a logging propensity");
+  }
+  if (built.requestDigest !== exposure.requestDigest) {
+    throw new LearningLoopV2InvariantError("REQUEST_DIGEST_MISMATCH", "request-building digest drifted before dispatch");
+  }
+  const bound = assertLearningLoopV2ActionBeforeDispatch({
+    experimentId: input.experimentId,
+    experimentVersion: input.experimentVersion,
+    runId: input.runId,
+    actionId: input.actionId,
+  });
+  if (bound.realSideEffectAllowed !== false) {
+    throw new LearningLoopV2InvariantError("PROVIDER_WITHOUT_ACTION", "dry shadow crossed into real side effects");
+  }
+  const after = snapshotSideEffects(input.runId);
+  if (after.knowledge !== before.knowledge) {
+    throw new LearningLoopV2InvariantError("PRODUCT_MUTATION", "dry shadow mutated knowledge");
+  }
+  if (after.llm !== before.llm) {
+    throw new LearningLoopV2InvariantError("PROVIDER_START", "dry shadow created a provider/llm call");
+  }
+  if (after.credits !== before.credits) {
+    throw new LearningLoopV2InvariantError("CREDIT_WRITE", "dry shadow wrote credit");
+  }
+  assertCompleteLog({
+    runId: input.runId,
+    decisionId: input.decisionId,
+    actionId: input.actionId,
+    requestDigest: exposure.requestDigest,
+  });
+  const heldOut = learningLoopV2HeldOutEnclave();
+  if (heldOut.dbPath === heldOut.learnerDbPath) {
+    throw new LearningLoopV2InvariantError("HELDOUT_DB_COLLISION", "dry shadow held-out DB collided with the learner DB");
+  }
+  return {
+    providerAuthorization: 0,
+    providerStart: 0,
+    productMutation: 0,
+    creditWrite: 0,
+    heldOutWrite: 0,
+    loggingCompleteness: 1,
+    realSideEffectAllowed: false,
+    requestDigest: exposure.requestDigest,
+    grantConsumed: Boolean(input.grant),
+  };
+}
