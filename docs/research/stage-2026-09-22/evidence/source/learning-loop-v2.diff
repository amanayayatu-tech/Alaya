+import { evaluateLearningLoopV2Ope, logLearningLoopV2SimulatorPolicy } from "./learningLoopV2Ope";
+import { evaluateLearningLoopV2G1Formalization } from "./learningLoopV2G1Evaluator";
+
+const ROOT = join(dirname(fileURLToPath(import.meta.url)), "../..");
+
+const V1_FREEZE = {
+  "docs/ai/CODEX_MISSION_learning_loop.md": "357a467792a6b09ae650245f68830298e6fa499ab3e3a3fa86ef82ee38696484",
