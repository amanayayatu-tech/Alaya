+  "alaya-app/server/learningLoopV2DryShadow.ts",
+  "alaya-app/server/learningLoopV2G1Evaluator.ts",
+] as const;
+
+const AMENDMENT_FILES = [
+  "docs/validation/LEARNING_LOOP_V2_G4_SPEC_AMENDMENT.json",
+  "docs/validation/LEARNING_LOOP_V2_G5_OPE_AMENDMENT.json",
+] as const;
+
+const HISTORICAL_2_0_0 = [
+  "docs/validation/LEARNING_LOOP_V2_G4_SEED_MANIFEST.2.0.0.json",
+  "docs/validation/LEARNING_LOOP_V2_G4_SPEC_AMENDMENT.2.0.0.json",
+  "docs/validation/LEARNING_LOOP_V2_G5_OPE_AMENDMENT.2.0.0.json",
+] as const;
+
+const HISTORICAL_2_0_0_SHA256 = {
+  "docs/validation/LEARNING_LOOP_V2_G4_SEED_MANIFEST.2.0.0.json": "8926334a04818d74ef986bae7a507ed5fc769dae880bb0384562eb475e0384d0",
+  "docs/validation/LEARNING_LOOP_V2_G4_SPEC_AMENDMENT.2.0.0.json": "e526a40a3a0a1c4bbd32a4561375fb3246cd2201527f89293099a831e47e5436",
+  "docs/validation/LEARNING_LOOP_V2_G5_OPE_AMENDMENT.2.0.0.json": "22a6670e94d5ed281c32656082f140edaecbdb7c4a638c61eb7c938e7d1edad0",
+} as const;
+
+const EMBARGO_EXACT = [
+  "alaya-architecture-reset-codex-loop-controller-pack.md",
+  "alaya-architecture-reset-codex-loop-controller-pack.58ea2788882013a8.md",
+  "alaya-learning-loop-codex-controller-pack.md",
+  "REVIEW_BUNDLE_B0.tar.gz",
+  "REVIEW_BUNDLE_shadow.tar.gz",
+  "review_bundle_C_rework",
+  ".codex-loop",
+  "validation-logs",
+  "node_modules",
+  "alaya-app/node_modules",
+] as const;
+
+const V1_SOURCE_MARKERS = [
+  "docs/ai/CODEX_MISSION_learning_loop.md",
+  "docs/validation/EXPERIMENT_PREREG_learning_loop.md",
+  "docs/validation/PR_L6_LEARNING_LOOP_FAILED_CASE.md",
+  "/tmp/alaya-pr-l6",
+];
+
+const SCAN_DIRS = [
+  ".",
+  "alaya-app",
+  "alaya-app/server",
+  "alaya-app/client",
+  "alaya-app/client/src",
+  "alaya-app/client/src/components",
+  "alaya-app/tests",
+  "scripts",
+  "docs",
+  "docs/ai",
+  "docs/validation",
+];
+
+function sha256File(rel: string): string {
+  return createHash("sha256").update(readFileSync(join(ROOT, rel))).digest("hex");
+}
+
+export function embargoReason(rel: string): string | null {
+  const normalized = rel.replace(/^[.][/]/, "");
+  const base = normalized.split("/").pop() || normalized;
+  if (EMBARGO_EXACT.includes(normalized as typeof EMBARGO_EXACT[number]) || EMBARGO_EXACT.includes(base as typeof EMBARGO_EXACT[number])) {
+    return "forbidden-archive-or-runtime";
+  }
+  if (normalized === ".codex-loop" || normalized.startsWith(".codex-loop/")) return "runtime-state";
+  if (normalized === "validation-logs" || normalized.startsWith("validation-logs/")) return "historical-run-log";
+  if (normalized === "node_modules" || normalized.startsWith("node_modules/") || normalized.includes("/node_modules/")) return "dependencies";
+  if (/\.tar\.gz$/.test(normalized) || /^REVIEW_BUNDLE/.test(base)) return "review-bundle-archive";
+  if (/controller-pack/i.test(base)) return "controller-pack";
+  if (/ 2(\.[^/]+)?$/.test(base)) return "duplicate-untracked";
+  if (base.startsWith(".env")) return "secrets";
+  return null;
+}
+
+function listScanPaths(root = ROOT): string[] {
+  const out: string[] = [];
+  for (const dir of SCAN_DIRS) {
+    const abs = dir === "." ? root : join(root, dir);
+    if (!existsSync(abs) || !statSync(abs).isDirectory()) continue;
+    for (const name of readdirSync(abs)) {
+      const rel = dir === "." ? name : join(dir, name);
+      out.push(rel.replaceAll("\\", "/"));
+    }
+  }
+  for (const rel of EMBARGO_EXACT) {
+    if (existsSync(join(root, rel))) out.push(rel);
+  }
+  return [...new Set(out)].sort();
+}
+
+export function scanLearningLoopV2Embargo(input: {
+  hashedEvidence: string[];
+  root?: string;
+}): {
+  status: "clean" | "contaminated";
+  exclusions: Array<{ path: string; reason: string }>;
+  violations: Array<{ path: string; reason: string }>;
+} {
+  const root = input.root ?? ROOT;
+  const hashed = new Set(input.hashedEvidence);
+  const exclusions: Array<{ path: string; reason: string }> = [];
+  const violations: Array<{ path: string; reason: string }> = [];
+  for (const rel of listScanPaths(root)) {
+    const reason = embargoReason(rel);
+    if (!reason) continue;
+    exclusions.push({ path: rel, reason });
+    if (hashed.has(rel)) violations.push({ path: rel, reason: "embargoed-path-hashed-as-evidence" });
+  }
+  for (const rel of input.hashedEvidence) {
+    const reason = embargoReason(rel);
+    if (reason) violations.push({ path: rel, reason: "embargoed-path-hashed-as-evidence" });
+  }
+  for (const rel of OFFLINE_FILES) {
+    if (rel.endsWith("learningLoopV2G1Evaluator.ts")) continue;
+    const text = readFileSync(join(root, rel), "utf8");
+    for (const marker of V1_SOURCE_MARKERS) {
+      if (text.includes(marker)) {
+        violations.push({ path: rel, reason: "v1-source-marker:" + marker });
+      }
+    }
+  }
+  const uniqueViolations = [...new Map(violations.map((item) => [item.path + ":" + item.reason, item])).values()];
+  const uniqueExclusions = [...new Map(exclusions.map((item) => [item.path, item])).values()]
+    .sort((a, b) => a.path.localeCompare(b.path));
+  if (uniqueViolations.length > 0) {
+    throw new LearningLoopV2InvariantError(
+      "EVIDENCE_CONTAMINATED",
+      uniqueViolations.map((item) => item.path + " " + item.reason).join("; "),
+    );
+  }
+  return { status: "clean", exclusions: uniqueExclusions, violations: uniqueViolations };
+}
+
+export function learningLoopV2G7Closeout() {
+  const v1: Record<string, string> = {};
+  for (const [rel, expected] of Object.entries(V1_FREEZE)) {
+    const actual = sha256File(rel);
+    if (actual !== expected) {
+      throw new LearningLoopV2InvariantError("V1_FREEZE_VIOLATION", rel + " hash drifted");
+    }
+    v1[rel] = actual;
+  }
+  const g1: Record<string, string> = {};
+  for (const rel of G1_FILES) g1[rel] = sha256File(rel);
+  const g1Eval = evaluateLearningLoopV2G1Formalization();
+  if (g1Eval.status !== "REVIEW_READY") {
+    throw new LearningLoopV2InvariantError(
+      "MANIFEST_INVALID",
+      g1Eval.invalid_records.map((item) => item.path + " " + item.reason).join("; ") || "G1 static evaluator is not REVIEW_READY",
+    );
+  }
+  const offline: Record<string, string> = {};
+  for (const rel of OFFLINE_FILES) offline[rel] = sha256File(rel);
+  const seed = JSON.parse(readFileSync(join(ROOT, "docs/validation/LEARNING_LOOP_V2_G4_SEED_MANIFEST.json"), "utf8")) as {
+    pass_thresholds: null | unknown;
+    generated_before_implementation: boolean;
+  };
+  if (seed.pass_thresholds != null || seed.generated_before_implementation !== true) {
+    throw new LearningLoopV2InvariantError("G4_THRESHOLD_UNSIGNED", "G4 seed freeze is not in the unsigned-threshold local-check state");
+  }
+  const amendments: Record<string, string> = {};
+  for (const rel of AMENDMENT_FILES) amendments[rel] = sha256File(rel);
+  const historical: Record<string, string> = {};
+  for (const [rel, expected] of Object.entries(HISTORICAL_2_0_0_SHA256)) {
+    const actual = sha256File(rel);
+    if (actual !== expected) {
+      throw new LearningLoopV2InvariantError("EVIDENCE_CONTAMINATED", rel + " 2.0.0 archive drifted");
+    }
+    historical[rel] = actual;
+  }
+  const g5Amendment = JSON.parse(readFileSync(join(ROOT, "docs/validation/LEARNING_LOOP_V2_G5_OPE_AMENDMENT.json"), "utf8")) as {
+    version: string;
+    generated_before_seeds: boolean;
+    statistical_ope_thresholds: null | unknown;
+  };
+  if (g5Amendment.version !== "2.1.0" || g5Amendment.generated_before_seeds !== true || g5Amendment.statistical_ope_thresholds == null) {
+    throw new LearningLoopV2InvariantError("G5_THRESHOLD_UNSIGNED", "2.1.0 G5 statistical thresholds must be frozen before seeds");
+  }
+  const g4 = learningLoopV2G4LocalReport();
+  const ope = evaluateLearningLoopV2Ope({
+    rows: logLearningLoopV2SimulatorPolicy(),
+    target: { kind: "inject-one-item", itemId: "item_a" },
+  });
+  const embargo = scanLearningLoopV2Embargo({
+    hashedEvidence: [...G1_FILES, ...OFFLINE_FILES, ...AMENDMENT_FILES, ...HISTORICAL_2_0_0],
+  });
+  const body = {
+    v1,
+    g1,
+    g1Eval,
+    offline,
+    amendments,
+    e0: "UNAUTHORIZED/UNRESOLVED",
+    historical,
+    g4: { status: g4.status, passKind: g4.passKind, passThresholds: g4.passThresholds, reviewerAttestation: null },
+    g5: { replay: "REVIEW_READY", ope: ope.status, reason: ope.reason, meetsFrozenStatisticalThresholds: ope.meetsFrozenStatisticalThresholds, statisticalOpeThresholds: "frozen-2.1.0", reviewerAttestation: null },
+    independentAcks: [
+      { gate: 1, verdict: g1Eval.status, layer: "local checks", source: "implementer-local", version: "2.1.0", digest: g1Eval.digest, evaluatorArtifactDigest: g1Eval.evaluator_artifact_digest, reviewerAttestation: null, note: "2.1.0 six-doc bump; no independent digest-bound PASS" },
+      { gate: 2, verdict: "REVIEW_READY", layer: "local checks", source: "implementer-local", note: "2.0.0 user PASS does not bind the 2.1.0 crash/JSON test slice" },
+      { gate: 3, verdict: "PASS", layer: "local checks", source: "user", bound: "learningLoopV2BaselineExposure", note: "G3 slice signed on 2.0.0 files; unchanged" },
+      { gate: 4, verdict: g4.status, kind: g4.passKind, source: "implementer-local", reviewerAttestation: null },
+      { gate: 5, verdict: ope.status, replay: "REVIEW_READY", ope: ope.status, source: "implementer-local", reviewerAttestation: null },
+      { gate: 6, verdict: "REVIEW_READY", layer: "local checks", source: "implementer-local", reviewerAttestation: null },
+    ],
+    embargo: {
+      status: embargo.status,
+      exclusionCount: embargo.exclusions.length,
+      exclusions: embargo.exclusions,
+    },
+  };
+  return {
+    status: "BLOCKED" as const,
+    gate: 7,
+    claimCeiling: "local checks",
+    reason: "2.1.0 local checks cannot close G7: independent Reviewer/Judge identities are not ACK'd; E0 remains UNAUTHORIZED/UNRESOLVED",
+    e0: "UNAUTHORIZED/UNRESOLVED",
+    digest: "sha256:" + createHash("sha256").update(canonicalLearningLoopV2Json(body), "utf8").digest("hex"),
+    artifacts: body,
+    embargo,
+  };
+}
