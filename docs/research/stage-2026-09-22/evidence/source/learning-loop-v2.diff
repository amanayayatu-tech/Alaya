diff --git a/alaya-app/server/learningLoopV2BaselineExposure.ts b/alaya-app/server/learningLoopV2BaselineExposure.ts
new file mode 100644
--- /dev/null
+++ b/alaya-app/server/learningLoopV2BaselineExposure.ts
@@ -0,0 +1,321 @@
+import { createHash } from "node:crypto";
+import {
+  LearningLoopV2InvariantError,
+  assertLearningLoopV2ActionBeforeDispatch,
+  authorizeLearningLoopV2Action,
+  canonicalLearningLoopV2Json,
+  commitLearningLoopV2Action,
+  recordLearningLoopV2Decision,
+} from "./learningLoopV2ExperienceLedger";
+
+export type LearningLoopV2BaselineKind = "no-injection" | "frozen-static";
+export type LearningLoopV2BaselineActionKind = "no-op" | "inject-one-item";
+
+export interface LearningLoopV2FrozenCandidate {
+  itemId: string;
+  itemVersion: string;
+  score: number;
+  tieBreak: number;
+  content: string;
+}
+
+export interface LearningLoopV2BaselineManifest {
+  context: Record<string, unknown>;
+  candidates: LearningLoopV2FrozenCandidate[];
+  tokenBudget: number;
+  rendererId: string;
+}
+
+export interface LearningLoopV2BaselineAction {
+  kind: LearningLoopV2BaselineActionKind;
+  itemId: string | null;
+  itemVersion: string | null;
+}
+
+export interface LearningLoopV2TruncationRecord {
+  occurred: boolean;
+  proposedTokens: number;
+  deliveredTokens: number;
+  tokenBudget: number;
+}
+
+export interface LearningLoopV2BaselineExposure {
+  baselineKind: LearningLoopV2BaselineKind;
+  policyKind: "deterministic_baseline";
+  proposedAction: LearningLoopV2BaselineAction;
+  deliveredAction: LearningLoopV2BaselineAction;
+  rendererBytes: string;
+  rendererDigest: string;
+  requestDigest: string;
+  exactPropensity: { deliveredActionKey: string; probability: 1 };
+  loggingPropensity: null;
+  truncation: LearningLoopV2TruncationRecord;
+  leakage: string[];
+}
+
+const STRUCTURAL_LEAKS = [
+  "activeKnowledge",
+  "knowledgeRefs",
+  "knowledgeSummary",
+  "knowledge_summary",
+  "[PRIOR KNOWLEDGE]",
+  "humanApprovedCount",
+  "confidenceScore",
+  "confidenceLevel",
+  "lastInjectedAt",
+  "evidenceAlpha",
+  "evidenceBeta",
+  "humanApproved",
+];
+
+function digest(value: string): string {
+  return `sha256:${createHash("sha256").update(value, "utf8").digest("hex")}`;
+}
+
+function actionKey(action: LearningLoopV2BaselineAction): string {
+  if (action.kind === "no-op") return "no-op";
+  return `inject-one-item:${action.itemId}@${action.itemVersion}`;
+}
+
+function approxTokens(text: string): number {
+  return Math.max(1, Math.ceil(text.length / 4));
+}
+
+function rankFrozen(candidates: LearningLoopV2FrozenCandidate[]): LearningLoopV2FrozenCandidate[] {
+  return [...candidates].sort((a, b) => {
+    if (b.score !== a.score) return b.score - a.score;
+    if (a.tieBreak !== b.tieBreak) return a.tieBreak - b.tieBreak;
+    return a.itemId.localeCompare(b.itemId) || a.itemVersion.localeCompare(b.itemVersion);
+  });
+}
+
+function scanStructuralLeakage(bytes: string): string[] {
+  const found: string[] = [];
+  const haystack = bytes.toLowerCase();
+  for (const token of STRUCTURAL_LEAKS) {
+    if (haystack.includes(token.toLowerCase())) found.push(token);
+  }
+  return found;
+}
+
+function renderContext(context: Record<string, unknown>): string {
+  return `[CONTEXT]\n${canonicalLearningLoopV2Json(context)}\n[/CONTEXT]`;
+}
+
+function renderExposure(action: LearningLoopV2BaselineAction, content: string | null): string {
+  if (action.kind === "no-op") return "[EXPOSURE]\nno-op\n[/EXPOSURE]";
+  return `[EXPOSURE]\ninject-one-item ${action.itemId}@${action.itemVersion}\n${content ?? ""}\n[/EXPOSURE]`;
+}
+
+function assertManifest(manifest: LearningLoopV2BaselineManifest): void {
+  if (!Number.isFinite(manifest.tokenBudget) || manifest.tokenBudget < 0) {
+    throw new LearningLoopV2InvariantError("INVALID_TOKEN_BUDGET", "tokenBudget must be a finite number >= 0");
+  }
+  if (!manifest.rendererId) {
+    throw new LearningLoopV2InvariantError("INVALID_RENDERER", "rendererId is required");
+  }
+  for (const candidate of manifest.candidates) {
+    if (!Number.isFinite(candidate.score) || !Number.isFinite(candidate.tieBreak)) {
+      throw new LearningLoopV2InvariantError("INVALID_FROZEN_CANDIDATE", "frozen candidates need finite score and tieBreak");
+    }
+  }
+}
+
+export function renderLearningLoopV2BaselineExposure(input: {
+  baselineKind: LearningLoopV2BaselineKind;
+  manifest: LearningLoopV2BaselineManifest;
+  loggingPropensity?: unknown;
+}): LearningLoopV2BaselineExposure {
+  assertManifest(input.manifest);
+  if (input.loggingPropensity != null) {
+    throw new LearningLoopV2InvariantError(
+      "LOGGING_PROPENSITY_ON_BASELINE",
+      "deterministic baselines cannot record a logging propensity",
+    );
+  }
+  if (input.baselineKind !== "no-injection" && input.baselineKind !== "frozen-static") {
+    throw new LearningLoopV2InvariantError("INVALID_BASELINE", "unknown baseline kind");
+  }
+
+  const ranked = rankFrozen(input.manifest.candidates);
+  const top = ranked[0] ?? null;
+  const proposed: LearningLoopV2BaselineAction = input.baselineKind === "no-injection" || !top
+    ? { kind: "no-op", itemId: null, itemVersion: null }
+    : { kind: "inject-one-item", itemId: top.itemId, itemVersion: top.itemVersion };
+
+  const proposedContent = proposed.kind === "inject-one-item" && top ? top.content : null;
+  const proposedBytes = `${renderContext(input.manifest.context)}\n${renderExposure(proposed, proposedContent)}`;
+  const proposedTokens = approxTokens(proposedBytes);
+
+  let delivered = proposed;
+  let deliveredContent = proposedContent;
+  if (proposedTokens > input.manifest.tokenBudget) {
+    delivered = { kind: "no-op", itemId: null, itemVersion: null };
+    deliveredContent = null;
+  }
+
+  const rendererBytes = `${renderContext(input.manifest.context)}\n${renderExposure(delivered, deliveredContent)}`;
+  const deliveredTokens = approxTokens(rendererBytes);
+  const truncation: LearningLoopV2TruncationRecord = {
+    occurred: proposedTokens > input.manifest.tokenBudget || actionKey(proposed) !== actionKey(delivered),
+    proposedTokens,
+    deliveredTokens,
+    tokenBudget: input.manifest.tokenBudget,
+  };
+
+  const leakage = scanStructuralLeakage(rendererBytes);
+  if (input.baselineKind === "no-injection") {
+    for (const candidate of input.manifest.candidates) {
+      if (rendererBytes.includes(candidate.itemId)) leakage.push(`itemId:${candidate.itemId}`);
+      if (candidate.content && rendererBytes.includes(candidate.content)) leakage.push(`content:${candidate.itemId}`);
+    }
+  } else {
+    for (const candidate of input.manifest.candidates) {
+      const allowed = delivered.kind === "inject-one-item"
+        && candidate.itemId === delivered.itemId
+        && candidate.itemVersion === delivered.itemVersion;
+      if (!allowed && candidate.content && rendererBytes.includes(candidate.content)) {
+        leakage.push(`other-content:${candidate.itemId}`);
+      }
+    }
+  }
+  if (leakage.length > 0) {
+    throw new LearningLoopV2InvariantError("BASELINE_LEAKAGE", `baseline leakage: ${leakage.join(",")}`);
+  }
+
+  const rendererDigest = digest(rendererBytes);
+  const requestDigest = digest(canonicalLearningLoopV2Json({
+    baselineKind: input.baselineKind,
+    policyKind: "deterministic_baseline",
+    rendererId: input.manifest.rendererId,
+    context: input.manifest.context,
+    deliveredAction: delivered,
+    rendererDigest,
+    truncation,
+  }));
+
+  return {
+    baselineKind: input.baselineKind,
+    policyKind: "deterministic_baseline",
+    proposedAction: proposed,
+    deliveredAction: delivered,
+    rendererBytes,
+    rendererDigest,
+    requestDigest,
+    exactPropensity: { deliveredActionKey: actionKey(delivered), probability: 1 },
+    loggingPropensity: null,
+    truncation,
+    leakage: [],
+  };
+}
+
+export function replayLearningLoopV2BaselineExposure(
+  input: Parameters<typeof renderLearningLoopV2BaselineExposure>[0],
+): LearningLoopV2BaselineExposure {
+  const first = renderLearningLoopV2BaselineExposure(input);
+  const second = renderLearningLoopV2BaselineExposure(input);
+  if (first.rendererBytes !== second.rendererBytes || first.requestDigest !== second.requestDigest) {
+    throw new LearningLoopV2InvariantError("BASELINE_REPLAY_DRIFT", "baseline render is not byte-stable");
+  }
+  return first;
+}
+
+export function assertLearningLoopV2BaselinesDistinct(
+  noInjection: LearningLoopV2BaselineExposure,
+  frozenStatic: LearningLoopV2BaselineExposure,
+): void {
+  if (noInjection.baselineKind !== "no-injection" || frozenStatic.baselineKind !== "frozen-static") {
+    throw new LearningLoopV2InvariantError("INVALID_BASELINE", "distinctness requires both baseline kinds");
+  }
+  if (noInjection.requestDigest === frozenStatic.requestDigest) {
+    throw new LearningLoopV2InvariantError("BASELINE_COLLISION", "no-injection and frozen-static request digests must differ");
+  }
+}
+
+export function freezeLearningLoopV2StaticPolicy(mutators: {
+  writeCredit?: () => void;
+  updatePolicy?: () => void;
+}): void {
+  if (mutators.writeCredit) {
+    throw new LearningLoopV2InvariantError("CREDIT_WRITE_FORBIDDEN", "frozen-static baseline cannot write credit");
+  }
+  if (mutators.updatePolicy) {
+    throw new LearningLoopV2InvariantError("POLICY_MUTATION_FORBIDDEN", "frozen-static baseline cannot update policy");
+  }
+}
+
+export function commitLearningLoopV2BaselineExposure(input: {
+  experimentId: string;
+  experimentVersion: string;
+  runId: string;
+  decisionId: string;
+  actionId: string;
+  baselineKind: LearningLoopV2BaselineKind;
+  manifest: LearningLoopV2BaselineManifest;
+  idempotencyKey: string;
+  recordedAt?: string;
+}): LearningLoopV2BaselineExposure {
+  const exposure = replayLearningLoopV2BaselineExposure({
+    baselineKind: input.baselineKind,
+    manifest: input.manifest,
+  });
+  recordLearningLoopV2Decision({
+    experimentId: input.experimentId,
+    experimentVersion: input.experimentVersion,
+    runId: input.runId,
+    decisionId: input.decisionId,
+    idempotencyKey: `${input.idempotencyKey}_decision`,
+    recordedAt: input.recordedAt,
+    context: input.manifest.context,
+    selectedAction: {
+      baselineKind: input.baselineKind,
+      policyKind: "deterministic_baseline",
+      proposed: exposure.proposedAction,
+      delivered: exposure.deliveredAction,
+    },
+  });
+  const committed = commitLearningLoopV2Action({
+    experimentId: input.experimentId,
+    experimentVersion: input.experimentVersion,
+    runId: input.runId,
+    decisionId: input.decisionId,
+    actionId: input.actionId,
+    idempotencyKey: `${input.idempotencyKey}_commit`,
+    recordedAt: input.recordedAt,
+    action: {
+      kind: exposure.deliveredAction.kind,
+      proposed: exposure.proposedAction,
+      delivered: exposure.deliveredAction,
+      rendererDigest: exposure.rendererDigest,
+      requestDigest: exposure.requestDigest,
+      exactPropensity: exposure.exactPropensity,
+      truncation: exposure.truncation,
+      sideEffectMode: "offline_stub_only",
+    },
+  });
+  authorizeLearningLoopV2Action({
+    experimentId: input.experimentId,
+    experimentVersion: input.experimentVersion,
+    runId: input.runId,
+    decisionId: input.decisionId,
+    actionId: input.actionId,
+    authorization: "offline_stub",
+    idempotencyKey: `${input.idempotencyKey}_authorize`,
+    recordedAt: input.recordedAt,
+  });
+  const bound = assertLearningLoopV2ActionBeforeDispatch({
+    experimentId: input.experimentId,
+    experimentVersion: input.experimentVersion,
+    runId: input.runId,
+    actionId: input.actionId,
+  });
+  if (bound.actionDigest !== committed.eventDigest) {
+    throw new LearningLoopV2InvariantError("REQUEST_DIGEST_MISMATCH", "dispatch binding does not match committed action");
+  }
+  return exposure;
+}
+
+export function productKnowledgeFormatterIsUnsafeForBaseline(sample: string): boolean {
+  const productMarks = ["[strong]", "[active]", "score=", "evidence=", "usage="];
+  return scanStructuralLeakage(sample).length > 0 || productMarks.some((token) => sample.includes(token));
+}
