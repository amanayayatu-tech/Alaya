+
+export interface LearningLoopV2ReferenceRow {
+  sequence: number;
+  seedId: string;
+  slotPropensity: number;
+  jointPropensity: number;
+  reward: number;
+}
+
+export function referenceDeriveLearningLoopV2ReplayState(rows: LearningLoopV2ReferenceRow[]) {
+  const invalid = rows
+    .filter((row) => row.slotPropensity <= 0 || row.slotPropensity > 1 || Math.abs(row.slotPropensity - row.jointPropensity) > 1e-12)
+    .map((row) => row.seedId)
+    .sort();
+  const derived = {
+    count: rows.length,
+    invalid,
+    sequences: rows.map((row) => row.sequence),
+    meanReward: rows.reduce((sum, row) => sum + row.reward, 0) / Math.max(1, rows.length),
+  };
+  return {
+    derived,
+    digest: "sha256:" + createHash("sha256").update(canonicalLearningLoopV2Json(derived), "utf8").digest("hex"),
+  };
+}
diff --git a/alaya-app/server/learningLoopV2Ope.ts b/alaya-app/server/learningLoopV2Ope.ts
new file mode 100644
--- /dev/null
+++ b/alaya-app/server/learningLoopV2Ope.ts
@@ -0,0 +1,437 @@
+import { createHash } from "node:crypto";
+import { readFileSync } from "node:fs";
+import { dirname, join } from "node:path";
+import { fileURLToPath } from "node:url";
+import { canonicalLearningLoopV2Json, LearningLoopV2InvariantError } from "./learningLoopV2ExperienceLedger";
+import {
+  LEARNING_LOOP_V2_B0_LOGGING_ACTIONS,
+  LEARNING_LOOP_V2_G4_WORLDS,
+  learningLoopV2ActionKey,
+  loadLearningLoopV2G4SeedManifest,
+  sha256FileBytes,
+  simulateLearningLoopV2World,
+  type LearningLoopV2G4World,
+  type LearningLoopV2SimAction,
+} from "./learningLoopV2Simulator";
+
+export type LearningLoopV2OpeMethod = "IPS" | "SNIPS" | "DR" | "SWITCH";
+
+export interface LearningLoopV2LoggedDecision {
+  sequence: number;
+  recordedAt: string;
+  world: LearningLoopV2G4World;
+  seedId: string;
+  seedDigest: string;
+  action: LearningLoopV2SimAction;
+  propensityVector: number[];
+  slotPropensity: number;
+  jointPropensity: number;
+  reward: 0 | 1;
+}
+
+export interface LearningLoopV2ReplayEvent {
+  sequence: number;
+  recordedAt: string;
+  seedId: string;
+}
+
+const G5_PATH = join(
+  dirname(fileURLToPath(import.meta.url)),
+  "../../docs/validation/LEARNING_LOOP_V2_G5_OPE_AMENDMENT.json",
+);
+
+const LOGGING_P = 1 / 3;
+
+export interface LearningLoopV2WaldInterval {
+  low: number;
+  high: number;
+  n: number;
+}
+
+export interface LearningLoopV2OpeDenominator {
+  expected: number;
+  logged: number;
+  missing: number;
+  invalid: number;
+  unsupported: number;
+  used: number;
+}
+
+interface G5Amendment {
+  version: string;
+  generated_before_seeds: boolean;
+  statistical_ope_thresholds: {
+    n_expected: number;
+    essMin: number;
+    maxWeight: number;
+    clipping: string;
+    drAbsBiasMax: number;
+    overallWaldMustCoverOnlineTruth: LearningLoopV2OpeMethod[];
+    switchTau: number;
+    unsupportedMassMaxForInSupportTarget: number;
+    missingMax: number;
+    invalidMax: number;
+    world_coverage_is_diagnostic_only: boolean;
+  };
+  confirmatory_target: LearningLoopV2SimAction;
+}
+
+export function loadLearningLoopV2G5OpeAmendment(path = G5_PATH): G5Amendment {
+  const spec = JSON.parse(readFileSync(path, "utf8")) as G5Amendment;
+  if (spec.version !== "2.1.0") {
+    throw new LearningLoopV2InvariantError("VERSION_MISMATCH", "active G5 amendment must be 2.1.0");
+  }
+  if (spec.generated_before_seeds !== true) {
+    throw new LearningLoopV2InvariantError("G5_THRESHOLD_UNSIGNED", "G5 thresholds must be frozen before seeds");
+  }
+  if (!spec.statistical_ope_thresholds) {
+    throw new LearningLoopV2InvariantError("G5_THRESHOLD_UNSIGNED", "2.1.0 G5 statistical thresholds are missing");
+  }
+  return spec;
+}
+
+function policyDigest(value: unknown): string {
+  return "sha256:" + createHash("sha256").update(canonicalLearningLoopV2Json(value), "utf8").digest("hex");
+}
+
+function waldInterval(values: number[]): LearningLoopV2WaldInterval {
+  const n = values.length;
+  const mean = n === 0 ? 0 : values.reduce((sum, value) => sum + value, 0) / n;
+  const variance = n <= 1 ? 0 : values.reduce((sum, value) => sum + (value - mean) * (value - mean), 0) / (n - 1);
+  const se = n === 0 ? 0 : Math.sqrt(variance / n);
+  return { low: mean - 1.96 * se, high: mean + 1.96 * se, n };
+  // ponytail: Wald on per-decision terms; Wilson/bootstrap only after a later signed amendment.
+}
+
+function quantile(sorted: number[], q: number): number {
+  if (sorted.length === 0) return 0;
+  return sorted[Math.min(sorted.length - 1, Math.floor(q * (sorted.length - 1)))] ?? 0;
+}
+
+function covers(interval: LearningLoopV2WaldInterval, truth: number): boolean {
+  return truth + 1e-12 >= interval.low && truth - 1e-12 <= interval.high;
+}
+
+function seedKey(world: string, seedId: string): string {
+  return world + ":" + seedId;
+}
+
+function isInvalidDecision(row: LearningLoopV2LoggedDecision): boolean {
+  return row.slotPropensity <= 0 || row.slotPropensity > 1 || Math.abs(row.slotPropensity - row.jointPropensity) > 1e-12;
+}
+
+function loggingIndex(digest: string): number {
+  const hex = digest.replace(/^sha256:/, "");
+  return parseInt(hex.slice(0, 8), 16) % LEARNING_LOOP_V2_B0_LOGGING_ACTIONS.length;
+}
+
+function assertPropensityVector(vector: number[]): void {
+  if (!Array.isArray(vector) || vector.length === 0) {
+    throw new LearningLoopV2InvariantError("CORRUPT_PROPENSITY", "propensity vector missing");
+  }
+  let sum = 0;
+  for (const item of vector) {
+    if (typeof item !== "number" || !Number.isFinite(item) || item < 0 || item > 1) {
+      throw new LearningLoopV2InvariantError("CORRUPT_PROPENSITY", "propensity values must be finite and in [0,1]");
+    }
+    sum += item;
+  }
+  if (Math.abs(sum - 1) > 1e-9) {
+    throw new LearningLoopV2InvariantError("CORRUPT_PROPENSITY", "propensity must sum to 1");
+  }
+}
+
+function decisionWeight(row: LearningLoopV2LoggedDecision, targetIndex: number, targetKey: string): number {
+  assertPropensityVector(row.propensityVector);
+  const loggedKey = learningLoopV2ActionKey(row.action);
+  const loggedIndex = LEARNING_LOOP_V2_B0_LOGGING_ACTIONS.findIndex((action) => learningLoopV2ActionKey(action) === loggedKey);
+  if (loggedIndex < 0 || Math.abs(row.propensityVector[loggedIndex] - row.slotPropensity) > 1e-12) {
+    throw new LearningLoopV2InvariantError("CORRUPT_PROPENSITY", "slot propensity does not match the logged action");
+  }
+  if (targetIndex < 0) return 0;
+  const pTarget = row.propensityVector[targetIndex];
+  if (!Number.isFinite(pTarget) || pTarget <= 0) return 0;
+  return loggedKey === targetKey ? 1 / pTarget : 0;
+}
+
+function isUnsupported(row: LearningLoopV2LoggedDecision, targetIndex: number): boolean {
+  if (targetIndex < 0) return true;
+  const pTarget = row.propensityVector[targetIndex];
+  return !Number.isFinite(pTarget) || pTarget <= 0;
+}
+
+function onlineY(row: LearningLoopV2LoggedDecision, target: LearningLoopV2SimAction): 0 | 1 {
+  return simulateLearningLoopV2World(row.world, { seedId: row.seedId, digest: row.seedDigest }, target);
+}
+
+export function logLearningLoopV2SimulatorPolicy(): LearningLoopV2LoggedDecision[] {
+  const manifest = loadLearningLoopV2G4SeedManifest();
+  const rows: LearningLoopV2LoggedDecision[] = [];
+  let sequence = 1;
+  for (const world of LEARNING_LOOP_V2_G4_WORLDS) {
+    for (const seed of manifest.worlds[world]) {
+      const action = LEARNING_LOOP_V2_B0_LOGGING_ACTIONS[loggingIndex(seed.digest)];
+      const vector = LEARNING_LOOP_V2_B0_LOGGING_ACTIONS.map(() => LOGGING_P);
+      assertPropensityVector(vector);
+      rows.push({
+        sequence,
+        recordedAt: "2026-07-13T00:00:00." + String(sequence).padStart(3, "0") + "Z",
+        world,
+        seedId: seed.seedId,
+        seedDigest: seed.digest,
+        action,
+        propensityVector: vector,
+        slotPropensity: LOGGING_P,
+        jointPropensity: LOGGING_P,
+        reward: simulateLearningLoopV2World(world, seed, action),
+      });
+      sequence += 1;
+    }
+  }
+  return rows;
+}
+
+export function deriveLearningLoopV2ReplayState(rows: LearningLoopV2LoggedDecision[]) {
+  const invalid = rows.filter((row) => isInvalidDecision(row)).map((row) => row.seedId).sort();
+  const derived = {
+    count: rows.length,
+    invalid,
+    sequences: rows.map((row) => row.sequence),
+    meanReward: rows.reduce((sum, row) => sum + row.reward, 0) / Math.max(1, rows.length),
+  };
+  return {
+    derived,
+    digest: "sha256:" + createHash("sha256").update(canonicalLearningLoopV2Json(derived), "utf8").digest("hex"),
+  };
+}
+
+export function replayLearningLoopV2EventPack(
+  events: LearningLoopV2ReplayEvent[],
+  orderBy: "sequence" | "timestamp",
+): { status: "ok"; digest: string } {
+  if (events.length === 0) throw new LearningLoopV2InvariantError("REPLAY_FAIL", "empty event pack");
+  for (let i = 1; i < events.length; i++) {
+    if (events[i].sequence <= events[i - 1].sequence) {
+      throw new LearningLoopV2InvariantError("REPLAY_FAIL", "event pack is not strictly increasing in sequence");
+    }
+  }
+  const byTime = [...events].sort((a, b) => a.recordedAt.localeCompare(b.recordedAt) || a.sequence - b.sequence);
+  const timeMismatch = byTime.some((event, index) => event.sequence !== events[index].sequence);
+  if (orderBy === "timestamp" && timeMismatch) {
+    throw new LearningLoopV2InvariantError("REPLAY_FAIL", "timestamp order is not an authoritative replay key");
+  }
+  const derived = {
+    sequences: events.map((event) => event.sequence),
+    seedIds: events.map((event) => event.seedId),
+  };
+  return {
+    status: "ok",
+    digest: "sha256:" + createHash("sha256").update(canonicalLearningLoopV2Json(derived), "utf8").digest("hex"),
+  };
+}
+
+export function evaluateLearningLoopV2Ope(input: {
+  rows: LearningLoopV2LoggedDecision[];
+  target: LearningLoopV2SimAction;
+}): {
+  status: "REVIEW_READY" | "FAIL" | "OPE_NOT_IDENTIFIED";
+  reason: string;
+  reviewerAttestation: null;
+  meetsFrozenStatisticalThresholds: boolean;
+  loggingPolicyDigest: string;
+  targetPolicyDigest: string;
+  clippingRule: { kind: "none"; signed: true };
+  unsupportedMass: number;
+  ess: number;
+  maxWeight: number;
+  weightQuantile90: number;
+  weightDistribution: { min: number; p50: number; p90: number; max: number; mean: number; n: number };
+  onlineTruth: number;
+  bias: { IPS: number; SNIPS: number; DR: number; SWITCH: number };
+  estimates: Record<LearningLoopV2OpeMethod, number | null>;
+  interval: { IPS: LearningLoopV2WaldInterval; SNIPS: LearningLoopV2WaldInterval; DR: LearningLoopV2WaldInterval; SWITCH: LearningLoopV2WaldInterval };
+  coverage: { IPS: number; SNIPS: number; DR: number; n: number };
+  overallCoverage: { IPS: boolean; SNIPS: boolean; DR: boolean; SWITCH: boolean };
+  denominators: LearningLoopV2OpeDenominator;
+  invalidRecords: Array<{ seedId: string; reason: string }>;
+  missingRecords: string[];
+  thresholdDigest: string;
+} {
+  const spec = loadLearningLoopV2G5OpeAmendment();
+  const thresholds = spec.statistical_ope_thresholds;
+  const manifest = loadLearningLoopV2G4SeedManifest();
+  const expectedKeys = new Set<string>();
+  for (const world of LEARNING_LOOP_V2_G4_WORLDS) {
+    for (const seed of manifest.worlds[world]) expectedKeys.add(seedKey(world, seed.seedId));
+  }
+  const seen = new Set<string>();
+  const invalidRecords: Array<{ seedId: string; reason: string }> = [];
+  const usable: LearningLoopV2LoggedDecision[] = [];
+  for (const row of input.rows) {
+    const key = seedKey(row.world, row.seedId);
+    if (seen.has(key)) {
+      invalidRecords.push({ seedId: row.seedId, reason: "duplicate-seed" });
+      continue;
+    }
+    seen.add(key);
+    if (isInvalidDecision(row)) {
+      invalidRecords.push({ seedId: row.seedId, reason: "slot-joint-mismatch" });
+      continue;
+    }
+    usable.push(row);
+  }
+  const missingRecords = [...expectedKeys].filter((key) => !seen.has(key)).sort();
+  const targetKey = learningLoopV2ActionKey(input.target);
+  const targetIndex = LEARNING_LOOP_V2_B0_LOGGING_ACTIONS.findIndex((action) => learningLoopV2ActionKey(action) === targetKey);
+  const weights = usable.map((row) => decisionWeight(row, targetIndex, targetKey));
+  const unsupportedFlags = usable.map((row) => isUnsupported(row, targetIndex));
+  const usedRows = usable.filter((_, index) => !unsupportedFlags[index]);
+  const usedWeights = weights.filter((_, index) => !unsupportedFlags[index]);
+  const ipsTerms = usedRows.map((row, index) => usedWeights[index] * row.reward);
+  const snipsDenom = usedWeights.reduce((sum, weight) => sum + weight, 0);
+  const snipsTerms = usedRows.map((row, index) => {
+    if (snipsDenom === 0) return 0;
+    return (usedWeights[index] / (snipsDenom / Math.max(1, usedRows.length))) * row.reward;
+  });
+  const drTerms = usedRows.map((row, index) => {
+    const qTarget = onlineY(row, input.target);
+    const qLogged = simulateLearningLoopV2World(row.world, { seedId: row.seedId, digest: row.seedDigest }, row.action);
+    return qTarget + usedWeights[index] * (row.reward - qLogged);
+  });
+  const nUsed = Math.max(1, usedRows.length);
+  const ips = ipsTerms.reduce((sum, value) => sum + value, 0) / nUsed;
+  const snips = snipsDenom === 0
+    ? 0
+    : usedRows.reduce((sum, row, index) => sum + usedWeights[index] * row.reward, 0) / snipsDenom;
+  const ess = snipsDenom === 0 ? 0 : (snipsDenom * snipsDenom) / usedWeights.reduce((sum, weight) => sum + weight * weight, 0);
+  const sorted = [...usedWeights].sort((a, b) => a - b);
+  let truthSum = 0;
+  let truthN = 0;
+  for (const world of LEARNING_LOOP_V2_G4_WORLDS) {
+    for (const seed of manifest.worlds[world]) {
+      truthSum += simulateLearningLoopV2World(world, seed, input.target);
+      truthN += 1;
+    }
+  }
+  const onlineTruth = truthSum / Math.max(1, truthN);
+  const dr = drTerms.reduce((sum, value) => sum + value, 0) / nUsed;
+  const maxWeight = usedWeights.reduce((max, weight) => Math.max(max, weight), 0);
+  const switchTerms = maxWeight <= thresholds.switchTau ? ipsTerms : snipsTerms;
+  const switchEstimate = maxWeight <= thresholds.switchTau ? ips : snips;
+  const interval = {
+    IPS: waldInterval(ipsTerms),
+    SNIPS: waldInterval(snipsTerms),
+    DR: waldInterval(drTerms),
+    SWITCH: waldInterval(switchTerms),
+  };
+  const coverageHits = { IPS: 0, SNIPS: 0, DR: 0 };
+  for (const world of LEARNING_LOOP_V2_G4_WORLDS) {
+    const worldRows: LearningLoopV2LoggedDecision[] = [];
+    const worldWeights: number[] = [];
+    usedRows.forEach((row, index) => {
+      if (row.world !== world) return;
+      worldRows.push(row);
+      worldWeights.push(usedWeights[index]);
+    });
+    const worldIps = worldRows.map((row, index) => worldWeights[index] * row.reward);
+    const worldSnipsDenom = worldWeights.reduce((sum, weight) => sum + weight, 0);
+    const worldSnips = worldRows.map((row, index) => {
+      if (worldSnipsDenom === 0) return 0;
+      return (worldWeights[index] / (worldSnipsDenom / Math.max(1, worldRows.length))) * row.reward;
+    });
+    const worldDr = worldRows.map((row, index) => {
+      const qTarget = onlineY(row, input.target);
+      const qLogged = simulateLearningLoopV2World(row.world, { seedId: row.seedId, digest: row.seedDigest }, row.action);
+      return qTarget + worldWeights[index] * (row.reward - qLogged);
+    });
+    const worldSeeds = manifest.worlds[world];
+    const worldTruth = worldSeeds.reduce((sum, seed) => sum + simulateLearningLoopV2World(world, seed, input.target), 0) / Math.max(1, worldSeeds.length);
+    if (worldRows.length === 0) continue;
+    if (covers(waldInterval(worldIps), worldTruth)) coverageHits.IPS += 1;
+    if (covers(waldInterval(worldSnips), worldTruth)) coverageHits.SNIPS += 1;
+    if (covers(waldInterval(worldDr), worldTruth)) coverageHits.DR += 1;
+  }
+  const unsupportedCount = usable.filter((_, index) => unsupportedFlags[index]).length;
+  const unsupportedMass = usable.length === 0 ? 1 : unsupportedCount / usable.length;
+  const noSupport = targetIndex < 0 || unsupportedMass === 1;
+  const meanWeight = usedWeights.length === 0 ? 0 : usedWeights.reduce((sum, weight) => sum + weight, 0) / usedWeights.length;
+  const overallCoverage = {
+    IPS: covers(interval.IPS, onlineTruth),
+    SNIPS: covers(interval.SNIPS, onlineTruth),
+    DR: covers(interval.DR, onlineTruth),
+    SWITCH: covers(interval.SWITCH, onlineTruth),
+  };
+  const failures: string[] = [];
+  if (noSupport) {
+    failures.push("NO_SUPPORT");
+  } else {
+    if (missingRecords.length > thresholds.missingMax) failures.push("missing");
+    if (invalidRecords.length > thresholds.invalidMax) failures.push("invalid");
+    if (expectedKeys.size !== thresholds.n_expected) failures.push("n_expected");
+    if (!Number.isFinite(ess) || ess < thresholds.essMin) failures.push("ess");
+    if (Math.abs(maxWeight - thresholds.maxWeight) > 1e-12) failures.push("maxWeight");
+    if (Math.abs(dr - onlineTruth) > thresholds.drAbsBiasMax) failures.push("drBias");
+    if (unsupportedMass > thresholds.unsupportedMassMaxForInSupportTarget) failures.push("unsupported");
+    if (thresholds.clipping !== "none") failures.push("clipping");
+    for (const method of thresholds.overallWaldMustCoverOnlineTruth) {
+      if (method === "SWITCH") {
+        if (!overallCoverage.SWITCH) failures.push("cover:SWITCH");
+      } else if (!overallCoverage[method]) {
+        failures.push("cover:" + method);
+      }
+    }
+  }
+  const status = noSupport
+    ? "OPE_NOT_IDENTIFIED" as const
+    : failures.length === 0 ? "REVIEW_READY" as const : "FAIL" as const;
+  return {
+    status,
+    reason: noSupport ? "NO_SUPPORT" : (failures.length === 0 ? "meets frozen 2.1.0 statistical thresholds; not independent Reviewer PASS" : failures.join(",")),
+    reviewerAttestation: null,
+    meetsFrozenStatisticalThresholds: !noSupport && failures.length === 0,
+    loggingPolicyDigest: policyDigest({
+      policy: "b0-uniform-logging",
+      actions: LEARNING_LOOP_V2_B0_LOGGING_ACTIONS.map(learningLoopV2ActionKey),
+      probability: LOGGING_P,
+    }),
+    targetPolicyDigest: policyDigest({
+      policy: "deterministic-target",
+      action: targetKey,
+    }),
+    clippingRule: { kind: "none", signed: true },
+    unsupportedMass,
+    ess: Number.isFinite(ess) ? ess : 0,
+    maxWeight,
+    weightQuantile90: quantile(sorted, 0.9),
+    weightDistribution: {
+      min: sorted[0] ?? 0,
+      p50: quantile(sorted, 0.5),
+      p90: quantile(sorted, 0.9),
+      max: sorted[sorted.length - 1] ?? 0,
+      mean: meanWeight,
+      n: usedWeights.length,
+    },
+    onlineTruth,
+    bias: { IPS: ips - onlineTruth, SNIPS: snips - onlineTruth, DR: dr - onlineTruth, SWITCH: switchEstimate - onlineTruth },
+    estimates: { IPS: ips, SNIPS: snips, DR: dr, SWITCH: switchEstimate },
+    interval,
+    coverage: {
+      IPS: coverageHits.IPS / LEARNING_LOOP_V2_G4_WORLDS.length,
+      SNIPS: coverageHits.SNIPS / LEARNING_LOOP_V2_G4_WORLDS.length,
+      DR: coverageHits.DR / LEARNING_LOOP_V2_G4_WORLDS.length,
+      n: LEARNING_LOOP_V2_G4_WORLDS.length,
+    },
+    overallCoverage,
+    denominators: {
+      expected: expectedKeys.size,
+      logged: input.rows.length,
+      missing: missingRecords.length,
+      invalid: invalidRecords.length,
+      unsupported: unsupportedCount,
+      used: usedRows.length,
+    },
+    invalidRecords,
+    missingRecords,
+    thresholdDigest: "sha256:" + sha256FileBytes(G5_PATH),
+  };
+}
diff --git a/alaya-app/server/learningLoopV2Simulator.ts b/alaya-app/server/learningLoopV2Simulator.ts
new file mode 100644
--- /dev/null
+++ b/alaya-app/server/learningLoopV2Simulator.ts
@@ -0,0 +1,320 @@
+import { createHash } from "node:crypto";
+import { readFileSync } from "node:fs";
+import { dirname, join } from "node:path";
+import { fileURLToPath } from "node:url";
+import { canonicalLearningLoopV2Json, LearningLoopV2InvariantError } from "./learningLoopV2ExperienceLedger";
+
+export const LEARNING_LOOP_V2_G4_WORLDS = [
+  "additive",
+  "synergy",
+  "antagonism",
+  "redundancy",
+  "order",
+  "no-support",
+  "nonstationarity",
+] as const;
+
+export type LearningLoopV2G4World = typeof LEARNING_LOOP_V2_G4_WORLDS[number];
+export type LearningLoopV2SimItem = "item_a" | "item_b" | "item_pair" | "item_c";
+export type LearningLoopV2SimAction =
+  | { kind: "no-op"; itemId: null }
+  | { kind: "inject-one-item"; itemId: LearningLoopV2SimItem };
+
+export interface LearningLoopV2G4Seed {
+  seedId: string;
+  digest: string;
+}
+
+export const LEARNING_LOOP_V2_B0_LOGGING_ACTIONS: LearningLoopV2SimAction[] = [
+  { kind: "no-op", itemId: null },
+  { kind: "inject-one-item", itemId: "item_a" },
+  { kind: "inject-one-item", itemId: "item_b" },
+];
+
+export const LEARNING_LOOP_V2_FULL_ACTIONS: LearningLoopV2SimAction[] = [
+  { kind: "no-op", itemId: null },
+  { kind: "inject-one-item", itemId: "item_a" },
+  { kind: "inject-one-item", itemId: "item_b" },
+  { kind: "inject-one-item", itemId: "item_pair" },
+  { kind: "inject-one-item", itemId: "item_c" },
+];
+
+interface SeedManifest {
+  status: string;
+  version: string;
+  pass_thresholds: null | Record<string, unknown>;
+  generated_before_implementation: boolean;
+  generated_after_threshold_freeze?: boolean;
+  source: string;
+  seeds_per_world?: number;
+  g4_spec_sha256?: string;
+  g5_ope_sha256?: string;
+  worlds: Record<string, LearningLoopV2G4Seed[]>;
+}
+
+const MANIFEST_PATH = join(
+  dirname(fileURLToPath(import.meta.url)),
+  "../../docs/validation/LEARNING_LOOP_V2_G4_SEED_MANIFEST.json",
+);
+
+const SPEC_PATH = join(
+  dirname(fileURLToPath(import.meta.url)),
+  "../../docs/validation/LEARNING_LOOP_V2_G4_SPEC_AMENDMENT.json",
+);
+
+const G5_PATH = join(
+  dirname(fileURLToPath(import.meta.url)),
+  "../../docs/validation/LEARNING_LOOP_V2_G5_OPE_AMENDMENT.json",
+);
+
+interface G4SpecAmendment {
+  version: string;
+  kind: string;
+  seed_manifest_pass_thresholds: null;
+  design: { seeds_per_world: number; seed_source: string };
+  equal_credit_must_reject_every_seed_in: LearningLoopV2G4World[];
+  eligible_recovery: Record<string, number>;
+  stationary_recovery: { nonstationarity_must_be_strictly_less_than: number };
+}
+
+export function learningLoopV2ActionKey(action: LearningLoopV2SimAction): string {
+  return action.kind === "no-op" ? "no-op" : "inject-one-item:" + action.itemId;
+}
+
+export function sha256FileBytes(path: string): string {
+  return createHash("sha256").update(readFileSync(path)).digest("hex");
+}
+
+export function expectedLearningLoopV2G4SeedDigest(source: string, world: string, index: number): string {
+  return "sha256:" + createHash("sha256").update(`${source}
+${world}
+${index}`, "utf8").digest("hex");
+}
+
+export function loadLearningLoopV2G4SeedManifest(path = MANIFEST_PATH): SeedManifest {
+  const spec = loadLearningLoopV2G4SpecAmendment();
+  const manifest = JSON.parse(readFileSync(path, "utf8")) as SeedManifest;
+  if (manifest.pass_thresholds != null) {
+    throw new LearningLoopV2InvariantError(
+      "G4_THRESHOLD_UNSIGNED",
+      "implementer cannot treat unsigned G4 thresholds as frozen",
+    );
+  }
+  if (manifest.generated_before_implementation !== true) {
+    throw new LearningLoopV2InvariantError("G4_SEED_ORDER", "G4 seeds must be frozen before implementation");
+  }
+  if (manifest.version !== "2.1.0" || spec.version !== "2.1.0") {
+    throw new LearningLoopV2InvariantError("VERSION_MISMATCH", "active G4 seed/spec version must be 2.1.0");
+  }
+  if (manifest.generated_after_threshold_freeze !== true) {
+    throw new LearningLoopV2InvariantError("G4_SEED_ORDER", "2.1.0 seeds must be generated after threshold freeze");
+  }
+  const specHash = sha256FileBytes(SPEC_PATH);
+  if (manifest.g4_spec_sha256 !== specHash) {
+    throw new LearningLoopV2InvariantError("G4_SEED_ORDER", "seed manifest is not bound to the frozen G4 spec");
+  }
+  const g5Hash = sha256FileBytes(G5_PATH);
+  if (manifest.g5_ope_sha256 !== g5Hash) {
+    throw new LearningLoopV2InvariantError("G4_SEED_ORDER", "seed manifest is not bound to the frozen G5 OPE amendment");
+  }
+  const n = spec.design.seeds_per_world;
+  if (manifest.seeds_per_world !== n) {
+    throw new LearningLoopV2InvariantError("G4_SEED_MISSING", "seed count does not match frozen design");
+  }
+  for (const world of LEARNING_LOOP_V2_G4_WORLDS) {
+    const seeds = manifest.worlds[world];
+    if (!Array.isArray(seeds) || seeds.length !== n) {
+      throw new LearningLoopV2InvariantError("G4_SEED_MISSING", "frozen seeds for " + world + " must contain " + n + " entries");
+    }
+    seeds.forEach((seed, index) => {
+      const expected = expectedLearningLoopV2G4SeedDigest(spec.design.seed_source, world, index);
+      if (seed.digest !== expected || seed.seedId !== world + "_" + String(index).padStart(2, "0")) {
+        throw new LearningLoopV2InvariantError("G4_SEED_ORDER", "seed " + seed.seedId + " is not the frozen formula");
+      }
+    });
+  }
+  return manifest;
+}
+
+export function loadLearningLoopV2G4SpecAmendment(path = SPEC_PATH): G4SpecAmendment {
+  const spec = JSON.parse(readFileSync(path, "utf8")) as G4SpecAmendment;
+  if (spec.version !== "2.1.0") {
+    throw new LearningLoopV2InvariantError("VERSION_MISMATCH", "active G4 spec must be 2.1.0");
+  }
+  if (spec.kind !== "specification_invariants") {
+    throw new LearningLoopV2InvariantError("G4_SPEC_INVALID", "G4 spec amendment kind must be specification_invariants");
+  }
+  if (spec.seed_manifest_pass_thresholds != null) {
+    throw new LearningLoopV2InvariantError("G4_THRESHOLD_UNSIGNED", "spec amendment cannot backfill seed statistical thresholds");
+  }
+  if (!Number.isInteger(spec.design?.seeds_per_world) || spec.design.seeds_per_world < 1) {
+    throw new LearningLoopV2InvariantError("G4_SPEC_INVALID", "seeds_per_world must be a positive integer");
+  }
+  return spec;
+}
+
+function bit(digest: string, index: number): boolean {
+  const hex = digest.replace(/^sha256:/, "");
+  const n = parseInt(hex.slice(index * 2, index * 2 + 2), 16);
+  return n % 2 === 1;
+}
+
+function bestAction(
+  world: LearningLoopV2G4World,
+  seed: LearningLoopV2G4Seed,
+  actions: LearningLoopV2SimAction[],
+): LearningLoopV2SimAction {
+  let best = actions[0];
+  let bestY = -1;
+  for (const action of actions) {
+    const y = simulateLearningLoopV2World(world, seed, action);
+    if (y > bestY) {
+      bestY = y;
+      best = action;
+    }
+  }
+  return best;
+}
+
+export function simulateLearningLoopV2World(
+  world: LearningLoopV2G4World,
+  seed: LearningLoopV2G4Seed,
+  action: LearningLoopV2SimAction,
+): 0 | 1 {
+  const a = action.kind === "inject-one-item" ? action.itemId : "no-op";
+  switch (world) {
+    case "additive":
+      return a === "item_a" ? 1 : 0;
+    case "synergy":
+      return a === "item_pair" ? 1 : 0;
+    case "antagonism":
+      return a === "item_a" ? 1 : 0;
+    case "redundancy":
+      return a === "item_a" || a === "item_b" ? 1 : 0;
+    case "order":
+      return a === "item_a" ? 1 : 0;
+    case "no-support":
+      return a === "item_c" ? 1 : 0;
+    case "nonstationarity":
+      return a === (bit(seed.digest, 0) ? "item_a" : "item_b") ? 1 : 0;
+    default:
+      throw new LearningLoopV2InvariantError("UNKNOWN_WORLD", String(world));
+  }
+}
+
+export function knownOptimumLearningLoopV2World(
+  world: LearningLoopV2G4World,
+  seed: LearningLoopV2G4Seed,
+): LearningLoopV2SimAction {
+  return bestAction(world, seed, LEARNING_LOOP_V2_FULL_ACTIONS);
+}
+
+export function b0EligibleOracleLearningLoopV2World(
+  world: LearningLoopV2G4World,
+  seed: LearningLoopV2G4Seed,
+): LearningLoopV2SimAction {
+  return bestAction(world, seed, LEARNING_LOOP_V2_B0_LOGGING_ACTIONS);
+}
+
+export function stationaryB0LearningLoopV2Choice(): LearningLoopV2SimAction {
+  return { kind: "inject-one-item", itemId: "item_a" };
+}
+
+export function regretLearningLoopV2World(
+  world: LearningLoopV2G4World,
+  seed: LearningLoopV2G4Seed,
+  action: LearningLoopV2SimAction,
+): number {
+  const yStar = simulateLearningLoopV2World(world, seed, knownOptimumLearningLoopV2World(world, seed));
+  const y = simulateLearningLoopV2World(world, seed, action);
+  return yStar - y;
+}
+
+export function equalCreditLearningLoopV2Choice(
+  candidates: Array<"item_a" | "item_b">,
+  delivered: LearningLoopV2SimAction,
+  reward: 0 | 1,
+): LearningLoopV2SimAction {
+  if (delivered.kind === "no-op" || reward === 0) return { kind: "no-op", itemId: null };
+  // Forbidden: fan the delivered reward out to every slate member.
+  return { kind: "inject-one-item", itemId: candidates[candidates.length - 1] };
+}
+
+export function equalCreditSelectsWrongItem(world: LearningLoopV2G4World, seed: LearningLoopV2G4Seed): boolean {
+  if (world !== "antagonism" && world !== "order") return false;
+  const delivered: LearningLoopV2SimAction = { kind: "inject-one-item", itemId: "item_a" };
+  const y = simulateLearningLoopV2World(world, seed, delivered);
+  const choice = equalCreditLearningLoopV2Choice(["item_a", "item_b"], delivered, y);
+  const optimum = knownOptimumLearningLoopV2World(world, seed);
+  return learningLoopV2ActionKey(choice) !== learningLoopV2ActionKey(optimum);
+}
+
+function waldInterval(hits: number, n: number): { low: number; high: number; n: number } {
+  const p = n === 0 ? 0 : hits / n;
+  const se = n === 0 ? 0 : Math.sqrt((p * (1 - p)) / n);
+  return { low: p - 1.96 * se, high: p + 1.96 * se, n };
+  // ponytail: Wald interval only; Wilson/bootstrap if a signed G4 stats amendment exists.
+}
+
+export function learningLoopV2G4LocalReport() {
+  const manifest = loadLearningLoopV2G4SeedManifest();
+  const eligibleRecovery: Record<string, number> = {};
+  const stationaryRecovery: Record<string, number> = {};
+  const meanRegret: Record<string, number> = {};
+  const intervals: Record<string, { low: number; high: number; n: number }> = {};
+  const equalCreditRejected: string[] = [];
+  const knownOptimum: Record<string, string[]> = {};
+
+  for (const world of LEARNING_LOOP_V2_G4_WORLDS) {
+    let eligibleHits = 0;
+    let stationaryHits = 0;
+    let regretSum = 0;
+    knownOptimum[world] = [];
+    for (const seed of manifest.worlds[world]) {
+      const optimum = knownOptimumLearningLoopV2World(world, seed);
+      knownOptimum[world].push(seed.seedId + ":" + learningLoopV2ActionKey(optimum));
+      const eligible = b0EligibleOracleLearningLoopV2World(world, seed);
+      const stationary = stationaryB0LearningLoopV2Choice();
+      if (learningLoopV2ActionKey(eligible) === learningLoopV2ActionKey(optimum)) eligibleHits += 1;
+      if (learningLoopV2ActionKey(stationary) === learningLoopV2ActionKey(optimum)) stationaryHits += 1;
+      regretSum += regretLearningLoopV2World(world, seed, stationary);
+      if (equalCreditSelectsWrongItem(world, seed)) equalCreditRejected.push(world + ":" + seed.seedId);
+    }
+    const n = manifest.worlds[world].length;
+    eligibleRecovery[world] = eligibleHits / n;
+    stationaryRecovery[world] = stationaryHits / n;
+    meanRegret[world] = regretSum / n;
+    intervals[world] = waldInterval(eligibleHits, n);
+  }
+
+  const body = { eligibleRecovery, stationaryRecovery, meanRegret, equalCreditRejected, knownOptimum };
+  const spec = loadLearningLoopV2G4SpecAmendment();
+  const failures: string[] = [];
+  for (const world of spec.equal_credit_must_reject_every_seed_in) {
+    const rejected = equalCreditRejected.filter((item) => item.startsWith(world + ":")).length;
+    if (rejected !== manifest.worlds[world].length) failures.push("equal-credit:" + world);
+  }
+  for (const world of LEARNING_LOOP_V2_G4_WORLDS) {
+    if (eligibleRecovery[world] !== spec.eligible_recovery[world]) failures.push("eligible:" + world);
+  }
+  if (!(stationaryRecovery.nonstationarity < spec.stationary_recovery.nonstationarity_must_be_strictly_less_than)) {
+    failures.push("stationary:nonstationarity");
+  }
+  return {
+    status: failures.length === 0 ? "REVIEW_READY" as const : "FAIL" as const,
+    passKind: "specification_invariants" as const,
+    reviewerAttestation: null,
+    reason: failures.length === 0
+      ? "2.1.0 specification amendment met; seed statistical thresholds remain null; not independent Reviewer PASS"
+      : "specification failures: " + failures.join(","),
+    passThresholds: manifest.pass_thresholds,
+    specificationThresholds: spec,
+    claimCeiling: "local checks",
+    eligibleRecovery,
+    stationaryRecovery,
+    meanRegret,
+    intervals,
+    equalCreditRejectedCount: equalCreditRejected.length,
+    derivedDigest: "sha256:" + createHash("sha256").update(canonicalLearningLoopV2Json(body), "utf8").digest("hex"),
+  };
+}
diff --git a/alaya-app/tests/learningLoopV2BaselineExposure.test.ts b/alaya-app/tests/learningLoopV2BaselineExposure.test.ts
new file mode 100644
--- /dev/null
+++ b/alaya-app/tests/learningLoopV2BaselineExposure.test.ts
@@ -0,0 +1,147 @@
+import test from "node:test";
+import assert from "node:assert/strict";
+import { mkdtempSync } from "node:fs";
+import { tmpdir } from "node:os";
+import { join } from "node:path";
+
+process.env.ALAYA_DB_PATH = join(mkdtempSync(join(tmpdir(), "alaya-learning-v2-g3-")), "test.db");
+process.env.ALAYA_LLM_PROVIDER = "mock";
+
+const { LearningLoopV2InvariantError } = await import("../server/learningLoopV2ExperienceLedger.ts");
+const {
+  createLearningLoopV2Experiment,
+  registerLearningLoopV2Version,
+  startLearningLoopV2Run,
+} = await import("../server/learningLoopV2ExperienceLedger.ts");
+const {
+  assertLearningLoopV2BaselinesDistinct,
+  commitLearningLoopV2BaselineExposure,
+  freezeLearningLoopV2StaticPolicy,
+  productKnowledgeFormatterIsUnsafeForBaseline,
+  renderLearningLoopV2BaselineExposure,
+  replayLearningLoopV2BaselineExposure,
+} = await import("../server/learningLoopV2BaselineExposure.ts");
+
+const CONTRACT_DIGEST = `sha256:${"a".repeat(64)}`;
+const EVALUATOR_DIGEST = `sha256:${"b".repeat(64)}`;
+const POLICY_DIGEST = `sha256:${"c".repeat(64)}`;
+
+const manifest = {
+  context: { task: "rollback-preview", cycle: 0 },
+  candidates: [
+    { itemId: "kb_safe", itemVersion: "v1", score: 0.9, tieBreak: 1, content: "Use approved rollback preview." },
+    { itemId: "kb_noise", itemVersion: "v1", score: 0.2, tieBreak: 2, content: "Ignore this distractor item." },
+  ],
+  tokenBudget: 400,
+  rendererId: "alaya-v2-g3-renderer",
+};
+
+function prepareRun(label: string) {
+  const identity = { experimentId: `experiment_${label}`, experimentVersion: "v2.0.0" };
+  createLearningLoopV2Experiment({
+    ...identity,
+    idempotencyKey: `idem_${label}_experiment`,
+    description: "g3 baseline",
+    recordedAt: "2026-07-13T00:00:00.000Z",
+  });
+  registerLearningLoopV2Version({
+    ...identity,
+    idempotencyKey: `idem_${label}_version`,
+    contractDigest: CONTRACT_DIGEST,
+    evaluatorDigest: EVALUATOR_DIGEST,
+    recordedAt: "2026-07-13T00:00:01.000Z",
+  });
+  const runId = `run_${label}`;
+  startLearningLoopV2Run({
+    ...identity,
+    runId,
+    idempotencyKey: `idem_${label}_run`,
+    seed: "seed-g3",
+    policyDigest: POLICY_DIGEST,
+    recordedAt: "2026-07-13T00:00:02.000Z",
+  });
+  return { ...identity, runId };
+}
+
+test("no-injection bytes exclude knowledge content and metadata", () => {
+  const exposure = renderLearningLoopV2BaselineExposure({ baselineKind: "no-injection", manifest });
+  assert.equal(exposure.deliveredAction.kind, "no-op");
+  assert.equal(exposure.exactPropensity.probability, 1);
+  assert.equal(exposure.loggingPropensity, null);
+  assert.equal(exposure.rendererBytes.includes("kb_safe"), false);
+  assert.equal(exposure.rendererBytes.includes("Use approved rollback preview."), false);
+  assert.equal(exposure.rendererBytes.includes("[PRIOR KNOWLEDGE]"), false);
+  assert.match(exposure.rendererBytes, /no-op/);
+});
+
+test("frozen-static injects one frozen item without metadata or other candidates", () => {
+  const exposure = renderLearningLoopV2BaselineExposure({ baselineKind: "frozen-static", manifest });
+  assert.equal(exposure.deliveredAction.kind, "inject-one-item");
+  assert.equal(exposure.deliveredAction.itemId, "kb_safe");
+  assert.equal(exposure.rendererBytes.includes("Use approved rollback preview."), true);
+  assert.equal(exposure.rendererBytes.includes("Ignore this distractor item."), false);
+  assert.equal(exposure.rendererBytes.includes("confidenceScore"), false);
+  assert.equal(exposure.rendererBytes.includes("activeKnowledge"), false);
+  assert.equal(exposure.exactPropensity.deliveredActionKey, "inject-one-item:kb_safe@v1");
+});
+
+test("same manifest replays byte-stably and the two baselines stay distinct", () => {
+  const noInjection = replayLearningLoopV2BaselineExposure({ baselineKind: "no-injection", manifest });
+  const frozen = replayLearningLoopV2BaselineExposure({ baselineKind: "frozen-static", manifest });
+  assertLearningLoopV2BaselinesDistinct(noInjection, frozen);
+  assert.notEqual(noInjection.rendererBytes, frozen.rendererBytes);
+  assert.notEqual(noInjection.requestDigest, frozen.requestDigest);
+});
+
+test("over-budget inject-one-item becomes recorded no-op truncation", () => {
+  const tight = renderLearningLoopV2BaselineExposure({
+    baselineKind: "frozen-static",
+    manifest: { ...manifest, tokenBudget: 1 },
+  });
+  assert.equal(tight.proposedAction.kind, "inject-one-item");
+  assert.equal(tight.deliveredAction.kind, "no-op");
+  assert.equal(tight.truncation.occurred, true);
+  assert.equal(tight.rendererBytes.includes("Use approved rollback preview."), false);
+});
+
+test("logging propensity on a deterministic baseline fails closed", () => {
+  assert.throws(() => renderLearningLoopV2BaselineExposure({
+    baselineKind: "no-injection",
+    manifest,
+    loggingPropensity: [0.5, 0.5],
+  }), (error: unknown) => error instanceof LearningLoopV2InvariantError && error.code === "LOGGING_PROPENSITY_ON_BASELINE");
+});
+
+test("structural knowledge leakage and product formatter fail closed", () => {
+  assert.throws(() => renderLearningLoopV2BaselineExposure({
+    baselineKind: "no-injection",
+    manifest: {
+      ...manifest,
+      context: { task: "x", activeKnowledge: [{ id: "kb_safe" }] },
+    },
+  }), (error: unknown) => error instanceof LearningLoopV2InvariantError && error.code === "BASELINE_LEAKAGE");
+  const productSample = `- kb_safe [strong] rollback\n  score=0.91 evidence=6.0 usage=3\n  Use approved rollback preview.`;
+  assert.equal(productKnowledgeFormatterIsUnsafeForBaseline(productSample), true);
+});
+
+test("frozen-static cannot write credit or update policy", () => {
+  assert.throws(() => freezeLearningLoopV2StaticPolicy({ writeCredit: () => undefined }), (error: unknown) =>
+    error instanceof LearningLoopV2InvariantError && error.code === "CREDIT_WRITE_FORBIDDEN");
+  assert.throws(() => freezeLearningLoopV2StaticPolicy({ updatePolicy: () => undefined }), (error: unknown) =>
+    error instanceof LearningLoopV2InvariantError && error.code === "POLICY_MUTATION_FORBIDDEN");
+});
+
+test("baseline exposure commits before offline dispatch binding", () => {
+  const identity = prepareRun("g3_commit");
+  const exposure = commitLearningLoopV2BaselineExposure({
+    ...identity,
+    decisionId: "decision_g3_commit",
+    actionId: "action_g3_commit",
+    baselineKind: "frozen-static",
+    manifest,
+    idempotencyKey: "idem_g3_commit",
+    recordedAt: "2026-07-13T00:00:03.000Z",
+  });
+  assert.equal(exposure.deliveredAction.kind, "inject-one-item");
+  assert.match(exposure.requestDigest, /^sha256:[a-f0-9]{64}$/);
+});
