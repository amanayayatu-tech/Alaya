+import { createHash } from "node:crypto";
+import { storage } from "./storage";
+import type { LearningLoopV2Event } from "@shared/schema";
+
+export const LEARNING_LOOP_V2_EVENT_TYPES = [
+  "EXPERIMENT_CREATED",
+  "VERSION_REGISTERED",
+  "RUN_STARTED",
+  "DECISION_RECORDED",
+  "ACTION_COMMITTED",
+  "ACTION_AUTHORIZED",
+  "OUTCOME_RECORDED",
+  "REWARD_RECORDED",
+  "REWARD_QUARANTINED",
+  "CREDIT_RECORDED",
+] as const;
+
+export type LearningLoopV2EventType = typeof LEARNING_LOOP_V2_EVENT_TYPES[number];
+type JsonPrimitive = string | number | boolean | null;
+type JsonValue = JsonPrimitive | JsonValue[] | { [key: string]: JsonValue };
+
+const SAFE_ID = /^[A-Za-z0-9][A-Za-z0-9._:-]{0,127}$/;
+const SHA256_DIGEST = /^sha256:[a-f0-9]{64}$/;
+
+export class LearningLoopV2InvariantError extends Error {
+  constructor(readonly code: string, message: string) {
+    super(`${code}: ${message}`);
+    this.name = "LearningLoopV2InvariantError";
+  }
+}
+
+function normalizeJson(value: unknown, seen = new Set<object>()): JsonValue {
+  if (value === null || typeof value === "string" || typeof value === "boolean") return value;
+  if (typeof value === "number") {
+    if (!Number.isFinite(value)) {
+      throw new LearningLoopV2InvariantError("NON_FINITE_JSON", "event payload numbers must be finite");
+    }
+    return Object.is(value, -0) ? 0 : value;
+  }
+  if (Array.isArray(value)) {
+    if (seen.has(value)) throw new LearningLoopV2InvariantError("CYCLIC_JSON", "event payload must be acyclic");
+    seen.add(value);
+    const result = value.map((item) => normalizeJson(item, seen));
+    seen.delete(value);
+    return result;
+  }
+  if (value && typeof value === "object") {
+    if (seen.has(value)) throw new LearningLoopV2InvariantError("CYCLIC_JSON", "event payload must be acyclic");
+    seen.add(value);
+    const source = value as Record<string, unknown>;
+    const result: Record<string, JsonValue> = {};
+    for (const key of Object.keys(source).sort()) {
+      const item = source[key];
+      if (item === undefined) {
+        throw new LearningLoopV2InvariantError("UNDEFINED_JSON", `event payload field ${key} is undefined`);
+      }
+      result[key] = normalizeJson(item, seen);
+    }
+    seen.delete(value);
+    return result;
+  }
+  throw new LearningLoopV2InvariantError("UNSUPPORTED_JSON", `unsupported event payload value: ${typeof value}`);
+}
+
+export function canonicalLearningLoopV2Json(value: unknown): string {
+  return JSON.stringify(normalizeJson(value));
+}
+
+function digest(value: string): string {
+  return `sha256:${createHash("sha256").update(value, "utf8").digest("hex")}`;
+}
+
+function assertId(label: string, value: string | null | undefined, nullable = false): void {
+  if (value == null && nullable) return;
+  if (typeof value !== "string" || !SAFE_ID.test(value)) {
+    throw new LearningLoopV2InvariantError("INVALID_ID", `${label} is not a safe stable id`);
+  }
+}
+
+function assertDigest(label: string, value: string): void {
+  if (!SHA256_DIGEST.test(value)) {
+    throw new LearningLoopV2InvariantError("INVALID_DIGEST", `${label} must be a sha256 digest`);
+  }
+}
+
+function assertSameExperiment(
+  event: LearningLoopV2Event,
+  input: { experimentId: string; experimentVersion: string },
+  label: string,
+): void {
+  if (event.experimentId !== input.experimentId || event.experimentVersion !== input.experimentVersion) {
+    throw new LearningLoopV2InvariantError("VERSION_MISMATCH", `${label} experiment identity does not match`);
+  }
+}
+
+function assertWritableIdentity(label: string, value: string): void {
+  if (/(?:^|[._:-])held-?out(?:[._:-]|$)/i.test(value)) {
+    throw new LearningLoopV2InvariantError("HELDOUT_ALIAS_WRITE", `${label} cannot write a held-out identity`);
+  }
+}
+
+function assertNoSpoofedAuthority(value: unknown): void {
+  if (!value || typeof value !== "object") return;
+  const record = value as Record<string, unknown>;
+  for (const key of Object.keys(record)) {
+    const normalized = key.toLowerCase().replace(/[_-]/g, "");
+    if (
+      normalized === "humanapprovedcount" ||
+      normalized === "humanapproved" ||
+      normalized === "approvalgrant" ||
+      normalized === "grantnonce" ||
+      normalized === "actor"
+    ) {
+      throw new LearningLoopV2InvariantError("APPROVAL_SPOOF", `${key} cannot authorize a learning-loop v2 action`);
+    }
+    assertNoSpoofedAuthority(record[key]);
+  }
+}
+
+function assertPropensityIfPresent(container: Record<string, unknown>): void {
+  const nested = container.selectedAction;
+  const candidates = [
+    container.propensity,
+    nested && typeof nested === "object" && !Array.isArray(nested)
+      ? (nested as Record<string, unknown>).propensity
+      : undefined,
+  ];
+  for (const propensity of candidates) {
+    if (propensity == null) continue;
+    const values = Array.isArray(propensity)
+      ? propensity
+      : propensity && typeof propensity === "object" && !Array.isArray(propensity)
+        ? (propensity as Record<string, unknown>).vector
+        : undefined;
+    if (!Array.isArray(values) || values.length === 0) {
+      throw new LearningLoopV2InvariantError("CORRUPT_PROPENSITY", "propensity must be a non-empty vector");
+    }
+    let sum = 0;
+    for (const item of values) {
+      if (typeof item !== "number" || !Number.isFinite(item) || item <= 0 || item > 1) {
+        throw new LearningLoopV2InvariantError("CORRUPT_PROPENSITY", "propensity values must be finite and in (0,1]");
+      }
+      sum += item;
+    }
+    if (Math.abs(sum - 1) > 1e-9) {
+      throw new LearningLoopV2InvariantError("CORRUPT_PROPENSITY", "propensity must sum to 1");
+    }
+  }
+}
+
+function assertNoDuplicateJsonKeys(text: string): void {
+  let i = 0;
+  const n = text.length;
+  const isWs = (c: string) => c === " " || c === "\n" || c === "\r" || c === "\t";
+  const peek = () => text[i] ?? "";
+  const skipWs = () => {
+    while (i < n && isWs(text[i])) i += 1;
+  };
+  const parseString = () => {
+    if (peek() !== '"') throw new LearningLoopV2InvariantError("MALFORMED_JSON", "expected string");
+    i += 1;
+    let out = "";
+    while (i < n) {
+      const c = text[i++];
+      if (c === '"') return out;
+      if (c === "\\") {
+        if (i >= n) break;
+        out += text[i++];
+        continue;
+      }
+      out += c;
+    }
+    throw new LearningLoopV2InvariantError("MALFORMED_JSON", "unterminated string");
+  };
+  const parseValue = (): void => {
+    skipWs();
+    const c = peek();
+    if (c === '"') {
+      parseString();
+      return;
+    }
+    if (c === "{") {
+      i += 1;
+      const keys = new Set<string>();
+      skipWs();
+      if (peek() === "}") {
+        i += 1;
+        return;
+      }
+      while (true) {
+        skipWs();
+        const key = parseString();
+        if (keys.has(key)) {
+          throw new LearningLoopV2InvariantError("DUPLICATE_JSON_KEY", `duplicate JSON key ${key}`);
+        }
+        keys.add(key);
+        skipWs();
+        if (peek() !== ":") throw new LearningLoopV2InvariantError("MALFORMED_JSON", "expected colon");
+        i += 1;
+        parseValue();
+        skipWs();
+        if (peek() === ",") {
+          i += 1;
+          continue;
+        }
+        if (peek() === "}") {
+          i += 1;
+          return;
+        }
+        throw new LearningLoopV2InvariantError("MALFORMED_JSON", "expected object delimiter");
+      }
+    }
+    if (c === "[") {
+      i += 1;
+      skipWs();
+      if (peek() === "]") {
+        i += 1;
+        return;
+      }
+      while (true) {
+        parseValue();
+        skipWs();
+        if (peek() === ",") {
+          i += 1;
+          continue;
+        }
+        if (peek() === "]") {
+          i += 1;
+          return;
+        }
+        throw new LearningLoopV2InvariantError("MALFORMED_JSON", "expected array delimiter");
+      }
+    }
+    if (c === "t" || c === "f" || c === "n") {
+      while (i < n && /[a-z]/.test(text[i])) i += 1;
+      return;
+    }
+    if (c === "-" || (c >= "0" && c <= "9")) {
+      const start = i;
+      while (i < n && /[0-9eE+\-.]/.test(text[i])) i += 1;
+      const raw = text.slice(start, i);
+      if (!Number.isFinite(Number(raw))) {
+        throw new LearningLoopV2InvariantError("NON_FINITE_JSON", "JSON numbers must be finite");
+      }
+      return;
+    }
+    throw new LearningLoopV2InvariantError("MALFORMED_JSON", `unexpected token ${c}`);
+  };
+  parseValue();
+  skipWs();
+  if (i !== n) throw new LearningLoopV2InvariantError("MALFORMED_JSON", "trailing JSON content");
+}
+
+export function parseLearningLoopV2Json(text: string): JsonValue {
+  if (typeof text !== "string") {
+    throw new LearningLoopV2InvariantError("MALFORMED_JSON", "expected JSON text");
+  }
+  assertNoDuplicateJsonKeys(text);
+  let parsed: unknown;
+  try {
+    parsed = JSON.parse(text);
+  } catch {
+    throw new LearningLoopV2InvariantError("MALFORMED_JSON", "event JSON is malformed");
+  }
+  return normalizeJson(parsed);
+}
+
+function observationLatch(event: LearningLoopV2Event | undefined): string | null {
+  if (!event) return null;
+  const observation = payloadOf(event).observation;
+  if (!observation || typeof observation !== "object" || Array.isArray(observation)) return null;
+  const latch = (observation as Record<string, JsonValue>).latch;
+  return typeof latch === "string" ? latch : null;
+}
+
+function hasLatchedFailure(actionId: string): boolean {
+  const outcome = findEvent("OUTCOME_RECORDED", (event) => event.actionId === actionId);
+  if (!outcome) return false;
+  return payloadOf(outcome).valid === false && observationLatch(outcome) === "FIRST_FAILURE";
+}
+
+function payloadOf(event: LearningLoopV2Event): Record<string, JsonValue> {
+  const parsed = JSON.parse(event.payload) as unknown;
+  if (!parsed || typeof parsed !== "object" || Array.isArray(parsed)) {
+    throw new LearningLoopV2InvariantError("INVALID_STORED_PAYLOAD", `event ${event.eventId} payload is not an object`);
+  }
+  return parsed as Record<string, JsonValue>;
+}
+
+interface AppendEventInput {
+  eventType: LearningLoopV2EventType;
+  experimentId: string;
+  experimentVersion: string;
+  runId?: string | null;
+  decisionId?: string | null;
+  actionId?: string | null;
+  outcomeId?: string | null;
+  rewardId?: string | null;
+  creditId?: string | null;
+  idempotencyKey: string;
+  payload: Record<string, unknown>;
+  recordedAt?: string;
+}
+
+function semanticEnvelope(input: AppendEventInput, payload: JsonValue) {
+  return {
+    eventType: input.eventType,
+    experimentId: input.experimentId,
+    experimentVersion: input.experimentVersion,
+    runId: input.runId ?? null,
+    decisionId: input.decisionId ?? null,
+    actionId: input.actionId ?? null,
+    outcomeId: input.outcomeId ?? null,
+    rewardId: input.rewardId ?? null,
+    creditId: input.creditId ?? null,
+    payload,
+  };
+}
+
+function appendEvent(input: AppendEventInput): LearningLoopV2Event {
+  assertId("experimentId", input.experimentId);
+  assertId("experimentVersion", input.experimentVersion);
+  assertId("runId", input.runId, true);
+  assertId("decisionId", input.decisionId, true);
+  assertId("actionId", input.actionId, true);
+  assertId("outcomeId", input.outcomeId, true);
+  assertId("rewardId", input.rewardId, true);
+  assertId("creditId", input.creditId, true);
+  assertId("idempotencyKey", input.idempotencyKey);
+
+  const normalizedPayload = normalizeJson(input.payload);
+  if (!normalizedPayload || typeof normalizedPayload !== "object" || Array.isArray(normalizedPayload)) {
+    throw new LearningLoopV2InvariantError("INVALID_PAYLOAD", "event payload must be an object");
+  }
+  const payload = canonicalLearningLoopV2Json(normalizedPayload);
+  const payloadDigest = digest(canonicalLearningLoopV2Json(semanticEnvelope(input, normalizedPayload)));
+
+  return storage.withTransaction!(() => {
+    const existing = storage.getLearningLoopV2EventByIdempotencyKey(input.idempotencyKey);
+    if (existing) {
+      if (existing.payloadDigest !== payloadDigest) {
+        throw new LearningLoopV2InvariantError(
+          "IDEMPOTENCY_CONFLICT",
+          `idempotency key ${input.idempotencyKey} is already bound to another event payload`,
+        );
+      }
+      return existing;
+    }
+
+    const previous = storage.listLearningLoopV2Events().at(-1);
+    const previousEventDigest = previous?.eventDigest ?? null;
+    const recordedAt = input.recordedAt ?? new Date().toISOString();
+    if (Number.isNaN(Date.parse(recordedAt))) {
+      throw new LearningLoopV2InvariantError("INVALID_RECORDED_AT", "recordedAt must be an ISO-compatible timestamp");
+    }
+    const eventId = `evt_${digest(`${input.eventType}:${input.idempotencyKey}`).slice(7, 31)}`;
+    const eventDigest = digest(canonicalLearningLoopV2Json({
+      eventId,
+      payloadDigest,
+      previousEventDigest,
+      recordedAt,
+    }));
+    return storage.appendLearningLoopV2Event({
+      eventId,
+      eventType: input.eventType,
+      experimentId: input.experimentId,
+      experimentVersion: input.experimentVersion,
+      runId: input.runId ?? null,
+      decisionId: input.decisionId ?? null,
+      actionId: input.actionId ?? null,
+      outcomeId: input.outcomeId ?? null,
+      rewardId: input.rewardId ?? null,
+      creditId: input.creditId ?? null,
+      idempotencyKey: input.idempotencyKey,
+      payload,
+      payloadDigest,
+      previousEventDigest,
+      eventDigest,
+      recordedAt,
+    });
+  });
+}
+
+function events(): LearningLoopV2Event[] {
+  return storage.listLearningLoopV2Events();
+}
+
+function findEvent(type: LearningLoopV2EventType, predicate: (event: LearningLoopV2Event) => boolean): LearningLoopV2Event | undefined {
+  return events().find((event) => event.eventType === type && predicate(event));
+}
+
+function requireEvent(type: LearningLoopV2EventType, predicate: (event: LearningLoopV2Event) => boolean, message: string): LearningLoopV2Event {
+  const event = findEvent(type, predicate);
+  if (!event) throw new LearningLoopV2InvariantError("MISSING_PREDECESSOR", message);
+  return event;
+}
+
+function assertSameRun(event: LearningLoopV2Event, runId: string, label: string): void {
+  if (event.runId !== runId) {
+    throw new LearningLoopV2InvariantError("CAUSAL_JOIN_MISMATCH", `${label} belongs to another run`);
+  }
+}
+
+interface BaseInput {
+  experimentId: string;
+  experimentVersion: string;
+  idempotencyKey: string;
+  recordedAt?: string;
+}
+
+export function createLearningLoopV2Experiment(input: BaseInput & { description: string }): LearningLoopV2Event {
+  return appendEvent({
+    ...input,
+    eventType: "EXPERIMENT_CREATED",
+    payload: { description: input.description },
+  });
+}
+
+export function registerLearningLoopV2Version(input: BaseInput & {
+  contractDigest: string;
+  evaluatorDigest: string;
+}): LearningLoopV2Event {
+  requireEvent("EXPERIMENT_CREATED", (event) => event.experimentId === input.experimentId, "experiment must exist before version registration");
+  assertDigest("contractDigest", input.contractDigest);
+  assertDigest("evaluatorDigest", input.evaluatorDigest);
+  return appendEvent({
+    ...input,
+    eventType: "VERSION_REGISTERED",
+    payload: { contractDigest: input.contractDigest, evaluatorDigest: input.evaluatorDigest },
+  });
+}
+
+export function startLearningLoopV2Run(input: BaseInput & {
+  runId: string;
+  seed: string;
+  policyDigest: string;
+}): LearningLoopV2Event {
+  requireEvent(
+    "VERSION_REGISTERED",
+    (event) => event.experimentId === input.experimentId && event.experimentVersion === input.experimentVersion,
+    "registered experiment version must exist before a run starts",
+  );
+  assertDigest("policyDigest", input.policyDigest);
+  return appendEvent({
+    ...input,
+    eventType: "RUN_STARTED",
+    runId: input.runId,
+    payload: { seed: input.seed, policyDigest: input.policyDigest, executionMode: "offline_only" },
+  });
+}
+
+export function recordLearningLoopV2Decision(input: BaseInput & {
+  runId: string;
+  decisionId: string;
+  context: Record<string, unknown>;
+  selectedAction: Record<string, unknown>;
+}): LearningLoopV2Event {
+  const run = requireEvent("RUN_STARTED", (event) => event.runId === input.runId, "run must start before a decision is recorded");
+  if (run.experimentId !== input.experimentId || run.experimentVersion !== input.experimentVersion) {
+    throw new LearningLoopV2InvariantError("VERSION_MISMATCH", "decision experiment identity does not match its run");
+  }
+  assertNoSpoofedAuthority(input.selectedAction);
+  assertPropensityIfPresent({ context: input.context, selectedAction: input.selectedAction });
+  return appendEvent({
+    ...input,
+    eventType: "DECISION_RECORDED",
+    runId: input.runId,
+    decisionId: input.decisionId,
+    payload: { context: input.context, selectedAction: input.selectedAction },
+  });
+}
+
+export function commitLearningLoopV2Action(input: BaseInput & {
+  runId: string;
+  decisionId: string;
+  actionId: string;
+  action: Record<string, unknown>;
+}): LearningLoopV2Event {
+  const decision = requireEvent("DECISION_RECORDED", (event) => event.decisionId === input.decisionId, "decision must exist before action commit");
+  assertSameRun(decision, input.runId, "decision");
+  assertSameExperiment(decision, input, "decision");
+  assertNoSpoofedAuthority(input.action);
+  if (findEvent("ACTION_COMMITTED", (event) => event.decisionId === input.decisionId && event.actionId !== input.actionId)) {
+    throw new LearningLoopV2InvariantError("DUPLICATE_CAUSAL_JOIN", "decision is already joined to another committed action");
+  }
+  return appendEvent({
+    ...input,
+    eventType: "ACTION_COMMITTED",
+    runId: input.runId,
+    decisionId: input.decisionId,
+    actionId: input.actionId,
+    payload: { action: input.action, sideEffectMode: "offline_stub_only" },
+  });
+}
+
+export function authorizeLearningLoopV2Action(input: BaseInput & {
+  runId: string;
+  decisionId: string;
+  actionId: string;
+  authorization: "offline_stub";
+}): LearningLoopV2Event {
+  const committed = requireEvent("ACTION_COMMITTED", (event) => event.actionId === input.actionId, "action must be durably committed before authorization");
+  assertSameRun(committed, input.runId, "action");
+  assertSameExperiment(committed, input, "action");
+  if (committed.decisionId !== input.decisionId) {
+    throw new LearningLoopV2InvariantError("CAUSAL_JOIN_MISMATCH", "action authorization decision does not match the committed action");
+  }
+  if (hasLatchedFailure(input.actionId)) {
+    throw new LearningLoopV2InvariantError("FAILURE_LATCHED", "first hard failure is latched; authorization retry is forbidden");
+  }
+  // appendEvent owns a new transaction. The ACTION_COMMITTED transaction has
+  // already returned, so authorization can never share its durability boundary.
+  return appendEvent({
+    ...input,
+    eventType: "ACTION_AUTHORIZED",
+    runId: input.runId,
+    decisionId: input.decisionId,
+    actionId: input.actionId,
+    payload: { authorization: input.authorization, realSideEffectAllowed: false },
+  });
+}
+
+export function authorizeThenExecuteLearningLoopV2Stub<T>(input: Parameters<typeof authorizeLearningLoopV2Action>[0], executeStub: (authorization: LearningLoopV2Event) => T): T {
+  if (hasLatchedFailure(input.actionId)) {
+    throw new LearningLoopV2InvariantError("FAILURE_LATCHED", "first hard failure is latched; retry is forbidden");
+  }
+  const authorization = authorizeLearningLoopV2Action(input);
+  try {
+    return executeStub(authorization);
+  } catch (error) {
+    try {
+      recordLearningLoopV2Outcome({
+        experimentId: input.experimentId,
+        experimentVersion: input.experimentVersion,
+        runId: input.runId,
+        decisionId: input.decisionId,
+        actionId: input.actionId,
+        outcomeId: `outcome_latch_${input.actionId}`,
+        idempotencyKey: `idem_latch_${input.actionId}`,
+        valid: false,
+        observation: {
+          latch: "FIRST_FAILURE",
+          message: error instanceof Error ? error.message : "stub_failed",
+        },
+      });
+    } catch {
+      // The original failure remains authoritative even if latch persistence races.
+    }
+    throw error;
+  }
+}
+
+export function recordLearningLoopV2Outcome(input: BaseInput & {
+  runId: string;
+  decisionId: string;
+  actionId: string;
+  outcomeId: string;
+  valid: boolean;
+  observation: Record<string, unknown>;
+}): LearningLoopV2Event {
+  const authorization = requireEvent("ACTION_AUTHORIZED", (event) => event.actionId === input.actionId, "action must be authorized before its outcome is recorded");
+  assertSameRun(authorization, input.runId, "authorization");
+  assertSameExperiment(authorization, input, "authorization");
+  if (authorization.decisionId !== input.decisionId) {
+    throw new LearningLoopV2InvariantError("CAUSAL_JOIN_MISMATCH", "outcome decision does not match the authorized action");
+  }
+  return appendEvent({
+    ...input,
+    eventType: "OUTCOME_RECORDED",
+    runId: input.runId,
+    decisionId: input.decisionId,
+    actionId: input.actionId,
+    outcomeId: input.outcomeId,
+    payload: { valid: input.valid, observation: input.observation },
+  });
+}
+
+export interface LearningLoopV2RewardResult {
+  status: "accepted" | "quarantined";
+  event: LearningLoopV2Event;
+  reasons: string[];
+}
+
+export function recordLearningLoopV2Reward(input: BaseInput & {
+  runId: string;
+  decisionId: string;
+  actionId: string;
+  outcomeId: string;
+  rewardId: string;
+  scope: "item" | "slate";
+  value: number;
+}): LearningLoopV2RewardResult {
+  requireEvent("RUN_STARTED", (event) => event.runId === input.runId, "run must exist before reward validation");
+  const existingTerminal = events().find((event) =>
+    (event.eventType === "REWARD_RECORDED" || event.eventType === "REWARD_QUARANTINED") &&
+    (event.rewardId === input.rewardId || event.outcomeId === input.outcomeId),
+  );
+  if (existingTerminal && existingTerminal.idempotencyKey !== input.idempotencyKey) {
+    throw new LearningLoopV2InvariantError("DUPLICATE_REWARD_JOIN", "reward id or outcome is already bound to a terminal reward event");
+  }
+
+  const reasons: string[] = [];
+  const decision = findEvent("DECISION_RECORDED", (event) => event.decisionId === input.decisionId);
+  const action = findEvent("ACTION_COMMITTED", (event) => event.actionId === input.actionId);
+  const outcome = findEvent("OUTCOME_RECORDED", (event) => event.outcomeId === input.outcomeId);
+  if (!decision) {
+    reasons.push("DECISION_JOIN_INVALID");
+  } else {
+    if (decision.runId !== input.runId) reasons.push("CROSS_RUN");
+    if (decision.experimentId !== input.experimentId || decision.experimentVersion !== input.experimentVersion) {
+      reasons.push("VERSION_MISMATCH");
+    }
+  }
+  if (!action || action.decisionId !== input.decisionId) {
+    reasons.push("ACTION_JOIN_INVALID");
+  } else if (action.runId !== input.runId) {
+    reasons.push("CROSS_RUN");
+  }
+  if (!outcome) {
+    reasons.push("OUTCOME_JOIN_INVALID");
+  } else {
+    if (outcome.runId !== input.runId || outcome.actionId !== input.actionId) reasons.push("OUTCOME_JOIN_INVALID");
+    if (outcome.decisionId !== input.decisionId) reasons.push("WRONG_CASE");
+    if (payloadOf(outcome).valid !== true) reasons.push("OUTCOME_INVALID");
+  }
+  if (action && input.recordedAt) {
+    const rewardTs = Date.parse(input.recordedAt);
+    const actionTs = Date.parse(action.recordedAt);
+    if (!Number.isNaN(rewardTs) && !Number.isNaN(actionTs) && rewardTs < actionTs) {
+      reasons.push("LATE_REWARD");
+    }
+  }
+  if (input.scope !== "item") reasons.push("UNSUPPORTED_REWARD_SCOPE");
+  if (!Number.isFinite(input.value)) reasons.push("REWARD_VALUE_INVALID");
+
+  const eventType: LearningLoopV2EventType = reasons.length === 0 ? "REWARD_RECORDED" : "REWARD_QUARANTINED";
+  const event = appendEvent({
+    ...input,
+    eventType,
+    runId: input.runId,
+    decisionId: input.decisionId,
+    actionId: input.actionId,
+    outcomeId: input.outcomeId,
+    rewardId: input.rewardId,
+    payload: {
+      scope: input.scope,
+      value: Number.isFinite(input.value) ? input.value : null,
+      reasons,
+    },
+  });
+  return { status: reasons.length === 0 ? "accepted" : "quarantined", event, reasons };
+}
+
+export function recordLearningLoopV2Credit(input: BaseInput & {
+  runId: string;
+  rewardId: string;
+  creditId: string;
+  creditTarget: string;
+}): LearningLoopV2Event {
+  const reward = findEvent("REWARD_RECORDED", (event) => event.rewardId === input.rewardId);
+  if (!reward) {
+    throw new LearningLoopV2InvariantError("REWARD_NOT_CREDITABLE", "only an accepted reward can receive credit");
+  }
+  assertSameRun(reward, input.runId, "reward");
+  assertSameExperiment(reward, input, "reward");
+  assertWritableIdentity("runId", input.runId);
+  assertWritableIdentity("creditTarget", input.creditTarget);
+  const existingCredit = findEvent("CREDIT_RECORDED", (event) => event.rewardId === input.rewardId);
+  if (existingCredit && existingCredit.idempotencyKey !== input.idempotencyKey) {
+    throw new LearningLoopV2InvariantError("DUPLICATE_CREDIT", "accepted reward already has credit provenance");
+  }
+  assertId("creditTarget", input.creditTarget);
+  return appendEvent({
+    ...input,
+    eventType: "CREDIT_RECORDED",
+    runId: input.runId,
+    decisionId: reward.decisionId,
+    actionId: reward.actionId,
+    outcomeId: reward.outcomeId,
+    rewardId: input.rewardId,
+    creditId: input.creditId,
+    payload: {
+      creditTarget: input.creditTarget,
+      rewardEventDigest: reward.eventDigest,
+      learnerUpdateApplied: false,
+    },
+  });
+}
+
+export function verifyLearningLoopV2LedgerIntegrity(): { eventCount: number; headDigest: string | null } {
+  let previousEventDigest: string | null = null;
+  const allEvents = events();
+  for (const event of allEvents) {
+    const normalizedPayload = normalizeJson(payloadOf(event));
+    const expectedPayloadDigest = digest(canonicalLearningLoopV2Json(semanticEnvelope({
+      eventType: event.eventType as LearningLoopV2EventType,
+      experimentId: event.experimentId,
+      experimentVersion: event.experimentVersion,
+      runId: event.runId,
+      decisionId: event.decisionId,
+      actionId: event.actionId,
+      outcomeId: event.outcomeId,
+      rewardId: event.rewardId,
+      creditId: event.creditId,
+      idempotencyKey: event.idempotencyKey,
+      payload: payloadOf(event),
+      recordedAt: event.recordedAt,
+    }, normalizedPayload)));
+    if (event.payloadDigest !== expectedPayloadDigest || event.previousEventDigest !== previousEventDigest) {
+      throw new LearningLoopV2InvariantError("LEDGER_INTEGRITY_FAILURE", `event ${event.eventId} breaks the payload or chain digest`);
+    }
+    const expectedEventDigest = digest(canonicalLearningLoopV2Json({
+      eventId: event.eventId,
+      payloadDigest: event.payloadDigest,
+      previousEventDigest,
+      recordedAt: event.recordedAt,
+    }));
+    if (event.eventDigest !== expectedEventDigest) {
+      throw new LearningLoopV2InvariantError("LEDGER_INTEGRITY_FAILURE", `event ${event.eventId} digest does not match its content`);
+    }
+    previousEventDigest = event.eventDigest;
+  }
+  return { eventCount: allEvents.length, headDigest: previousEventDigest };
+}
+
+export function rebuildLearningLoopV2Projection(runId: string) {
+  assertId("runId", runId);
+  const integrity = verifyLearningLoopV2LedgerIntegrity();
+  const runEvents = storage.listLearningLoopV2Events(runId);
+  const run = runEvents.find((event) => event.eventType === "RUN_STARTED");
+  if (!run) throw new LearningLoopV2InvariantError("RUN_NOT_FOUND", `run ${runId} does not exist`);
+  const grouped = {
+    decisions: runEvents.filter((event) => event.eventType === "DECISION_RECORDED"),
+    committedActions: runEvents.filter((event) => event.eventType === "ACTION_COMMITTED"),
+    authorizedActions: runEvents.filter((event) => event.eventType === "ACTION_AUTHORIZED"),
+    outcomes: runEvents.filter((event) => event.eventType === "OUTCOME_RECORDED"),
+    acceptedRewards: runEvents.filter((event) => event.eventType === "REWARD_RECORDED"),
+    quarantinedRewards: runEvents.filter((event) => event.eventType === "REWARD_QUARANTINED"),
+    credits: runEvents.filter((event) => event.eventType === "CREDIT_RECORDED"),
+  };
+  const projection = {
+    runId,
+    experimentId: run.experimentId,
+    experimentVersion: run.experimentVersion,
+    eventSequences: runEvents.map((event) => event.sequence),
+    ...grouped,
+    ledgerEventCount: integrity.eventCount,
+    ledgerHeadDigest: integrity.headDigest,
+  };
+  return {
+    ...projection,
+    projectionDigest: digest(canonicalLearningLoopV2Json(projection)),
+  };
+}
+
+export function assertLearningLoopV2ActionBeforeDispatch(input: {
+  experimentId: string;
+  experimentVersion: string;
+  runId: string;
+  actionId: string;
+}): { realSideEffectAllowed: false; actionDigest: string } {
+  if (hasLatchedFailure(input.actionId)) {
+    throw new LearningLoopV2InvariantError("FAILURE_LATCHED", "first hard failure is latched; dispatch is forbidden");
+  }
+  const committed = findEvent("ACTION_COMMITTED", (event) => event.actionId === input.actionId);
+  if (!committed) {
+    throw new LearningLoopV2InvariantError("PROVIDER_WITHOUT_ACTION", "provider dispatch requires a committed action event");
+  }
+  assertSameRun(committed, input.runId, "action");
+  assertSameExperiment(committed, input, "action");
+  const authorized = findEvent("ACTION_AUTHORIZED", (event) => event.actionId === input.actionId);
+  if (!authorized) {
+    throw new LearningLoopV2InvariantError("MISSING_PREDECESSOR", "action must be authorized before dispatch binding");
+  }
+  if (payloadOf(authorized).realSideEffectAllowed !== false) {
+    throw new LearningLoopV2InvariantError("PROVIDER_WITHOUT_ACTION", "real provider side effects are forbidden");
+  }
+  return { realSideEffectAllowed: false, actionDigest: committed.eventDigest };
+}
