+import assert from "node:assert/strict";
+import { mkdtempSync, readFileSync } from "node:fs";
+import { tmpdir } from "node:os";
+import { join } from "node:path";
+import { test } from "node:test";
+import type { AgentContext, LLMProvider, LLMResponse } from "../../alaya-core/src/llm/provider.ts";
+import { buildFrozenDataset, datasetInvariants, enumerateLabeledUniverse, renderDecisionPrompt } from "./dataset.ts";
+import {
+  actualProviderRequests,
+  allowedIdsFromSnapshot,
+  assembleDecisionRequest,
+  assembleDistillRequest,
+  freezeParsedKnowledge,
+  parseDistillOutput,
+  runM1,
+  scoreDecision,
+} from "./runner.ts";
+
+function scriptedResponse(data: Record<string, unknown>, extra: Partial<LLMResponse> = {}): LLMResponse {
+  const retryCount = extra.retryCount ?? extra.log?.retryCount ?? 0;
+  return {
+    schemaValid: extra.schemaValid ?? true,
+    retryCount,
+    data,
+    degradedToHumanGate: extra.degradedToHumanGate ?? false,
+    errorMessage: extra.errorMessage,
+    log: extra.log ?? {
+      provider: "scripted",
+      agent: "scripted",
+      promptVersion: "alaya-m1-decision-v1",
+      inputSummary: "",
+      outputSummary: "",
+      schemaValid: extra.schemaValid ?? true,
+      retryCount,
+      latencyMs: 0,
+      tokenCount: 8,
+      estimatedCost: 0,
+      ts: new Date().toISOString(),
+    },
+  };
+}
+
+class ScriptedProvider implements LLMProvider {
+  name = "scripted";
+  requests: AgentContext[] = [];
+  constructor(private handler: (request: AgentContext, index: number) => LLMResponse) {}
+  async call(request: AgentContext): Promise<LLMResponse> {
+    this.requests.push(request);
+    return this.handler(request, this.requests.length - 1);
+  }
+}
+
+function tmpRunRoot(): string {
+  return mkdtempSync(join(tmpdir(), "alaya-m1-"));
+}
+
+const emptyK = freezeParsedKnowledge("K2", []);
+const realK = freezeParsedKnowledge("K2", [{
+  id: "exp_k1",
+  condition: "quality plus revision",
+  judgment: "increase_long",
+  exception: "risk budget tight",
+  sourceTrainIds: ["train-1"],
+  status: "experimental_only",
+}]);
+
+test("dataset labels are unique, splits do not overlap, and hashes are stable", () => {
+  const first = buildFrozenDataset();
+  const second = buildFrozenDataset();
+  assert.deepEqual(datasetInvariants(first), []);
+  assert.equal(first.items.length, 80);
+  assert.ok(new Set(first.items.map((item) => item.label)).size >= 2);
+  assert.equal(first.hashes.visible, second.hashes.visible);
+  assert.equal(enumerateLabeledUniverse().length, 4096);
+});
+
+test("changing a hidden label does not change the decision request", () => {
+  const item = buildFrozenDataset().items[0]!;
+  const original = assembleDecisionRequest(item, null);
+  const flipped = { ...item, label: item.label === "avoid_trade" ? "short_bias" as const : "avoid_trade" as const, ruleId: "TAMPER", split: item.split === "train" ? "test" as const : "train" as const };
+  assert.deepEqual(assembleDecisionRequest(flipped, null), original);
+  const blob = JSON.stringify(original);
+  assert.equal(blob.includes("expectedDecision"), false);
+  assert.equal(blob.includes("oracle"), false);
+});
+
+test("signal ids are rejected, legal knowledge ids are accepted, A and empty B match", () => {
+  const item = buildFrozenDataset().items[0]!;
+  const aReq = assembleDecisionRequest(item, null);
+  const emptyReq = assembleDecisionRequest(item, emptyK);
+  assert.deepEqual(aReq.context, emptyReq.context);
+  assert.equal(aReq.knowledgeSummary, emptyReq.knowledgeSummary);
+  assert.deepEqual((aReq.context as { allowedKnowledgeIds: string[] }).allowedKnowledgeIds, []);
+  const raw = { decision: "avoid_trade", confidence: 0.4, knowledgeRefs: [] };
+  const aScore = scoreDecision({ data: raw, label: "avoid_trade", allowedKnowledgeIds: [], providerFailed: false });
+  const bScore = scoreDecision({ data: raw, label: "avoid_trade", allowedKnowledgeIds: allowedIdsFromSnapshot(emptyK), providerFailed: false });
+  assert.equal(aScore.contractValid, bScore.contractValid);
+  assert.equal(aScore.correct, bScore.correct);
+  const signalRef = scoreDecision({ data: { decision: "avoid_trade", confidence: 0.4, knowledgeRefs: ["earnings_revision"] }, label: "avoid_trade", allowedKnowledgeIds: [], providerFailed: false });
+  assert.equal(signalRef.contractValid, false);
+  assert.equal(signalRef.errorType, "signal_id_as_knowledge_ref");
+  assert.equal(signalRef.actionCorrect, 1);
+  const legal = scoreDecision({ data: { decision: "increase_long", confidence: 0.5, knowledgeRefs: ["exp_k1"] }, label: "increase_long", allowedKnowledgeIds: ["exp_k1"], providerFailed: false });
+  assert.equal(legal.contractValid, true);
+  assert.equal(legal.correct, 1);
+});
+
+test("distill empty list, missing items, empty object item, and degrade are distinct", () => {
+  const allowed = ["t1"];
+  const empty = parseDistillOutput({ response: scriptedResponse({ items: [] }), allowedSourceIds: allowed, version: "K2" });
+  assert.equal(empty.status, "empty_candidate");
+  const missing = parseDistillOutput({ response: scriptedResponse({ summary: "nope" }), allowedSourceIds: allowed, version: "K2" });
+  assert.equal(missing.status, "contract_failure");
+  if (missing.status === "contract_failure") assert.equal(missing.reason, "missing_items");
+  const badItem = parseDistillOutput({ response: scriptedResponse({ items: [{}] }), allowedSourceIds: allowed, version: "K2" });
+  assert.equal(badItem.status, "contract_failure");
+  const degraded = parseDistillOutput({
+    response: scriptedResponse({ summary: "fail" }, { degradedToHumanGate: true, errorMessage: "upstream", schemaValid: false }),
+    allowedSourceIds: allowed,
+    version: "K2",
+  });
+  assert.equal(degraded.status, "provider_failure");
+  assert.notEqual(empty.status, missing.status);
+  assert.notEqual(missing.status, badItem.status === "contract_failure" ? "same-family" : badItem.status);
+  assert.notEqual(empty.status, degraded.status);
+  assert.notEqual(missing.status, degraded.status);
+});
+
+test("K2 empty candidate does not issue Dev provider calls", async () => {
+  const provider = new ScriptedProvider((request) => {
+    if (request.role === "distiller") return scriptedResponse({ items: [] });
+    return scriptedResponse({ decision: "avoid_trade", confidence: 0.2, knowledgeRefs: [] });
+  });
+  const result = await runM1({ engineering: true, provider, outRoot: tmpRunRoot(), runId: "empty-k2" });
+  assert.equal(result.status, "NO_CANDIDATE");
+  assert.equal(result.devCalls, 0);
+  assert.equal(result.requests.filter((request) => (request.context as { phase?: string }).phase === "dev").length, 0);
+  assert.equal(provider.requests.filter((request) => request.role === "orchestrator" && JSON.stringify(request).includes("\"dev\"")).length, 0);
+  const distill = result.requests.filter((request) => request.role === "distiller");
+  const trainIds = new Set(result.dataset.items.filter((item) => item.split === "train").map((item) => item.id));
+  for (const request of distill) {
+    const feedback = (request.context as { feedback: Array<{ id: string }> }).feedback;
+    for (const row of feedback) assert.equal(trainIds.has(row.id), true);
+  }
+});
+
+test("sent knowledge matches snapshot, swapped hash stops, and mockData/oracle are absent", async () => {
+  const provider = new ScriptedProvider((request) => {
+    if (request.role === "distiller") {
+      const allowed = (request.context as { allowedSourceIds: string[] }).allowedSourceIds;
+      return scriptedResponse({
+        items: [{ id: "exp_k1", condition: "revision without cut", judgment: "increase_long", exception: "guidance_cut", sourceTrainIds: [allowed[0]] }],
+      });
+    }
+    const allowed = (request.context as { allowedKnowledgeIds: string[] }).allowedKnowledgeIds;
+    return scriptedResponse({ decision: "avoid_trade", confidence: 0.3, knowledgeRefs: allowed });
+  });
+  const ok = await runM1({ engineering: true, provider, outRoot: tmpRunRoot(), runId: "bind-ok" });
+  if (ok.status === "NO_SIGNAL_ON_DEV" || ok.status === "PROMISING" || ok.status === "NO_CLEAR_GAIN") {
+    const bReqs = ok.requests.filter((request) => request.role === "orchestrator" && request.knowledgeSummary);
+    assert.ok(bReqs.length > 0);
+    assert.ok(bReqs.every((request) => request.knowledgeSummary === ok.k2?.rendered));
+  }
+  const swapped = await runM1({ engineering: true, provider, outRoot: tmpRunRoot(), runId: "bind-bad", snapshotHashOverride: "deadbeef" });
+  assert.equal(swapped.status, "INVALID");
+  assert.match(String(swapped.reason), /snapshot hash mismatch/);
+  assert.ok(ok.requests.every((request) => request.mockData === undefined));
+  assert.equal(JSON.stringify(ok.requests).includes("oracle"), false);
+});
+
+test("budget counts internal retries and keeps evidence", async () => {
+  const provider = new ScriptedProvider(() => scriptedResponse({ decision: "avoid_trade", confidence: 0.1, knowledgeRefs: [] }, { retryCount: 2 }));
+  assert.equal(actualProviderRequests(scriptedResponse({ ok: true }, { retryCount: 2 })), 3);
+  const result = await runM1({
+    engineering: true,
+    provider,
+    outRoot: tmpRunRoot(),
+    runId: "budget-stop",
+    budget: { maxProviderRequests: 3, maxTokens: 500000 },
+  });
+  assert.equal(result.status, "BLOCKED");
+  assert.equal(result.budget.requests >= 3, true);
+  assert.ok(readFileSync(join(result.runDir, "evidence.jsonl"), "utf8").trim().length > 0);
+  assert.equal(readFileSync(join(result.runDir, "evidence.jsonl"), "utf8").includes("Authorization"), false);
+});
+
+test("unauthorized run does not call a provider", async () => {
+  let called = 0;
+  const provider = new ScriptedProvider(() => {
+    called += 1;
+    return scriptedResponse({ decision: "avoid_trade", confidence: 0.1, knowledgeRefs: [] });
+  });
+  const result = await runM1({ provider, outRoot: tmpRunRoot(), runId: "ready" });
+  assert.equal(result.status, "READY_FOR_AUTHORIZED_RUN");
+  assert.equal(called, 0);
+});
+
+test("provider failure does not fill an oracle answer", async () => {
+  const oracle = buildFrozenDataset().items[0]!.label;
+  const provider = new ScriptedProvider(() => scriptedResponse(
+    { decision: oracle, confidence: 1, knowledgeRefs: [] },
+    { degradedToHumanGate: true, errorMessage: "upstream failed", schemaValid: false },
+  ));
+  const result = await runM1({ engineering: true, provider, outRoot: tmpRunRoot(), runId: "fail-no-fill" });
+  assert.ok(result.requests.every((request) => request.mockData === undefined));
+  assert.ok(result.k1Outcome?.status === "provider_failure" || result.status === "BLOCKED");
+});
+
