+
+const CANONICAL_SIGNALS = [
+  { id: "earnings_revision", polarity: "positive", kind: "fundamental" },
+  { id: "margin_repair", polarity: "positive", kind: "fundamental" },
+  { id: "cash_flow_quality", polarity: "positive", kind: "quality" },
+  { id: "valuation_discount", polarity: "positive", kind: "valuation" },
+  { id: "upside_catalyst", polarity: "positive", kind: "catalyst" },
+  { id: "short_crowding", polarity: "positive", kind: "positioning" },
+  { id: "guidance_cut", polarity: "negative", kind: "fundamental" },
+  { id: "liquidity_risk", polarity: "negative", kind: "balance_sheet" },
+  { id: "event_risk", polarity: "negative", kind: "risk" },
+  { id: "drawdown_pressure", polarity: "negative", kind: "technical" },
+  { id: "regulatory_risk", polarity: "negative", kind: "risk" },
+  { id: "risk_budget_tight", polarity: "negative", kind: "portfolio" },
+] as const;
+
+const RULE_BLUEPRINTS = [
+  { id: "R1", decision: "increase_long", requiredPolarity: "positive", requiredCount: 3, avoidPolarity: "negative", avoidCount: 1, confidence: 0.82 },
+  { id: "R2", decision: "maintain_long", requiredPolarity: "positive", requiredCount: 2, avoidPolarity: "negative", avoidCount: 2, confidence: 0.69 },
+  { id: "R3", decision: "reduce_exposure", requiredPolarity: "negative", requiredCount: 2, avoidPolarity: "positive", avoidCount: 1, confidence: 0.75 },
+  { id: "R4", decision: "avoid_trade", requiredPolarity: "mixed", requiredCount: 3, avoidPolarity: "none", avoidCount: 0, confidence: 0.61 },
+  { id: "R5", decision: "short_bias", requiredPolarity: "negative", requiredCount: 3, avoidPolarity: "positive", avoidCount: 1, confidence: 0.84 },
+  { id: "R6", decision: "increase_long", requiredPolarity: "positive", requiredCount: 2, avoidPolarity: "negative", avoidCount: 2, confidence: 0.78 },
+  { id: "R7", decision: "reduce_exposure", requiredPolarity: "negative", requiredCount: 2, avoidPolarity: "none", avoidCount: 0, confidence: 0.72 },
+  { id: "R8", decision: "avoid_trade", requiredPolarity: "mixed", requiredCount: 4, avoidPolarity: "none", avoidCount: 0, confidence: 0.58 },
+] as const;
+
+export type Split = "train" | "dev" | "test";
+
+export type WorldRule = {
+  id: string;
+  ruleRef: string;
+  priority: number;
+  decision: Decision;
+  requiredSignals: string[];
+  avoidSignals: string[];
+  confidenceBase: number;
+  rationaleTemplateIndex: number;
+};
+
+export type DomainConfig = {
+  domainId: string;
+  caseStyle: { task: string; confidencePrompt: string };
+  signalSkins: Record<string, { label: string; text: string; kind: string; polarity: string }>;
+  decisionSkins: Record<string, { label: string; direction: string; text: string }>;
+};
+
+export type M1Item = {
+  id: string;
+  signalKey: string;
+  signalsPresent: SignalId[];
+  label: Decision;
+  ruleId: string | null;
+  split: Split;
+};
+
+export type FrozenDataset = {
+  protocolId: string;
+  sampleSeed: string;
+  worldSeed: string;
+  rules: WorldRule[];
+  items: M1Item[];
+  hashes: {
+    rules: string;
+    visible: string;
+    labels: string;
+    partitions: string;
+  };
+};
+
+export function sha256(value: unknown): string {
+  return createHash("sha256").update(stableStringify(value)).digest("hex");
+}
+
+export function stableStringify(value: unknown): string {
+  if (value === null || typeof value !== "object") return JSON.stringify(value);
+  if (Array.isArray(value)) return "[" + value.map(stableStringify).join(",") + "]";
+  const obj = value as Record<string, unknown>;
+  const keys = Object.keys(obj).sort();
+  return "{" + keys.map((key) => JSON.stringify(key) + ":" + stableStringify(obj[key])).join(",") + "}";
+}
+
+function hashString(input: string): number {
+  let hash = 2166136261;
+  for (let index = 0; index < input.length; index += 1) {
+    hash ^= input.charCodeAt(index);
+    hash = Math.imul(hash, 16777619);
+  }
+  return hash >>> 0;
+}
+
+export function createSeededRng(seed: string): () => number {
+  let state = hashString(String(seed));
+  return function rng() {
+    state += 0x6d2b79f5;
+    let mixed = state;
+    mixed = Math.imul(mixed ^ (mixed >>> 15), mixed | 1);
+    mixed ^= mixed + Math.imul(mixed ^ (mixed >>> 7), mixed | 61);
+    return ((mixed ^ (mixed >>> 14)) >>> 0) / 4294967296;
+  };
+}
+
+export function stableShuffle<T>(items: readonly T[], seed: string): T[] {
+  const rng = createSeededRng(seed);
+  const shuffled = [...items];
+  for (let index = shuffled.length - 1; index > 0; index -= 1) {
+    const swapIndex = Math.floor(rng() * (index + 1));
+    [shuffled[index], shuffled[swapIndex]] = [shuffled[swapIndex], shuffled[index]];
+  }
+  return shuffled;
+}
+
+function takeSignals(args: {
+  worldSeed: string;
+  ruleIndex: number;
+  polarity: string;
+  count: number;
+  excludeIds?: string[];
+}): Array<{ id: string }> {
+  const { worldSeed, ruleIndex, polarity, count, excludeIds = [] } = args;
+  if (count === 0 || polarity === "none") return [];
+  const excluded = new Set(excludeIds);
+  let pool = CANONICAL_SIGNALS.filter((signal) => !excluded.has(signal.id));
+  if (polarity === "positive" || polarity === "negative") {
+    pool = pool.filter((signal) => signal.polarity === polarity);
+  }
+  if (polarity === "mixed") {
+    const positives = stableShuffle(
+      CANONICAL_SIGNALS.filter((signal) => signal.polarity === "positive" && !excluded.has(signal.id)),
+      worldSeed + ":rule:" + ruleIndex + ":mixed:positive",
+    );
+    const negatives = stableShuffle(
+      CANONICAL_SIGNALS.filter((signal) => signal.polarity === "negative" && !excluded.has(signal.id)),
+      worldSeed + ":rule:" + ruleIndex + ":mixed:negative",
+    );
+    const mixed: Array<{ id: string }> = [];
+    while (mixed.length < count && (positives.length > 0 || negatives.length > 0)) {
+      if (positives.length > 0) mixed.push(positives.shift()!);
+      if (mixed.length < count && negatives.length > 0) mixed.push(negatives.shift()!);
+    }
+    return mixed.slice(0, count);
+  }
+  return stableShuffle(pool, worldSeed + ":rule:" + ruleIndex + ":" + polarity).slice(0, count);
+}
+
+/** Bound to learning-loop@b7090b11 buildWorldRules. New protocol only reuses this pure rule builder. */
+export function buildWorldRules({ worldSeed = WORLD_SEED }: { worldSeed?: string } = {}): WorldRule[] {
+  return RULE_BLUEPRINTS.map((blueprint, index) => {
+    const requiredSignals = takeSignals({
+      worldSeed,
+      ruleIndex: index,
+      polarity: blueprint.requiredPolarity,
+      count: blueprint.requiredCount,
+    });
+    const avoidSignals = takeSignals({
+      worldSeed,
+      ruleIndex: index,
+      polarity: blueprint.avoidPolarity,
+      count: blueprint.avoidCount,
+      excludeIds: requiredSignals.map((signal) => signal.id),
+    });
+    const salt = hashString(worldSeed + ":" + blueprint.id + ":" + requiredSignals.map((signal) => signal.id).join(","));
+    const familyDecisions = blueprint.requiredPolarity === "positive"
+      ? ["increase_long", "maintain_long"]
+      : blueprint.requiredPolarity === "negative"
+        ? ["reduce_exposure", "short_bias"]
+        : ["avoid_trade"];
+    const decision = familyDecisions.includes(blueprint.decision)
+      ? familyDecisions[salt % familyDecisions.length]
+      : blueprint.decision;
+    return {
+      id: blueprint.id,
+      ruleRef: String(worldSeed) + ":" + blueprint.id,
+      priority: index + 1,
+      decision: decision as Decision,
+      requiredSignals: requiredSignals.map((signal) => signal.id),
+      avoidSignals: avoidSignals.map((signal) => signal.id),
+      confidenceBase: blueprint.confidence,
+      rationaleTemplateIndex: salt % 5,
+    };
+  });
+}
+
+export function adjudicate(
+  present: Iterable<string>,
+  rules: WorldRule[],
+): { decision: Decision; ruleId: string | null } {
+  const signals = present instanceof Set ? present : new Set(present);
+  for (const rule of rules) {
+    const requiredOk = rule.requiredSignals.every((id) => signals.has(id));
+    const avoidOk = rule.avoidSignals.every((id) => !signals.has(id));
+    if (requiredOk && avoidOk) return { decision: rule.decision, ruleId: rule.id };
+  }
+  return { decision: "avoid_trade", ruleId: null };
+}
+
+export function loadDomainConfig(): DomainConfig {
+  return JSON.parse(readFileSync(new URL("./domain.json", import.meta.url), "utf8")) as DomainConfig;
+}
+
+export function signalKey(present: Iterable<string>): string {
+  const set = new Set(present);
+  return SIGNAL_IDS.map((id) => (set.has(id) ? "1" : "0")).join("");
+}
+
+export function presentFromKey(key: string): SignalId[] {
+  return SIGNAL_IDS.filter((_, index) => key[index] === "1");
+}
+
+export function publicItemId(key: string): string {
+  return "m1_" + sha256({ k: key }).slice(0, 16);
+}
+
+export function enumerateLabeledUniverse(rules = buildWorldRules()): Array<Omit<M1Item, "split">> {
+  const items: Array<Omit<M1Item, "split">> = [];
+  const seen = new Map<string, Decision>();
+  for (let mask = 0; mask < 2 ** SIGNAL_IDS.length; mask += 1) {
+    const present = SIGNAL_IDS.filter((_, index) => (mask & (1 << index)) !== 0);
+    const key = signalKey(present);
+    const { decision, ruleId } = adjudicate(present, rules);
+    const prior = seen.get(key);
+    if (prior && prior !== decision) {
+      throw new Error("label conflict for " + key + ": " + prior + " vs " + decision);
+    }
+    seen.set(key, decision);
+    items.push({
+      id: publicItemId(key),
+      signalKey: key,
+      signalsPresent: present,
+      label: decision,
+      ruleId,
+    });
+  }
+  return items;
+}
+
+function groupByLabel<T extends { label: Decision }>(items: T[]): Map<Decision, T[]> {
+  const groups = new Map<Decision, T[]>();
+  for (const item of items) {
+    const list = groups.get(item.label) ?? [];
+    list.push(item);
+    groups.set(item.label, list);
+  }
+  return groups;
+}
+
+function sampleStratified<T extends { label: Decision; signalKey: string }>(
+  items: T[],
+  seed: string,
+  n: number,
+): T[] {
+  const groups = groupByLabel(items);
+  if (groups.size < 2) throw new Error("dataset degenerated to fewer than two action classes");
+  const classes = [...groups.keys()].sort();
+  const sizes = classes.map((cls) => groups.get(cls)!.length);
+  const total = sizes.reduce((sum, size) => sum + size, 0);
+  const alloc = classes.map((cls, index) => Math.min(groups.get(cls)!.length, Math.floor((n * sizes[index]) / total)));
+  let leftover = n - alloc.reduce((sum, size) => sum + size, 0);
+  const order = classes
+    .map((_, index) => index)
+    .sort((a, b) => sizes[b] - sizes[a] || classes[a].localeCompare(classes[b]));
+  let guard = 0;
+  while (leftover > 0 && guard < 10_000) {
+    guard += 1;
+    let progressed = false;
+    for (const index of order) {
+      if (leftover <= 0) break;
+      if (alloc[index] < groups.get(classes[index])!.length) {
+        alloc[index] += 1;
+        leftover -= 1;
+        progressed = true;
+      }
+    }
+    if (!progressed) break;
+  }
+  if (leftover !== 0) throw new Error("could not allocate stratified sample");
+  const picked: T[] = [];
+  classes.forEach((cls, index) => {
+    const shuffled = stableShuffle(groups.get(cls)!, seed + ":class:" + cls);
+    picked.push(...shuffled.slice(0, alloc[index]));
+  });
+  return stableShuffle(picked, seed + ":picked");
+}
+
+function splitStratified(items: Array<Omit<M1Item, "split">>, seed: string): M1Item[] {
+  const groups = groupByLabel(items);
+  const assigned: M1Item[] = [];
+  const pattern: Split[] = ["train", "train", "dev", "test"];
+  for (const cls of [...groups.keys()].sort()) {
+    const shuffled = stableShuffle(groups.get(cls)!, seed + ":split:" + cls);
+    shuffled.forEach((item, index) => {
+      assigned.push({ ...item, split: pattern[index % pattern.length] });
+    });
+  }
+  const counts: Record<Split, number> = { train: 0, dev: 0, test: 0 };
+  for (const item of assigned) counts[item.split] += 1;
+  const target: Record<Split, number> = { train: 40, dev: 20, test: 20 };
+  const move = (from: Split, to: Split) => {
+    const candidate = assigned.find((item) => item.split === from);
+    if (!candidate) return false;
+    candidate.split = to;
+    counts[from] -= 1;
+    counts[to] += 1;
+    return true;
+  };
+  let guard = 0;
+  while ((counts.train !== 40 || counts.dev !== 20 || counts.test !== 20) && guard < 10_000) {
+    guard += 1;
+    if (counts.train > target.train && counts.dev < target.dev) move("train", "dev");
+    else if (counts.train > target.train && counts.test < target.test) move("train", "test");
+    else if (counts.dev > target.dev && counts.train < target.train) move("dev", "train");
+    else if (counts.dev > target.dev && counts.test < target.test) move("dev", "test");
+    else if (counts.test > target.test && counts.train < target.train) move("test", "train");
+    else if (counts.test > target.test && counts.dev < target.dev) move("test", "dev");
+    else break;
+  }
+  if (counts.train !== 40 || counts.dev !== 20 || counts.test !== 20) {
+    throw new Error("split counts drifted: " + JSON.stringify(counts));
+  }
+  const order: Record<Split, number> = { train: 0, dev: 1, test: 2 };
+  return assigned.sort((a, b) => order[a.split] - order[b.split] || a.signalKey.localeCompare(b.signalKey));
+}
+
+export function buildFrozenDataset(): FrozenDataset {
+  const rules = buildWorldRules({ worldSeed: WORLD_SEED });
+  const universe = enumerateLabeledUniverse(rules);
+  const sampled = sampleStratified(universe, SAMPLE_SEED, 80);
+  const items = splitStratified(sampled, SAMPLE_SEED + ":split");
+  const classes = new Set(items.map((item) => item.label));
+  if (classes.size < 2) throw new Error("sampled dataset has fewer than two action classes");
+  return {
+    protocolId: PROTOCOL_ID,
+    sampleSeed: SAMPLE_SEED,
+    worldSeed: WORLD_SEED,
+    rules,
+    items,
+    hashes: hashDataset(rules, items),
+  };
+}
+
+export function hashDataset(rules: WorldRule[], items: M1Item[]): FrozenDataset["hashes"] {
+  const bySplit = (split: Split) => items.filter((item) => item.split === split).map((item) => item.signalKey).sort();
+  return {
+    rules: sha256(rules),
+    visible: sha256(items.map((item) => ({ id: item.id, signalKey: item.signalKey, signalsPresent: item.signalsPresent }))),
+    labels: sha256(items.map((item) => ({ id: item.id, label: item.label, ruleId: item.ruleId }))),
+    partitions: sha256({ train: bySplit("train"), dev: bySplit("dev"), test: bySplit("test") }),
+  };
+}
+
+export function actionCatalog(domain = loadDomainConfig()) {
+  return DECISIONS.map((id) => ({
+    id,
+    label: domain.decisionSkins[id]?.label ?? id,
+    text: domain.decisionSkins[id]?.text ?? id,
+  }));
+}
+
+export function visibleSignals(item: Pick<M1Item, "signalsPresent">, domain = loadDomainConfig()) {
+  return item.signalsPresent.map((id) => ({
+    id,
+    label: domain.signalSkins[id]?.label ?? id,
+    text: domain.signalSkins[id]?.text ?? id,
+  }));
+}
+
+export function renderDecisionPrompt(item: Pick<M1Item, "signalsPresent">, domain = loadDomainConfig()) {
+  return {
+    task: [
+      domain.caseStyle.task,
+      "Choose exactly one action from the provided action set.",
+      "This is a synthetic rule-learning task, not investment advice.",
+      "No files, network, git, or other tools are available.",
+    ].join(" "),
+    context: {
+      actions: actionCatalog(domain),
+      signals: visibleSignals(item, domain),
+    },
+  };
+}
+
+export function datasetInvariants(dataset: FrozenDataset): string[] {
+  const errors: string[] = [];
+  const keys = new Set<string>();
+  const labels = new Map<string, Decision>();
+  const splitKeys: Record<Split, Set<string>> = { train: new Set(), dev: new Set(), test: new Set() };
+  const classSet = new Set<Decision>();
+  for (const item of dataset.items) {
+    classSet.add(item.label);
+    if (keys.has(item.signalKey)) errors.push("duplicate signal set " + item.signalKey);
+    keys.add(item.signalKey);
+    const prior = labels.get(item.signalKey);
+    if (prior && prior !== item.label) errors.push("conflicting labels for " + item.signalKey);
+    labels.set(item.signalKey, item.label);
+    splitKeys[item.split].add(item.signalKey);
+    const recomputed = adjudicate(item.signalsPresent, dataset.rules);
+    if (recomputed.decision !== item.label) {
+      errors.push("label drift on " + item.id + ": " + item.label + " vs " + recomputed.decision);
+    }
+  }
+  const counts = {
+    train: dataset.items.filter((item) => item.split === "train").length,
+    dev: dataset.items.filter((item) => item.split === "dev").length,
+    test: dataset.items.filter((item) => item.split === "test").length,
+  };
+  if (dataset.items.length !== 80) errors.push("expected 80 items, got " + String(dataset.items.length));
+  if (counts.train !== 40 || counts.dev !== 20 || counts.test !== 20) errors.push("bad split " + JSON.stringify(counts));
+  if (classSet.size < 2) errors.push("fewer than two action classes");
+  for (const a of ["train", "dev", "test"] as Split[]) {
+    for (const b of ["train", "dev", "test"] as Split[]) {
+      if (a >= b) continue;
+      for (const key of splitKeys[a]) {
+        if (splitKeys[b].has(key)) errors.push("signal set " + key + " appears in " + a + " and " + b);
+      }
+    }
+  }
+  const hashed = hashDataset(dataset.rules, dataset.items);
+  if (hashed.visible !== dataset.hashes.visible) errors.push("visible hash mismatch");
+  if (hashed.labels !== dataset.hashes.labels) errors.push("label hash mismatch");
+  if (hashed.partitions !== dataset.hashes.partitions) errors.push("partition hash mismatch");
+  return errors;
+}
+
