+import {
+  OpenAIProvider,
+  resolveOpenAIApiKey,
+  type AgentContext,
+  type JsonSchema,
+  type LLMProvider,
+  type LLMResponse,
+} from "../../alaya-core/src/llm/provider.ts";
+import {
+  DECISIONS,
+  SAMPLE_SEED,
+  WORLD_SEED,
+  PROTOCOL_ID,
+  SIGNAL_IDS,
+  type Decision,
+  type M1Item,
+  type SignalId,
+  buildFrozenDataset,
+  datasetInvariants,
+  renderDecisionPrompt,
+  sha256,
+  stableShuffle,
+  stableStringify,
+} from "./dataset.ts";
+
+const PROTOCOL = JSON.parse(readFileSync(new URL("./protocol.json", import.meta.url), "utf8")) as {
+  revision?: string;
+  budget: { maxProviderRequests: number; maxTokens: number };
+  gates: { devNetMin: number; testNetMinPerRepeat: number };
+  knowledge: { maxItems: number; maxChars: number; idPrefix?: string };
+  model: { name: string; baseUrl: string; promptVersionDecision: string; promptVersionDistill: string; temperature: number; maxRetries: number; maxOutputTokens: number };
+  counts: { train: number; testRepeats: number };
+  preflight: { maxProviderRequests: number; maxTokens: number };
+};
+
+const ID_PREFIX = PROTOCOL.knowledge.idPrefix ?? "exp_";
+const SIGNAL_ID_SET = new Set<string>(SIGNAL_IDS);
+
+export const DECISION_SCHEMA: JsonSchema = {
+  type: "object",
+  required: ["decision", "confidence", "knowledgeRefs"],
+  additionalProperties: true,
+  properties: {
+    decision: { type: "string" },
+    confidence: { type: "number" },
+    knowledgeRefs: { type: "array" },
+  },
+};
+
+export const DISTILL_SCHEMA: JsonSchema = {
+  type: "object",
+  required: ["items"],
+  additionalProperties: true,
+  properties: {
+    items: { type: "array" },
+  },
+};
+
+export type Arm = "A" | "B";
+export type KnowledgeItem = {
+  id: string;
+  condition: string;
+  judgment: string;
+  exception: string;
+  sourceTrainIds: string[];
+  status: "experimental_only";
+};
+
+export type FrozenKnowledge = {
+  version: "K1" | "K2" | "preflight";
+  items: KnowledgeItem[];
+  hash: string;
+  rendered: string;
+};
+
+export type ScoreResult = {
+  valid: boolean;
+  decision: Decision | null;
+  confidence: number | null;
+  knowledgeRefs: string[];
+  contractValid: boolean;
+  actionCorrect: 0 | 1;
+  correct: 0 | 1;
+  errorType: string | null;
+};
+
+export type DistillOutcome =
+  | { status: "empty_candidate"; knowledge: FrozenKnowledge }
+  | { status: "candidate"; knowledge: FrozenKnowledge }
+  | { status: "contract_failure"; reason: string }
+  | { status: "provider_failure"; reason: string };
+
+export type RunStatus =
+  | "READY_FOR_AUTHORIZED_RUN"
+  | "INVALID"
+  | "BLOCKED"
+  | "PARTIAL"
+  | "NO_CANDIDATE"
+  | "NO_SIGNAL_ON_DEV"
+  | "PROMISING"
+  | "NO_CLEAR_GAIN"
+  | "PREFLIGHT_PASS"
+  | "PREFLIGHT_FAIL";
+
+export type Trajectory = {
+  id: string;
+  signals: Array<{ id: string; label: string; text: string }>;
+  modelDecision: Decision | null;
+  correctDecision: Decision;
+  actionCorrect: 0 | 1;
+  contractValid: boolean;
+};
+
+function isDecision(value: unknown): value is Decision {
+  return typeof value === "string" && (DECISIONS as readonly string[]).includes(value);
+}
+
+export function allowedIdsFromSnapshot(snapshot: FrozenKnowledge | null | undefined): string[] {
+  return snapshot?.items.map((item) => item.id) ?? [];
+}
+
+export function scoreDecision(args: {
+  data: unknown;
+  label: Decision;
+  allowedKnowledgeIds: string[];
+  providerFailed: boolean;
+}): ScoreResult {
+  const allowed = new Set(args.allowedKnowledgeIds);
+  if (args.providerFailed) {
+    return { valid: false, decision: null, confidence: null, knowledgeRefs: [], contractValid: false, actionCorrect: 0, correct: 0, errorType: "provider_failure" };
+  }
+  if (!args.data || typeof args.data !== "object" || Array.isArray(args.data)) {
+    return { valid: false, decision: null, confidence: null, knowledgeRefs: [], contractValid: false, actionCorrect: 0, correct: 0, errorType: "invalid_output" };
+  }
+  const rec = args.data as Record<string, unknown>;
+  const actionOk = isDecision(rec.decision);
+  const actionCorrect: 0 | 1 = actionOk && rec.decision === args.label ? 1 : 0;
+  if (!actionOk) {
+    return { valid: false, decision: null, confidence: null, knowledgeRefs: [], contractValid: false, actionCorrect: 0, correct: 0, errorType: "invalid_action" };
+  }
+  if (typeof rec.confidence !== "number" || !Number.isFinite(rec.confidence) || rec.confidence < 0 || rec.confidence > 1) {
+    return { valid: false, decision: rec.decision, confidence: null, knowledgeRefs: [], contractValid: false, actionCorrect, correct: 0, errorType: "invalid_confidence" };
+  }
+  if (!Array.isArray(rec.knowledgeRefs) || rec.knowledgeRefs.some((ref) => typeof ref !== "string")) {
+    return { valid: false, decision: rec.decision, confidence: rec.confidence, knowledgeRefs: [], contractValid: false, actionCorrect, correct: 0, errorType: "invalid_knowledge_refs" };
+  }
+  const knowledgeRefs = rec.knowledgeRefs as string[];
+  if (knowledgeRefs.some((ref) => SIGNAL_ID_SET.has(ref))) {
+    return { valid: false, decision: rec.decision, confidence: rec.confidence, knowledgeRefs, contractValid: false, actionCorrect, correct: 0, errorType: "signal_id_as_knowledge_ref" };
+  }
+  if (knowledgeRefs.some((ref) => !allowed.has(ref))) {
+    return { valid: false, decision: rec.decision, confidence: rec.confidence, knowledgeRefs, contractValid: false, actionCorrect, correct: 0, errorType: "unknown_knowledge_ref" };
+  }
+  const correct: 0 | 1 = actionCorrect;
+  return { valid: true, decision: rec.decision, confidence: rec.confidence, knowledgeRefs, contractValid: true, actionCorrect, correct, errorType: actionCorrect ? null : "wrong_action" };
+}
+
+export function knowledgeBodyLength(items: KnowledgeItem[]): number {
+  return items.reduce((sum, item) => sum + item.condition.length + item.judgment.length + item.exception.length, 0);
+}
+
+export function renderKnowledge(items: KnowledgeItem[]): string {
+  if (items.length === 0) return "";
+  return items.map((item) => [
+    "[" + item.id + "] status=experimental_only",
+    "WHEN " + item.condition,
+    "THEN " + item.judgment,
+    "EXCEPT " + item.exception,
+    "SOURCES " + item.sourceTrainIds.join(","),
+  ].join("\n")).join("\n\n");
+}
+
+export function freezeParsedKnowledge(version: FrozenKnowledge["version"], items: KnowledgeItem[]): FrozenKnowledge {
+  const rendered = renderKnowledge(items);
+  return { version, items, rendered, hash: sha256({ version, items, rendered }) };
+}
+
+function parseOneItem(raw: unknown, allowedSourceIds: string[], index: number): { ok: true; value: KnowledgeItem } | { ok: false; reason: string } {
+  if (!raw || typeof raw !== "object" || Array.isArray(raw)) return { ok: false, reason: "item_not_object_" + String(index) };
+  const rec = raw as Record<string, unknown>;
+  const required = ["id", "condition", "judgment", "exception", "sourceTrainIds"];
+  for (const key of required) {
+    if (!(key in rec)) return { ok: false, reason: "missing_field_" + key };
+  }
+  if (typeof rec.id !== "string" || !rec.id.trim()) return { ok: false, reason: "bad_id" };
+  const id = rec.id.trim();
+  if (SIGNAL_ID_SET.has(id) || !id.startsWith(ID_PREFIX)) return { ok: false, reason: "id_namespace" };
+  if (typeof rec.condition !== "string" || !rec.condition.trim()) return { ok: false, reason: "bad_condition" };
+  if (typeof rec.judgment !== "string" || !rec.judgment.trim()) return { ok: false, reason: "bad_judgment" };
+  if (typeof rec.exception !== "string") return { ok: false, reason: "bad_exception" };
+  if (!Array.isArray(rec.sourceTrainIds) || rec.sourceTrainIds.some((value) => typeof value !== "string")) {
+    return { ok: false, reason: "bad_sources" };
+  }
+  const sourceTrainIds = rec.sourceTrainIds as string[];
+  if (sourceTrainIds.length === 0 || sourceTrainIds.some((value) => !allowedSourceIds.includes(value))) {
+    return { ok: false, reason: "source_not_train" };
+  }
+  return {
+    ok: true,
+    value: {
+      id,
+      condition: rec.condition.trim(),
+      judgment: rec.judgment.trim(),
+      exception: rec.exception.trim(),
+      sourceTrainIds,
+      status: "experimental_only",
+    },
+  };
+}
+
+export function parseDistillOutput(args: {
+  response: LLMResponse | null;
+  allowedSourceIds: string[];
+  version: FrozenKnowledge["version"];
+}): DistillOutcome {
+  if (!args.response) return { status: "provider_failure", reason: "no_response" };
+  if (args.response.degradedToHumanGate || args.response.errorMessage) {
+    return { status: "provider_failure", reason: args.response.errorMessage ?? "degraded" };
+  }
+  const data = args.response.data;
+  if (!data || typeof data !== "object" || Array.isArray(data)) {
+    return { status: "contract_failure", reason: "distill_output_not_object" };
+  }
+  if (!Object.prototype.hasOwnProperty.call(data, "items")) {
+    return { status: "contract_failure", reason: "missing_items" };
+  }
+  const items = (data as { items: unknown }).items;
+  if (!Array.isArray(items)) return { status: "contract_failure", reason: "items_not_array" };
+  if (items.length === 0) return { status: "empty_candidate", knowledge: freezeParsedKnowledge(args.version, []) };
+  if (items.length > PROTOCOL.knowledge.maxItems) return { status: "contract_failure", reason: "too_many_items" };
+  const parsed: KnowledgeItem[] = [];
+  const seen = new Set<string>();
+  for (let index = 0; index < items.length; index += 1) {
+    const one = parseOneItem(items[index], args.allowedSourceIds, index);
+    if (!one.ok) return { status: "contract_failure", reason: one.reason };
+    if (seen.has(one.value.id)) return { status: "contract_failure", reason: "duplicate_id" };
+    seen.add(one.value.id);
+    parsed.push(one.value);
+  }
+  if (knowledgeBodyLength(parsed) > PROTOCOL.knowledge.maxChars) return { status: "contract_failure", reason: "knowledge_too_long" };
+  return { status: "candidate", knowledge: freezeParsedKnowledge(args.version, parsed) };
+}
+
+export function assembleDecisionRequest(
+  item: Pick<M1Item, "signalsPresent">,
+  snapshot: FrozenKnowledge | null,
+): AgentContext {
+  const prompt = renderDecisionPrompt(item);
+  const allowedKnowledgeIds = allowedIdsFromSnapshot(snapshot);
+  const hasKnowledge = allowedKnowledgeIds.length > 0 && Boolean(snapshot?.rendered);
+  return {
+    role: "orchestrator",
+    task: [
+      prompt.task,
+      "Return decision, confidence, and knowledgeRefs.",
+      "knowledgeRefs must be a string array.",
+      "Each knowledgeRefs value must be in allowedKnowledgeIds.",
+      "If allowedKnowledgeIds is empty, knowledgeRefs must be [].",
+      "Visible signals are input features, not knowledge ids.",
+    ].join(" "),
+    promptVersion: PROTOCOL.model.promptVersionDecision,
+    context: {
+      actions: prompt.context.actions,
+      signals: prompt.context.signals,
+      allowedKnowledgeIds,
+    },
+    schema: DECISION_SCHEMA,
+    knowledgeSummary: hasKnowledge ? snapshot!.rendered : undefined,
+    prohibited: ["Do not use tools, files, network, or git.", "Do not invent actions outside the provided set.", "Do not use signal ids as knowledgeRefs."],
+  };
+}
+
+export function assembleDistillRequest(
+  existing: FrozenKnowledge | null,
+  trajectories: Trajectory[],
+  allowedSourceIds: string[],
+): AgentContext {
+  return {
+    role: "distiller",
+    task: [
+      "Distill transferable decision rules from revealed training feedback.",
+      "Do not grade JSON formatting; emit knowledge content.",
+      "Return an object with items (array, required, may be empty).",
+      "Do not omit items. Empty items means no candidate.",
+      "Each item needs id, condition, judgment, exception, sourceTrainIds.",
+      "id must start with " + ID_PREFIX + " and must not be a signal id.",
+      "sourceTrainIds must be a subset of allowedSourceIds.",
+    ].join(" "),
+    promptVersion: PROTOCOL.model.promptVersionDistill,
+    context: {
+      existingKnowledge: existing?.rendered ?? "",
+      allowedSourceIds,
+      knowledgeIdPrefix: ID_PREFIX,
+      forbiddenIds: [...SIGNAL_IDS],
+      itemFields: ["id", "condition", "judgment", "exception", "sourceTrainIds"],
+      feedback: trajectories.map((row) => ({
+        id: row.id,
+        signals: row.signals,
+        modelDecision: row.modelDecision,
+        correctDecision: row.correctDecision,
+        actionCorrect: row.actionCorrect,
+        contractValid: row.contractValid,
+      })),
+      limits: { maxItems: PROTOCOL.knowledge.maxItems, maxChars: PROTOCOL.knowledge.maxChars },
+    },
+    schema: DISTILL_SCHEMA,
+    prohibited: ["Do not use tools.", "Do not cite ids that were not provided.", "Do not copy signal ids as knowledge ids."],
+  };
+}
+
+export function actualProviderRequests(response: LLMResponse): number {
+  return (response.log.retryCount ?? 0) + 1;
+}
+
+export function requestHasHiddenFields(request: AgentContext, item: M1Item): boolean {
+  const context = request.context as Record<string, unknown>;
+  if (["split", "label", "ruleId", "signalKey", "expectedDecision", "groundTruth", "oracle"].some((key) => key in context)) {
+    return true;
+  }
+  const blob = stableStringify({ task: request.task, context: request.context, knowledgeSummary: request.knowledgeSummary ?? "" });
+  const banned = [SAMPLE_SEED, WORLD_SEED, "expectedDecision", "groundTruthDecision", "oracle"];
+  if (item.ruleId && blob.includes("\"ruleId\":")) return true;
+  return banned.some((value) => blob.includes(value));
+}
+
+export function sanitizeRequest(request: AgentContext) {
+  return {
+    role: request.role,
+    task: request.task,
+    promptVersion: request.promptVersion,
+    context: request.context,
+    knowledgeSummary: request.knowledgeSummary ?? null,
+    schema: request.schema,
+    prohibited: request.prohibited ?? [],
+    mockDataPresent: request.mockData !== undefined,
+  };
+}
+
+export function testSchedule(items: M1Item[], seed: string): Array<{ item: M1Item; arm: Arm; repeat: number }> {
+  const schedule: Array<{ item: M1Item; arm: Arm; repeat: number }> = [];
+  for (let repeat = 0; repeat < PROTOCOL.counts.testRepeats; repeat += 1) {
+    const ordered = stableShuffle(items, seed + ":repeat:" + String(repeat));
+    for (const item of ordered) {
+      const arms = stableShuffle(["A", "B"] as Arm[], seed + ":pair:" + item.id + ":" + String(repeat));
+      for (const arm of arms) schedule.push({ item, arm, repeat });
+    }
+  }
+  return schedule;
+}
+
+export function netGain(rows: Array<{ aCorrect: number; bCorrect: number }>): number {
+  const bOnly = rows.filter((row) => row.bCorrect === 1 && row.aCorrect === 0).length;
+  const aOnly = rows.filter((row) => row.aCorrect === 1 && row.bCorrect === 0).length;
+  return bOnly - aOnly;
+}
+
+class Budget {
+  requests = 0;
+  tokens = 0;
+  constructor(
+    readonly maxRequests: number,
+    readonly maxTokens: number,
+  ) {}
+  remaining(): boolean {
+    return this.requests < this.maxRequests && this.tokens < this.maxTokens;
+  }
+  add(response: LLMResponse) {
+    this.requests += actualProviderRequests(response);
+    this.tokens += response.log.tokenCount ?? 0;
+  }
+}
+
+export type RunM1Options = {
+  engineering?: boolean;
+  authorizeLive?: boolean;
+  provider?: LLMProvider;
+  outRoot?: string;
+  budget?: { maxProviderRequests: number; maxTokens: number };
+  snapshotHashOverride?: string;
+  runId?: string;
+};
+
+function defaultOutRoot(): string {
+  return resolve(fileURLToPath(new URL("../../validation-logs/m1", import.meta.url)));
+}
+
+function writeJson(path: string, value: unknown) {
+  writeFileSync(path, JSON.stringify(value, null, 2) + "\n");
+}
+
+function appendEvidence(path: string, value: unknown) {
+  appendFileSync(path, JSON.stringify(value) + "\n");
+}
+
+function evidenceSafe(value: unknown): boolean {
+  const blob = stableStringify(value);
+  return !blob.includes("Authorization") && !/sk-[A-Za-z0-9_-]{12,}/.test(blob) && !blob.includes("OPENAI_API_KEY");
+}
+
+export async function runM1(options: RunM1Options = {}) {
+  const dataset = buildFrozenDataset();
+  const invariantErrors = datasetInvariants(dataset);
+  const outRoot = options.outRoot ?? defaultOutRoot();
+  const runId = options.runId ?? new Date().toISOString().replace(/[:.]/g, "-");
+  const runDir = join(outRoot, runId);
+  mkdirSync(runDir, { recursive: true });
+  const evidencePath = join(runDir, "evidence.jsonl");
+  writeFileSync(evidencePath, "");
+
+  const components = {
+    orchestrator_decision: "not_exercised",
+    distiller: "not_exercised",
+    sensor: "not_exercised",
+    builder: "not_exercised",
+    librarian: "not_exercised",
+    knowledgeInjection: "not_exercised",
+    product_db: "not_exercised",
+  };
+
+  const manifestBase = {
+    protocolId: PROTOCOL_ID,
+    revision: PROTOCOL.revision ?? null,
+    runId,
+    baseCommit: "7802ae20c3df5d3afd23d439291798d7796fca1e",
+    datasetHashes: dataset.hashes,
+    components,
+    live: Boolean(options.authorizeLive) && !options.engineering,
+    engineering: Boolean(options.engineering),
+    model: { name: PROTOCOL.model.name, baseUrl: PROTOCOL.model.baseUrl, promptVersionDecision: PROTOCOL.model.promptVersionDecision, promptVersionDistill: PROTOCOL.model.promptVersionDistill },
+  };
+
+  if (invariantErrors.length > 0) {
+    const result = { status: "INVALID" as RunStatus, reason: invariantErrors.join("; "), runDir, dataset };
+    writeJson(join(runDir, "manifest.json"), { ...manifestBase, ...result });
+    return result;
+  }
+
+  if (!options.engineering && !options.authorizeLive) {
+    const result = {
+      status: "READY_FOR_AUTHORIZED_RUN" as RunStatus,
+      reason: "Live provider calls are blocked until --authorize-live and ALAYA_M1_AUTHORIZE_LIVE=1.",
+      runDir,
+      dataset,
+      nextCommand: "ALAYA_M1_AUTHORIZE_LIVE=1 npm run m1:run -- --authorize-live",
+    };
+    writeJson(join(runDir, "manifest.json"), { ...manifestBase, ...result, components });
+    writeJson(join(runDir, "knowledge.json"), { K1: null, K2: null });
+    writeFileSync(join(runDir, "comparison.csv"), "repeat,item_id,split,label,arm,decision,correct,actionCorrect,contractValid,error,knowledge_hash\n");
+    writeFileSync(join(runDir, "report.md"), readyReport(result));
+    return result;
+  }
+
+  if (options.authorizeLive && process.env.ALAYA_M1_AUTHORIZE_LIVE !== "1") {
+    const result = { status: "BLOCKED" as RunStatus, reason: "authorize-live was set without ALAYA_M1_AUTHORIZE_LIVE=1.", runDir, dataset };
+    writeJson(join(runDir, "manifest.json"), { ...manifestBase, ...result });
+    return result;
+  }
+
+  let provider = options.provider;
+  if (!provider && options.authorizeLive) {
+    if (!resolveOpenAIApiKey()) {
+      const result = { status: "BLOCKED" as RunStatus, reason: "OPENAI_API_KEY is not set.", runDir, dataset };
+      writeJson(join(runDir, "manifest.json"), { ...manifestBase, ...result });
+      return result;
+    }
+    provider = new OpenAIProvider({
+      model: PROTOCOL.model.name,
+      baseUrl: PROTOCOL.model.baseUrl,
+      temperature: PROTOCOL.model.temperature,
+      maxRetries: PROTOCOL.model.maxRetries,
+      maxOutputTokens: PROTOCOL.model.maxOutputTokens,
+    });
+  }
+  if (!provider) {
+    const result = { status: "BLOCKED" as RunStatus, reason: "No provider available.", runDir, dataset };
+    writeJson(join(runDir, "manifest.json"), { ...manifestBase, ...result });
+    return result;
+  }
+
+  const budget = new Budget(
+    options.budget?.maxProviderRequests ?? PROTOCOL.budget.maxProviderRequests,
+    options.budget?.maxTokens ?? PROTOCOL.budget.maxTokens,
+  );
+  const requests: AgentContext[] = [];
+  let status: RunStatus = "PARTIAL";
+  let reason = "";
+  let k1Outcome: DistillOutcome | null = null;
+  let k2Outcome: DistillOutcome | null = null;
+  const devPairs: Array<{ item: M1Item; aCorrect: number; bCorrect: number; a: ScoreResult; b: ScoreResult }> = [];
+  const testRows: Array<{ item: M1Item; repeat: number; arm: Arm; score: ScoreResult }> = [];
+  let devCalls = 0;
+
+  const call = async (request: AgentContext, kind: string, extra: Record<string, unknown>) => {
+    if (!budget.remaining()) {
+      status = "BLOCKED";
+      reason = "budget exhausted";
+      return null;
+    }
+    if (request.mockData !== undefined) {
+      status = "INVALID";
+      reason = "runner must not pass mockData";
+      return null;
+    }
+    requests.push(request);
+    const response = await provider!.call(request);
+    budget.add(response);
+    const row = {
+      kind,
+      ...extra,
+      provider: provider!.name,
+      promptVersion: request.promptVersion,
+      request: sanitizeRequest(request),
+      knowledgeHash: extra.knowledgeHash ?? null,
+      schemaValid: response.schemaValid,
+      retryCount: response.log.retryCount,
+      providerRequests: actualProviderRequests(response),
+      tokenCount: response.log.tokenCount,
+      estimatedCost: response.log.estimatedCost,
+      degraded: response.degradedToHumanGate,
+      errorMessage: response.errorMessage ?? null,
+      output: response.data,
+    };
+    if (!evidenceSafe(row)) {
+      status = "INVALID";
+      reason = "evidence would contain a secret";
+      return null;
+    }
+    appendEvidence(evidencePath, row);
+    return response;
+  };
+
+  const decide = async (item: M1Item, arm: Arm, snapshot: FrozenKnowledge | null, extra: Record<string, unknown>) => {
+    components.orchestrator_decision = "exercised";
+    const request = assembleDecisionRequest(item, snapshot);
+    if (requestHasHiddenFields(request, item)) {
+      status = "INVALID";
+      reason = "hidden fields leaked into prompt";
+      return { score: scoreDecision({ data: null, label: item.label, allowedKnowledgeIds: [], providerFailed: true }), response: null, request };
+    }
+    const allowedKnowledgeIds = allowedIdsFromSnapshot(snapshot);
+    if (arm === "A" && allowedKnowledgeIds.length > 0) {
+      status = "INVALID";
+      reason = "A arm received knowledge ids";
+      return { score: scoreDecision({ data: null, label: item.label, allowedKnowledgeIds: [], providerFailed: true }), response: null, request };
+    }
+    if (arm === "B") {
+      const expectedHash = options.snapshotHashOverride ?? snapshot?.hash;
+      if (!snapshot || snapshot.hash !== expectedHash) {
+        status = "INVALID";
+        reason = "B arm snapshot hash mismatch";
+        return { score: scoreDecision({ data: null, label: item.label, allowedKnowledgeIds, providerFailed: true }), response: null, request };
+      }
+      if (allowedKnowledgeIds.length > 0 && request.knowledgeSummary !== snapshot.rendered) {
+        status = "INVALID";
+        reason = "B request knowledge does not match snapshot";
+        return { score: scoreDecision({ data: null, label: item.label, allowedKnowledgeIds, providerFailed: true }), response: null, request };
+      }
+    }
+    const response = await call(request, "decision", {
+      itemId: item.id,
+      arm,
+      split: item.split,
+      label: item.label,
+      allowedKnowledgeIds,
+      knowledgeHash: snapshot?.hash ?? null,
+      ...extra,
+    });
+    if (!response) {
+      return { score: scoreDecision({ data: null, label: item.label, allowedKnowledgeIds, providerFailed: true }), response: null, request };
+    }
+    const providerFailed = Boolean(response.degradedToHumanGate || response.errorMessage);
+    const score = scoreDecision({ data: response.data, label: item.label, allowedKnowledgeIds, providerFailed });
+    return { score, response, request };
+  };
+
+  const train = dataset.items.filter((item) => item.split === "train");
+  const dev = dataset.items.filter((item) => item.split === "dev");
+  const test = dataset.items.filter((item) => item.split === "test");
+  const trainA = train.slice(0, 20);
+  const trainB = train.slice(20);
+  const trainIds = train.map((item) => item.id);
+
+  const collectTrain = async (batch: M1Item[], snapshot: FrozenKnowledge | null) => {
+    const rows: Trajectory[] = [];
+    for (const item of batch) {
+      const arm: Arm = snapshot && snapshot.items.length > 0 ? "B" : snapshot ? "B" : "A";
+      const result = await decide(item, arm, snapshot, { phase: "train" });
+      if (status === "INVALID" || status === "BLOCKED") return rows;
+      rows.push({
+        id: item.id,
+        signals: renderDecisionPrompt(item).context.signals,
+        modelDecision: result.score.decision,
+        correctDecision: item.label,
+        actionCorrect: result.score.actionCorrect,
+        contractValid: result.score.contractValid,
+      });
+    }
+    return rows;
+  };
+
+  const distill = async (version: "K1" | "K2", existing: FrozenKnowledge | null, trajectories: Trajectory[], allowedSourceIds: string[]) => {
+    components.distiller = "exercised";
+    const request = assembleDistillRequest(existing, trajectories, allowedSourceIds);
+    const response = await call(request, "distill", { version, allowedIds: allowedSourceIds });
+    return parseDistillOutput({ response, allowedSourceIds, version });
+  };
+
+  const batch1 = await collectTrain(trainA, null);
+  if (status !== "INVALID" && status !== "BLOCKED") {
+    k1Outcome = await distill("K1", null, batch1, trainA.map((item) => item.id));
+    const k1 = k1Outcome.status === "candidate" || k1Outcome.status === "empty_candidate" ? k1Outcome.knowledge : freezeParsedKnowledge("K1", []);
+    if (k1Outcome.status === "provider_failure") {
+      status = "BLOCKED";
+      reason = "K1 provider failure: " + k1Outcome.reason;
+    } else if (k1Outcome.status === "contract_failure") {
+      status = "NO_CANDIDATE";
+      reason = "K1 contract failure: " + k1Outcome.reason;
+    } else {
+      const batch2 = await collectTrain(trainB, k1Outcome.status === "empty_candidate" || k1Outcome.status === "candidate" ? k1 : null);
+      if (status !== "INVALID" && status !== "BLOCKED") {
+        k2Outcome = await distill("K2", k1Outcome.status === "candidate" || k1Outcome.status === "empty_candidate" ? k1 : null, batch2, trainIds);
+        if (k2Outcome.status !== "candidate") {
+          status = k2Outcome.status === "provider_failure" ? "BLOCKED" : "NO_CANDIDATE";
+          reason = "K2 " + k2Outcome.status + ": " + ("reason" in k2Outcome ? k2Outcome.reason : "empty_candidate");
+        } else {
+          const k2 = k2Outcome.knowledge;
+          const sourcesOk = k2.items.every((item) => item.sourceTrainIds.every((id) => trainIds.includes(id)));
+          if (!sourcesOk || k2.items.length === 0) {
+            status = "NO_CANDIDATE";
+            reason = "K2 not a usable candidate before Dev";
+          } else {
+            const probe = assembleDecisionRequest(dev[0]!, k2);
+            if (probe.knowledgeSummary !== k2.rendered) {
+              status = "INVALID";
+              reason = "K2 would not be sent to B";
+            } else {
+              for (const item of dev) {
+                const a = await decide(item, "A", null, { phase: "dev", repeat: 0 });
+                devCalls += 1;
+                if (status === "INVALID" || status === "BLOCKED") break;
+                const b = await decide(item, "B", k2, { phase: "dev", repeat: 0 });
+                devCalls += 1;
+                if (status === "INVALID" || status === "BLOCKED") break;
+                devPairs.push({ item, aCorrect: a.score.correct, bCorrect: b.score.correct, a: a.score, b: b.score });
+              }
+              if (status !== "INVALID" && status !== "BLOCKED") {
+                const devNet = netGain(devPairs);
+                if (devNet < PROTOCOL.gates.devNetMin) {
+                  status = "NO_SIGNAL_ON_DEV";
+                  reason = "B net gain on Dev was " + String(devNet) + " < " + String(PROTOCOL.gates.devNetMin);
+                } else {
+                  for (const step of testSchedule(test, SAMPLE_SEED + ":test")) {
+                    const snapshot = step.arm === "B" ? k2 : null;
+                    const result = await decide(step.item, step.arm, snapshot, { phase: "test", repeat: step.repeat });
+                    if (status === "INVALID" || status === "BLOCKED") break;
+                    testRows.push({ item: step.item, repeat: step.repeat, arm: step.arm, score: result.score });
+                  }
+                  if (status !== "INVALID" && status !== "BLOCKED") {
+                    const repeatNets: number[] = [];
+                    for (let repeat = 0; repeat < PROTOCOL.counts.testRepeats; repeat += 1) {
+                      const pairs = test.map((item) => {
+                        const a = testRows.find((row) => row.item.id === item.id && row.repeat === repeat && row.arm === "A");
+                        const b = testRows.find((row) => row.item.id === item.id && row.repeat === repeat && row.arm === "B");
+                        return { aCorrect: a?.score.correct ?? 0, bCorrect: b?.score.correct ?? 0 };
+                      });
+                      repeatNets.push(netGain(pairs));
+                    }
+                    status = repeatNets.every((value) => value >= PROTOCOL.gates.testNetMinPerRepeat) ? "PROMISING" : "NO_CLEAR_GAIN";
+                    reason = "test repeat nets " + JSON.stringify(repeatNets);
+                  }
+                }
+              }
+            }
+          }
+        }
+      }
+    }
+  }
+
+  const k1 = k1Outcome && (k1Outcome.status === "candidate" || k1Outcome.status === "empty_candidate") ? k1Outcome.knowledge : null;
+  const k2 = k2Outcome && k2Outcome.status === "candidate" ? k2Outcome.knowledge : null;
+  const comparison = ["repeat,item_id,split,label,arm,decision,correct,actionCorrect,contractValid,error,knowledge_hash"];
+  for (const row of devPairs) {
+    comparison.push(["0", row.item.id, "dev", row.item.label, "A", String(row.a.decision), String(row.a.correct), String(row.a.actionCorrect), String(row.a.contractValid), String(row.a.errorType), ""].join(","));
+    comparison.push(["0", row.item.id, "dev", row.item.label, "B", String(row.b.decision), String(row.b.correct), String(row.b.actionCorrect), String(row.b.contractValid), String(row.b.errorType), k2?.hash ?? ""].join(","));
+  }
+  for (const row of testRows) {
+    comparison.push([String(row.repeat), row.item.id, "test", row.item.label, row.arm, String(row.score.decision), String(row.score.correct), String(row.score.actionCorrect), String(row.score.contractValid), String(row.score.errorType), row.arm === "B" ? k2?.hash ?? "" : ""].join(","));
+  }
+  writeFileSync(join(runDir, "comparison.csv"), comparison.join("\n") + "\n");
+  writeJson(join(runDir, "knowledge.json"), { K1: k1, K2: k2, k1Outcome, k2Outcome });
+  const result = {
+    status,
+    reason,
+    runDir,
+    dataset,
+    k1,
+    k2,
+    k1Outcome,
+    k2Outcome,
+    budget: { requests: budget.requests, tokens: budget.tokens, maxRequests: budget.maxRequests, maxTokens: budget.maxTokens },
+    requestCount: requests.length,
+    requests,
+    devPairs,
+    testRows,
+    devCalls,
+  };
+  writeJson(join(runDir, "manifest.json"), { ...manifestBase, status, reason, budget: result.budget, components, k2Hash: k2?.hash ?? null, k2Outcome: k2Outcome?.status ?? null, devCalls });
+  writeFileSync(join(runDir, "report.md"), resultReport(result));
+  return result;
+}
+
+function fixtureItem(id: string, signalsPresent: SignalId[], label: Decision): M1Item {
+  return { id, signalKey: signalsPresent.join(","), signalsPresent, label, ruleId: null, split: "train" };
+}
+
+export async function runPreflight(options: RunM1Options = {}) {
+  const outRoot = options.outRoot ?? defaultOutRoot();
+  const runId = options.runId ?? "preflight-" + new Date().toISOString().replace(/[:.]/g, "-");
+  const runDir = join(outRoot, runId);
+  mkdirSync(runDir, { recursive: true });
+  const evidencePath = join(runDir, "evidence.jsonl");
+  writeFileSync(evidencePath, "");
+  if (!options.engineering && !options.authorizeLive) {
+    const result = { status: "READY_FOR_AUTHORIZED_RUN" as RunStatus, reason: "Preflight live calls need --authorize-live and ALAYA_M1_AUTHORIZE_LIVE=1.", runDir };
+    writeJson(join(runDir, "manifest.json"), { revision: PROTOCOL.revision, ...result, diagnosticOnly: true });
+    return result;
+  }
+  if (options.authorizeLive && process.env.ALAYA_M1_AUTHORIZE_LIVE !== "1") {
+    const result = { status: "BLOCKED" as RunStatus, reason: "preflight authorize-live missing env", runDir };
+    writeJson(join(runDir, "manifest.json"), result);
+    return result;
+  }
+  let provider = options.provider;
+  if (!provider && options.authorizeLive) {
+    if (!resolveOpenAIApiKey()) {
+      const result = { status: "BLOCKED" as RunStatus, reason: "OPENAI_API_KEY is not set.", runDir };
+      writeJson(join(runDir, "manifest.json"), result);
+      return result;
+    }
+    provider = new OpenAIProvider({ model: PROTOCOL.model.name, baseUrl: PROTOCOL.model.baseUrl, temperature: PROTOCOL.model.temperature, maxRetries: PROTOCOL.model.maxRetries, maxOutputTokens: PROTOCOL.model.maxOutputTokens });
+  }
+  if (!provider) {
+    const result = { status: "BLOCKED" as RunStatus, reason: "No provider available.", runDir };
+    writeJson(join(runDir, "manifest.json"), result);
+    return result;
+  }
+  const budget = new Budget(options.budget?.maxProviderRequests ?? PROTOCOL.preflight.maxProviderRequests, options.budget?.maxTokens ?? PROTOCOL.preflight.maxTokens);
+  const stageFails: string[] = [];
+  const call = async (request: AgentContext, kind: string, extra: Record<string, unknown>) => {
+    if (!budget.remaining()) return null;
+    if (request.mockData !== undefined) return null;
+    const response = await provider!.call(request);
+    budget.add(response);
+    appendEvidence(evidencePath, { kind, diagnosticOnly: true, ...extra, request: sanitizeRequest(request), schemaValid: response.schemaValid, retryCount: response.log.retryCount, providerRequests: actualProviderRequests(response), tokenCount: response.log.tokenCount, degraded: response.degradedToHumanGate, errorMessage: response.errorMessage ?? null, output: response.data });
+    return response;
+  };
+  const casesA = [
+    fixtureItem("fix_a1", ["earnings_revision"], "increase_long"),
+    fixtureItem("fix_a2", ["guidance_cut"], "avoid_trade"),
+    fixtureItem("fix_a3", ["earnings_revision", "short_crowding"], "increase_long"),
+  ];
+  const handwritten: FrozenKnowledge = freezeParsedKnowledge("preflight", [{
+    id: "exp_k_revision",
+    condition: "earnings_revision is present and guidance_cut is absent",
+    judgment: "increase_long",
+    exception: "if guidance_cut is present, do not increase_long",
+    sourceTrainIds: ["fix_a1"],
+    status: "experimental_only",
+  }]);
+  let distilled: DistillOutcome | null = null;
+  const scoreCase = async (item: M1Item, snapshot: FrozenKnowledge | null, stage: string) => {
+    const request = assembleDecisionRequest(item, snapshot);
+    const response = await call(request, "preflight_decision", { stage, itemId: item.id });
+    const score = scoreDecision({ data: response?.data, label: item.label, allowedKnowledgeIds: allowedIdsFromSnapshot(snapshot), providerFailed: !response || Boolean(response.degradedToHumanGate || response.errorMessage) });
+    return { request, score, response };
+  };
+  const aScores = [];
+  for (const item of casesA) {
+    const row = await scoreCase(item, null, "A_contract");
+    aScores.push(row);
+    if (!row.score.contractValid) {
+      stageFails.push("A_contract");
+      break;
+    }
+  }
+  if (stageFails.length) return finish("PREFLIGHT_FAIL", "A_contract");
+  const posScores = [];
+  for (const item of casesA) {
+    const row = await scoreCase(item, handwritten, "positive_control");
+    posScores.push(row);
+    if (!row.score.contractValid || row.request.knowledgeSummary !== handwritten.rendered || row.score.actionCorrect !== 1) {
+      stageFails.push("positive_control");
+      break;
+    }
+  }
+  if (stageFails.length) return finish("PREFLIGHT_FAIL", "positive_control");
+  const trainFix = [
+    fixtureItem("fix_t1", ["earnings_revision"], "increase_long"),
+    fixtureItem("fix_t2", ["earnings_revision", "short_crowding"], "increase_long"),
+    fixtureItem("fix_t3", ["guidance_cut"], "avoid_trade"),
+    fixtureItem("fix_t4", ["guidance_cut", "short_crowding"], "avoid_trade"),
+  ];
+  const trajectories: Trajectory[] = trainFix.map((item) => ({
+    id: item.id,
+    signals: renderDecisionPrompt(item).context.signals,
+    modelDecision: null,
+    correctDecision: item.label,
+    actionCorrect: 1,
+    contractValid: true,
+  }));
+  const distillReq = assembleDistillRequest(null, trajectories, trainFix.map((item) => item.id));
+  const distillRes = await call(distillReq, "preflight_distill", { stage: "distill" });
+  distilled = parseDistillOutput({ response: distillRes, allowedSourceIds: trainFix.map((item) => item.id), version: "preflight" });
+  if (distilled.status !== "candidate") return finish("PREFLIGHT_FAIL", "distill:" + distilled.status);
+  const learned = distilled.knowledge;
+  const newCases = [
+    fixtureItem("fix_n1", ["earnings_revision", "valuation_discount"], "increase_long"),
+    fixtureItem("fix_n2", ["guidance_cut", "liquidity_risk"], "avoid_trade"),
+    fixtureItem("fix_n3", ["earnings_revision", "margin_repair"], "increase_long"),
+  ];
+  const transferScores = [];
+  for (const item of newCases) {
+    const row = await scoreCase(item, learned, "transfer");
+    transferScores.push(row);
+    if (!row.score.contractValid || row.request.knowledgeSummary !== learned.rendered || row.score.actionCorrect !== 1) {
+      stageFails.push("transfer");
+      break;
+    }
+  }
+  if (stageFails.length) return finish("PREFLIGHT_FAIL", "transfer");
+  const allDecisions = [...aScores, ...posScores, ...transferScores];
+  if (allDecisions.length !== 9 || allDecisions.some((row) => !row.score.contractValid)) return finish("PREFLIGHT_FAIL", "contract_count");
+  return finish("PREFLIGHT_PASS", "9/9 contract; positive 3/3; distill candidate; transfer 3/3");
+
+  function finish(status: RunStatus, reason: string) {
+    const result = { status, reason, runDir, budget: { requests: budget.requests, tokens: budget.tokens, maxRequests: budget.maxRequests, maxTokens: budget.maxTokens }, diagnosticOnly: true, handwrittenNeverOfficial: true };
+    writeJson(join(runDir, "manifest.json"), result);
+    writeJson(join(runDir, "knowledge.json"), { diagnosticOnly: true, handwritten, distilled: distilled && distilled.status === "candidate" ? distilled.knowledge : distilled });
+    writeFileSync(join(runDir, "report.md"), ["# Alaya M1.1 preflight", "", "status: " + status, reason, "provider_requests: " + String(budget.requests) + " / " + String(budget.maxRequests), "tokens: " + String(budget.tokens), "diagnostic_only: true", ""].join("\n"));
+    return result;
+  }
+}
+
+function readyReport(result: { status: RunStatus; reason: string; runDir: string; nextCommand: string }): string {
+  return ["# Alaya M1", "", "status: " + result.status, result.reason, "", "This is not an experiment pass. No live model was called.", "Run live only with: " + result.nextCommand, "Artifacts: " + result.runDir, ""].join("\n");
+}
+
+function resultReport(result: { status: RunStatus; reason: string; runDir: string; budget: { requests: number; tokens: number; maxRequests: number; maxTokens: number }; k2: FrozenKnowledge | null; devCalls?: number }): string {
+  return ["# Alaya M1", "", "status: " + result.status, result.reason, "", "provider_requests: " + String(result.budget.requests) + " / " + String(result.budget.maxRequests), "tokens: " + String(result.budget.tokens) + " / " + String(result.budget.maxTokens), "k2_items: " + String(result.k2?.items.length ?? 0), "dev_calls: " + String(result.devCalls ?? 0), "", "Sensor, Builder, and Librarian were not exercised.", "Artifacts: " + result.runDir, ""].join("\n");
+}
+
+export function latestRunDir(outRoot = defaultOutRoot()): string | null {
+  if (!existsSync(outRoot)) return null;
+  const dirs = readdirSync(outRoot).sort();
+  return dirs.length ? join(outRoot, dirs[dirs.length - 1]!) : null;
+}
+
+export function readReport(runDir: string): string {
+  return readFileSync(join(runDir, "report.md"), "utf8");
+}
+
+async function main() {
+  const argv = process.argv.slice(2);
+  const command = argv[0] === "report" || argv[0] === "run" || argv[0] === "preflight" ? argv[0] : "run";
+  const rest = argv[0] === command ? argv.slice(1) : argv;
+  if (command === "report") {
+    const dir = rest[0] ? resolve(rest[0]) : latestRunDir();
+    if (!dir) {
+      process.stderr.write("no M1 run artifacts found\n");
+      process.exitCode = 1;
+      return;
+    }
+    process.stdout.write(readReport(dir));
+    return;
+  }
+  const authorizeLive = rest.includes("--authorize-live");
+  const result = command === "preflight" ? await runPreflight({ authorizeLive }) : await runM1({ authorizeLive });
+  process.stdout.write(result.status + "\n" + (result.reason ?? "") + "\n" + result.runDir + "\n");
+  if (result.status === "INVALID" || result.status === "BLOCKED" || result.status === "PREFLIGHT_FAIL") process.exitCode = 2;
+}
+
+if (basename(process.argv[1] ?? "") === "runner.ts" || basename(process.argv[1] ?? "") === "runner.js") {
+  main().catch((error) => {
+    process.stderr.write(String(error?.stack ?? error) + "\n");
+    process.exitCode = 1;
+  });
+}
