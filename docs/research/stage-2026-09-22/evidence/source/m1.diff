+export const PROTOCOL_ID = "ALAYA-M1-KNOWLEDGE-TRANSFER";
+export const SAMPLE_SEED = "alaya-m1-20260919";
+export const WORLD_SEED = "alaya-m1-20260919";
+export const RULES_SOURCE_SHA = "b7090b11b41f358f4d82906c86be835a68c06e64";
+
