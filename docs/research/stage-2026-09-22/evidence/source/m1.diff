+++ b/experiments/m1/parse_json.ts
@@ -0,0 +1,65 @@
+export function stripThinkingBlocks(text: string): string {
+  return text.replace(/<think>[\s\S]*?<\/think>/gi, "").trim();
+}
+
+export function baselineTryParseJsonObject(text: string): Record<string, unknown> | null {
+  try {
+    const parsed = JSON.parse(text) as unknown;
+    if (parsed !== null && typeof parsed === "object" && !Array.isArray(parsed)) return parsed as Record<string, unknown>;
+  } catch {
+    // Same as alaya-core provider: search for a nested object after full parse fails.
+  }
+  const end = text.lastIndexOf("}");
+  if (end < 0) return null;
+  const starts: number[] = [];
+  for (let index = text.indexOf("{"); index >= 0; index = text.indexOf("{", index + 1)) starts.push(index);
+  for (let i = starts.length - 1; i >= 0; i--) {
+    try {
+      const parsed = JSON.parse(text.slice(starts[i], end + 1)) as unknown;
+      if (parsed !== null && typeof parsed === "object" && !Array.isArray(parsed)) return parsed as Record<string, unknown>;
+    } catch {
+      // Continue searching for the root object.
+    }
+  }
+  return null;
+}
+
+export function parseRootJsonObject(text: string): { ok: true; value: Record<string, unknown> } | { ok: false; reason: string } {
+  const trimmed = text.trim().replace(/^```(?:json)?\s*/i, "").replace(/\s*```$/i, "");
+  const candidate = stripThinkingBlocks(trimmed);
+  try {
+    const parsed = JSON.parse(candidate) as unknown;
+    if (parsed !== null && typeof parsed === "object" && !Array.isArray(parsed)) return { ok: true, value: parsed as Record<string, unknown> };
+    return { ok: false, reason: "not_object" };
+  } catch {
+    return { ok: false, reason: "unparseable_root" };
+  }
+}
+
+export const TRUNCATED_ITEMS_FIXTURE = [
+  '{"items":[{"id":"exp_example","condition":"feature_a","judgment":"action_a",',
+  '"exception":"feature_b","sourceTrainIds":["train_example_1"]},',
+  '{"id":"exp_other","condition":"尚未输出完',
+].join("\n");
+
+export function classifyRawDistill(text: string) {
+  const root = parseRootJsonObject(text);
+  const baseline = baselineTryParseJsonObject(stripThinkingBlocks(text.trim()));
+  return {
+    rootOk: root.ok,
+    rootKeys: root.ok ? Object.keys(root.value).sort() : [],
+    rootHasItems: root.ok && Object.prototype.hasOwnProperty.call(root.value, "items"),
+    baselineKeys: baseline ? Object.keys(baseline).sort() : [],
+    baselineHasItems: Boolean(baseline && Object.prototype.hasOwnProperty.call(baseline, "items")),
+    innerExtractedAsRoot: !root.ok && Boolean(baseline) && !Object.prototype.hasOwnProperty.call(baseline ?? {}, "items"),
+  };
+}
+
+export function failPathFetchCount(maxRetries: number): { fetches: number; loggedRetryCount: number; runnerPlusOne: number } {
+  const schemaAttempts = maxRetries + 1;
+  const simplified = 1;
+  const fetches = schemaAttempts + simplified;
+  const loggedRetryCount = maxRetries + 2;
+  return { fetches, loggedRetryCount, runnerPlusOne: loggedRetryCount + 1 };
+}
+
