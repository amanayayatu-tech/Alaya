diff --git a/experiments/m1/k1_diagnose.test.ts b/experiments/m1/k1_diagnose.test.ts
new file mode 100644
--- /dev/null
+++ b/experiments/m1/k1_diagnose.test.ts
@@ -0,0 +1,73 @@
+import assert from "node:assert/strict";
+import { test } from "node:test";
+import {
+  TRUNCATED_ITEMS_FIXTURE,
+  baselineTryParseJsonObject,
+  classifyRawDistill,
+  failPathFetchCount,
+  parseRootJsonObject,
+} from "./parse_json.ts";
+import { parseDistillOutput } from "./runner.ts";
+import type { LLMResponse } from "../../alaya-core/src/llm/provider.ts";
+
+function fakeResponse(data: Record<string, unknown>, extra: Partial<LLMResponse> = {}): LLMResponse {
+  return {
+    schemaValid: extra.schemaValid ?? true,
+    retryCount: extra.retryCount ?? 0,
+    data,
+    degradedToHumanGate: extra.degradedToHumanGate ?? false,
+    errorMessage: extra.errorMessage,
+    log: extra.log ?? {
+      provider: "scripted",
+      agent: "distiller",
+      promptVersion: "alaya-m1-distill-v1",
+      inputSummary: "",
+      outputSummary: "",
+      schemaValid: extra.schemaValid ?? true,
+      retryCount: extra.retryCount ?? 0,
+      latencyMs: 0,
+      tokenCount: extra.log?.tokenCount ?? 1,
+      estimatedCost: 0,
+      ts: new Date().toISOString(),
+    },
+  };
+}
+
+test("complete items root parses; empty items remain a no-candidate", () => {
+  const complete = parseRootJsonObject('{"items":[{"id":"exp_a","condition":"c","judgment":"j","exception":"e","sourceTrainIds":["t1"]}]}');
+  assert.equal(complete.ok, true);
+  if (complete.ok) assert.equal(Array.isArray(complete.value.items), true);
+  const empty = parseRootJsonObject('{"items":[]}');
+  assert.equal(empty.ok, true);
+  if (empty.ok) assert.deepEqual(empty.value.items, []);
+  const parsedEmpty = parseDistillOutput({ response: fakeResponse({ items: [] }), allowedSourceIds: ["t1"], version: "K1" });
+  assert.equal(parsedEmpty.status, "empty_candidate");
+});
+
+test("truncated items root is not accepted as an inner knowledge object", () => {
+  const baseline = baselineTryParseJsonObject(TRUNCATED_ITEMS_FIXTURE);
+  assert.ok(baseline);
+  assert.equal(Object.prototype.hasOwnProperty.call(baseline, "items"), false);
+  assert.equal(baseline?.id, "exp_example");
+  const root = parseRootJsonObject(TRUNCATED_ITEMS_FIXTURE);
+  assert.equal(root.ok, false);
+  const classified = classifyRawDistill(TRUNCATED_ITEMS_FIXTURE);
+  assert.equal(classified.innerExtractedAsRoot, true);
+  assert.equal(classified.rootHasItems, false);
+});
+
+test("schema failure still records simulated usage when present", () => {
+  const response = fakeResponse({ summary: "no items" }, { schemaValid: false, errorMessage: "missing items" });
+  response.log.tokenCount = 99;
+  const parsed = parseDistillOutput({ response, allowedSourceIds: ["t1"], version: "K1" });
+  assert.equal(parsed.status, "provider_failure");
+  assert.equal(response.log.tokenCount, 99);
+});
+
+test("fail-path retryCount plus one overcounts actual fetches when maxRetries is 1", () => {
+  const counts = failPathFetchCount(1);
+  assert.equal(counts.fetches, 3);
+  assert.equal(counts.loggedRetryCount, 3);
+  assert.equal(counts.runnerPlusOne, 4);
+});
+
