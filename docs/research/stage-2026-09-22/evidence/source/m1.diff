@@ -0,0 +1,84 @@
+import { mkdirSync, writeFileSync, readFileSync } from "node:fs";
+import { join, resolve } from "node:path";
+import { fileURLToPath } from "node:url";
+import { OpenAIProvider, resolveOpenAIApiKey, type AgentContext, type ProviderDiagnosticEvent } from "../../alaya-core/src/llm/provider.ts";
+import { classifyRawDistill, parseRootJsonObject } from "./parse_json.ts";
+
+const PROTOCOL = JSON.parse(readFileSync(new URL("./protocol.json", import.meta.url), "utf8")) as {
+  model: { name: string; baseUrl: string; temperature: number; maxRetries: number; maxOutputTokens: number };
+};
+
+function loadLoggedRequest(): { request: AgentContext } {
+  const raw = JSON.parse(readFileSync(new URL("./k1_logged_request_diagnostic_only.json", import.meta.url), "utf8"));
+  const req = raw.request as AgentContext;
+  delete (req as { mockDataPresent?: boolean }).mockDataPresent;
+  if (req.knowledgeSummary === null) delete req.knowledgeSummary;
+  return { request: req };
+}
+
+async function main() {
+  const outDir = resolve(fileURLToPath(new URL("../../validation-logs/m1/k1-diagnose", import.meta.url)));
+  mkdirSync(outDir, { recursive: true });
+  const authorize = process.argv.includes("--authorize-live") && process.env.ALAYA_M1_AUTHORIZE_LIVE === "1";
+  const logged = loadLoggedRequest();
+  const config = {
+    model: PROTOCOL.model.name,
+    baseUrl: PROTOCOL.model.baseUrl,
+    temperature: PROTOCOL.model.temperature,
+    maxRetries: PROTOCOL.model.maxRetries,
+    maxOutputTokens: PROTOCOL.model.maxOutputTokens,
+    diagnosticSingleAttempt: true,
+    rebuiltNotByteReplay: true,
+  };
+  if (!authorize) {
+    writeFileSync(join(outDir, "manifest.json"), JSON.stringify({
+      status: "READY_FOR_AUTHORIZED_K1_DIAGNOSE",
+      reason: "Zero-call only. Live replay needs --authorize-live and ALAYA_M1_AUTHORIZE_LIVE=1. Budget: 2 HTTP / 30000 tokens. No Train/Dev/Test.",
+      config,
+      loggedRequestIsAgentContextNotHttp: true,
+    }, null, 2) + "\n");
+    process.stdout.write("READY_FOR_AUTHORIZED_K1_DIAGNOSE\n" + outDir + "\n");
+    return;
+  }
+  if (!resolveOpenAIApiKey()) {
+    process.stdout.write("BLOCKED OPENAI_API_KEY is not set\n");
+    process.exitCode = 2;
+    return;
+  }
+  const captures: ProviderDiagnosticEvent[] = [];
+  const provider = new OpenAIProvider({
+    model: config.model,
+    baseUrl: config.baseUrl,
+    temperature: config.temperature,
+    maxRetries: 0,
+    maxOutputTokens: config.maxOutputTokens,
+    diagnosticSingleAttempt: true,
+    onDiagnosticCapture: (event) => captures.push(event),
+  });
+  const response = await provider.call(logged.request);
+  const rawText = captures[0]?.rawText ?? "";
+  const classified = rawText ? classifyRawDistill(rawText) : null;
+  const root = rawText ? parseRootJsonObject(rawText) : null;
+  const pack = {
+    diagnosticOnly: true,
+    notOfficialRun: true,
+    httpFetchCount: provider.httpFetchCount,
+    captures: captures.map((event) => ({ ...event, rawTextBytes: event.rawText.length })),
+    classified,
+    rootOk: root?.ok ?? false,
+    rootKeys: root && root.ok ? Object.keys(root.value) : [],
+    schemaValid: response.schemaValid,
+    degraded: response.degradedToHumanGate,
+    errorMessage: response.errorMessage ?? null,
+    usageComplete: captures[0]?.usageComplete ?? false,
+  };
+  writeFileSync(join(outDir, "k1_raw_capture.json"), JSON.stringify({ ...pack, rawText }, null, 2) + "\n");
+  writeFileSync(join(outDir, "manifest.json"), JSON.stringify({ status: "K1_DIAGNOSE_CAPTURED", httpFetchCount: provider.httpFetchCount, usageComplete: pack.usageComplete, classified }, null, 2) + "\n");
+  process.stdout.write("K1_DIAGNOSE_CAPTURED fetches=" + String(provider.httpFetchCount) + "\n");
+  if (provider.httpFetchCount > 1) process.exitCode = 2;
+}
+
+main().catch((error) => {
+  process.stderr.write(String(error?.stack ?? error) + "\n");
+  process.exitCode = 1;
+});
